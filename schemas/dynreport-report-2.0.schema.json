{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynreport.local/schema/report-2.0.json",
  "title": "DynReport report document 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "Settings",
    "DataSources",
    "Datasets",
    "Parameters",
    "Calculations",
    "Pages"
  ],
  "properties": {
    "Settings": {
      "type": "object",
      "required": [
        "AutoRun",
        "AutoRefreshSeconds",
        "ParametersCollapsedByDefault",
        "Culture",
        "MaxRowsPerDataset",
        "CommandTimeoutSeconds"
      ],
      "properties": {
        "AutoRun": {
          "type": "boolean"
        },
        "AutoRefreshSeconds": {
          "type": "integer",
          "minimum": 0,
          "anyOf": [
            {
              "const": 0
            },
            {
              "minimum": 30
            }
          ]
        },
        "ParametersCollapsedByDefault": {
          "type": "boolean"
        },
        "Culture": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "MaxRowsPerDataset": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "CommandTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 900
        },
        "Density": {
          "enum": [
            "Comfortable",
            "Compact"
          ]
        }
      }
    },
    "DataSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Id",
          "Provider",
          "ConfigKey"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "Provider": {
            "enum": [
              "SQL"
            ]
          },
          "ConfigKey": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "DefaultConnectionString": {
            "type": "string",
            "description": "Transitional non-secret target metadata only. Credentials are forbidden."
          }
        }
      }
    },
    "Datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "Id",
          "DataSourceId",
          "CommandType",
          "QueryFile",
          "Parameters",
          "Fields"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "DataSourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "CommandType": {
            "enum": [
              "Text",
              "StoredProcedure"
            ]
          },
          "QueryFile": {
            "type": "string",
            "pattern": "^datasets/.+\\.sql$"
          },
          "Parameters": {
            "type": "array"
          },
          "Fields": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 200
            }
          }
        }
      }
    },
    "Parameters": {
      "type": "array"
    },
    "Calculations": {
      "type": "object"
    },
    "Pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "Id",
          "Columns",
          "Components"
        ],
        "properties": {
          "Id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "Title": {
            "type": "string",
            "maxLength": 300
          },
          "Columns": {
            "type": "integer",
            "minimum": 1,
            "maximum": 24
          },
          "Components": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/visual"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "sort": {
      "type": "object",
      "required": [
        "Field",
        "Direction"
      ],
      "properties": {
        "Field": {
          "type": "string",
          "minLength": 1
        },
        "Direction": {
          "enum": [
            "Asc",
            "Desc",
            "asc",
            "desc"
          ]
        }
      }
    },
    "tableColumn": {
      "type": "object",
      "required": [
        "Field"
      ],
      "properties": {
        "Field": {
          "type": "string",
          "minLength": 1
        },
        "Header": {
          "type": "string"
        },
        "Format": {
          "type": "string"
        },
        "Unit": {
          "type": "string"
        },
        "Hidden": {
          "type": "boolean"
        },
        "Filterable": {
          "type": "boolean"
        },
        "Sortable": {
          "type": "boolean"
        },
        "DataType": {
          "enum": [
            "Auto",
            "String",
            "Integer",
            "Decimal",
            "Date",
            "DateTime",
            "Boolean"
          ]
        }
      }
    },
    "table": {
      "type": "object",
      "properties": {
        "Columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableColumn"
          }
        },
        "GroupBy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "DefaultSort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "Searchable": {
          "type": "boolean"
        },
        "Filterable": {
          "type": "boolean"
        },
        "Sortable": {
          "type": "boolean"
        },
        "PageSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "DataMode": {
          "enum": [
            "Auto",
            "Client",
            "Server"
          ]
        },
        "Aggregates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableAggregate"
          }
        },
        "Pivot": {
          "anyOf": [
            {
              "$ref": "#/$defs/tablePivot"
            },
            {
              "type": "null"
            }
          ]
        },
        "PresentationMode": {
          "enum": [
            "Rows",
            "Grouped",
            "Pivot"
          ]
        }
      }
    },
    "chartSeries": {
      "type": "object",
      "required": [
        "Field"
      ],
      "properties": {
        "Field": {
          "type": "string",
          "minLength": 1
        },
        "Label": {
          "type": "string"
        },
        "Aggregation": {
          "enum": [
            "Sum",
            "Avg",
            "Min",
            "Max",
            "Count",
            "First",
            "None"
          ]
        },
        "Format": {
          "type": "string"
        },
        "Unit": {
          "type": "string"
        },
        "ChartType": {
          "enum": [
            "",
            "Bar",
            "Line",
            "Area"
          ]
        },
        "Color": {
          "type": "string",
          "pattern": "^$|^#[0-9A-Fa-f]{6}$"
        },
        "Axis": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1
        },
        "Area": {
          "type": "boolean"
        }
      }
    },
    "chart": {
      "type": "object",
      "properties": {
        "ChartType": {
          "enum": [
            "Auto",
            "Bar",
            "Line",
            "Area",
            "Donut",
            "Treemap",
            "WorldMap"
          ]
        },
        "CategoryField": {
          "type": "string"
        },
        "SeriesByField": {
          "type": "string"
        },
        "Series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/chartSeries"
          }
        },
        "Sort": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sort"
          }
        },
        "Stacked": {
          "type": "boolean"
        },
        "ShowLegend": {
          "type": "boolean"
        },
        "ShowLabels": {
          "type": "boolean"
        },
        "MaxPoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "Height": {
          "type": "integer",
          "minimum": 180,
          "maximum": 1200
        },
        "ColorSet": {
          "type": "string"
        },
        "ColorKeyField": {
          "type": "string"
        },
        "ColorOverrides": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "TooltipFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Orientation": {
          "enum": [
            "Vertical",
            "Horizontal"
          ]
        },
        "ShowStackTotal": {
          "type": "boolean"
        },
        "StackTotalFormat": {
          "type": "string"
        },
        "Interaction": {
          "$ref": "#/$defs/chartInteraction"
        }
      }
    },
    "visual": {
      "type": "object",
      "required": [
        "Id",
        "Type",
        "Span",
        "MobileSpan"
      ],
      "properties": {
        "Id": {
          "type": "string",
          "minLength": 1
        },
        "Type": {
          "enum": [
            "heading",
            "text",
            "metric-strip",
            "grouped-board",
            "table",
            "chart"
          ]
        },
        "Title": {
          "type": "string"
        },
        "Subtitle": {
          "type": "string"
        },
        "Dataset": {
          "type": "string"
        },
        "Span": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "MobileSpan": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "CssClass": {
          "type": "string"
        },
        "Value": {
          "type": [
            "object",
            "null"
          ]
        },
        "Format": {
          "type": "string"
        },
        "Unit": {
          "type": "string"
        },
        "Metrics": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/metric"
          }
        },
        "Board": {
          "type": [
            "object",
            "null"
          ]
        },
        "Table": {
          "anyOf": [
            {
              "$ref": "#/$defs/table"
            },
            {
              "type": "null"
            }
          ]
        },
        "Chart": {
          "anyOf": [
            {
              "$ref": "#/$defs/chart"
            },
            {
              "type": "null"
            }
          ]
        },
        "TargetPageId": {
          "type": "string"
        }
      }
    },
    "tableAggregate": {
      "type": "object",
      "required": [
        "Function"
      ],
      "properties": {
        "Field": {
          "type": "string"
        },
        "Function": {
          "enum": [
            "Sum",
            "Avg",
            "Min",
            "Max",
            "Count",
            "DistinctCount"
          ]
        },
        "Alias": {
          "type": "string",
          "maxLength": 120
        },
        "Label": {
          "type": "string",
          "maxLength": 200
        },
        "Format": {
          "type": "string"
        },
        "Unit": {
          "type": "string"
        }
      }
    },
    "tablePivot": {
      "type": "object",
      "properties": {
        "RowFields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "ColumnField": {
          "type": "string"
        },
        "Measures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tableAggregate"
          }
        },
        "MaxColumns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "ColumnSort": {
          "enum": [
            "Asc",
            "Desc",
            "asc",
            "desc"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "properties": {
        "Id": {
          "type": "string"
        },
        "Label": {
          "type": "string"
        },
        "Dataset": {
          "type": "string"
        },
        "TargetPageId": {
          "type": "string"
        },
        "Value": {
          "type": "object"
        },
        "Format": {
          "type": "string"
        },
        "Unit": {
          "type": "string"
        },
        "Rules": {
          "type": "array"
        }
      }
    },
    "chartInteraction": {
      "type": "object",
      "properties": {
        "CategoryParameter": {
          "type": "string"
        },
        "SeriesParameter": {
          "type": "string"
        },
        "RunReportAfterFilter": {
          "type": "boolean"
        },
        "SeriesTargetPages": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
