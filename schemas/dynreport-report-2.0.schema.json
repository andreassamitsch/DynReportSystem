{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dynreport.local/schema/report-2.0.json",
  "title": "DynReport report document 2.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["Settings", "DataSources", "Datasets", "Parameters", "Calculations", "Pages"],
  "properties": {
    "Settings": {
      "type": "object",
      "required": [
        "AutoRun",
        "AutoRefreshSeconds",
        "ParametersCollapsedByDefault",
        "Culture",
        "MaxRowsPerDataset",
        "CommandTimeoutSeconds"
      ],
      "properties": {
        "AutoRun": { "type": "boolean" },
        "AutoRefreshSeconds": {
          "type": "integer",
          "minimum": 0,
          "anyOf": [
            { "const": 0 },
            { "minimum": 30 }
          ]
        },
        "ParametersCollapsedByDefault": { "type": "boolean" },
        "Culture": { "type": "string", "minLength": 2, "maxLength": 20 },
        "MaxRowsPerDataset": { "type": "integer", "minimum": 1, "maximum": 1000000 },
        "CommandTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 900 }
      }
    },
    "DataSources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Id", "Provider", "ConfigKey"],
        "properties": {
          "Id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "Provider": { "enum": ["SQL"] },
          "ConfigKey": { "type": "string", "minLength": 1, "maxLength": 128 },
          "DefaultConnectionString": {
            "type": "string",
            "description": "Transitional non-secret target metadata only. Credentials are forbidden."
          }
        }
      }
    },
    "Datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["Id", "DataSourceId", "CommandType", "QueryFile", "Parameters", "Fields"],
        "properties": {
          "Id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "DataSourceId": { "type": "string", "minLength": 1, "maxLength": 128 },
          "CommandType": { "enum": ["Text", "StoredProcedure"] },
          "QueryFile": { "type": "string", "pattern": "^datasets/.+\\.sql$" },
          "Parameters": { "type": "array" },
          "Fields": {
            "type": "array",
            "items": { "type": "string", "maxLength": 200 }
          }
        }
      }
    },
    "Parameters": { "type": "array" },
    "Calculations": { "type": "object" },
    "Pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["Id", "Columns", "Components"],
        "properties": {
          "Id": { "type": "string", "minLength": 1, "maxLength": 100 },
          "Title": { "type": "string", "maxLength": 300 },
          "Columns": { "type": "integer", "minimum": 1, "maximum": 24 },
          "Components": { "type": "array" }
        }
      }
    }
  }
}
