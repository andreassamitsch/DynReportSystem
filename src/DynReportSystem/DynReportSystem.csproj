<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AspNetCoreHostingModel>InProcess</AspNetCoreHostingModel>
    <AssemblyName>DynReportSystem</AssemblyName>
    <RootNamespace>DynReportSystem</RootNamespace>
    <Product>DynReport System</Product>
    <Description>Modern dynamic reporting and analytics platform with Windows SSO for APP-01.</Description>
    <Company>Fuchshofer</Company>
    <Authors>Fuchshofer</Authors>
    <Copyright>Copyright © 2026 Fuchshofer. All rights reserved.</Copyright>
    <Version>0.3.0</Version>
    <AssemblyVersion>0.3.0.0</AssemblyVersion>
    <FileVersion>0.3.0.0</FileVersion>
    <RepositoryUrl>https://github.com/andreassamitsch/DynReportSystem</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.3" />
  </ItemGroup>
  <ItemGroup>
    <Content Update="config/permissions.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="ReportDefinitions/**/*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
