@page "/reports/kundencockpit"
@attribute [Authorize]
@inject FolderAccess Access
@inject AuthenticationStateProvider Authentication
@inject ReportService Reports
@inject DashboardCatalog Dashboards
@inject ChartOptionFactory Charts
@inject IJSRuntime JS

<PageTitle>Kundencockpit · DynReport System</PageTitle>

@if (!initialized)
{
    <div class="page-loading">
        <div class="loading-ring"></div>
        <span>Bericht wird initialisiert …</span>
    </div>
}
else if (!allowed)
{
    <div class="notice error">Für das Kundencockpit wurde keine Ausführungsberechtigung vergeben.</div>
}
else
{
<div class="shell">
    <header class="topbar">
        <div class="brand-mark">D</div>
        <div class="brand-text">
            <strong>@dashboard.Title</strong>
            <span>DynReport System · Fuchshofer</span>
        </div>
        <div class="topbar-tag">
            <span class="live-dot"></span>
            APP-01 · Live
        </div>
    </header>

    <div class="app-layout">
        <aside class="sidebar">
            @if (selected == OverviewKey)
            {
                <a class="nav-btn" href="/">← Berichtsordner</a>
            }
            else
            {
                <button class="nav-btn nav-back" @onclick="NavigateBackAsync">← Zurück</button>
            }

            <div class="section-label">ANSICHT</div>
            <button class="nav-btn @(selected == OverviewKey ? "active" : "")"
                    @onclick="ShowOverviewAsync">
                Dashboard
            </button>

            <div class="section-label nav-title">DETAILS</div>
            @foreach (var widget in DetailWidgets)
            {
                <button class="nav-btn @(selected == widget.Dataset ? "active" : "")"
                        @onclick="() => ShowDatasetAsync(widget.Dataset)">
                    @widget.Title
                </button>
            }

            @if (OtherDatasets.Any())
            {
                <div class="section-label nav-title">WEITERE DATEN</div>
                @foreach (var dataset in OtherDatasets)
                {
                    <button class="nav-btn @(selected == dataset ? "active" : "")"
                            @onclick="() => ShowDatasetAsync(dataset)">
                        @LabelFor(dataset)
                    </button>
                }
            }

            <div class="sidebar-foot">
                <strong>DynReport 0.2.1</strong><br />
                RDL = Datenlogik &amp; GB-Farben<br />
                DynReport = Darstellung &amp; Interaktion
            </div>
        </aside>

        <main class="main-area">
            <div class="heading-line">
                <div>
                    <p class="eyebrow">VERTRIEB · LIVE ANALYTICS</p>
                    <h1>@(selected == OverviewKey ? dashboard.Title : LabelFor(selected))</h1>
                    <p class="subtitle">
                        @(selected == OverviewKey
                            ? dashboard.Subtitle
                            : "Interaktive Detailanalyse mit Live-Daten aus der aktuellen RDL-Logik")
                    </p>
                </div>

                <div class="heading-actions">
                    <span class="data-badge"><span class="live-dot"></span> SQL Live</span>
                    @if (selected != OverviewKey)
                    {
                        <button class="ghost-btn" @onclick="NavigateBackAsync">← Zurück</button>
                    }
                </div>
            </div>

            <details class="filter-shell" open>
                <summary>
                    <span class="filter-summary-title">Parameter &amp; Filter</span>
                    <span class="filter-summary-value">@FilterSummary</span>
                    <span class="filter-summary-action">ein-/ausblenden</span>
                </summary>

                <section class="filterbar" aria-label="Filter">
                    <label>
                        Von
                        <input type="date" @bind="start" />
                    </label>

                    <label>
                        Bis
                        <input type="date" @bind="ende" />
                    </label>

                    <label class="filter-customer">
                        Kunde
                        <input type="search"
                               maxlength="100"
                               placeholder="Kundenname (optional)"
                               @bind="kunde"
                               @bind:event="oninput" />
                    </label>

                    <label class="filter-sales">
                        Vertriebsmitarbeiter
                        <select @bind="mitarbeiter">
                            @foreach (var person in people)
                            {
                                <option value="@person.Key">@person.Value</option>
                            }
                        </select>
                    </label>

                    <div class="filter-actions">
                        <button class="primary-btn" disabled="@busy" @onclick="RefreshAsync">
                            @(busy ? "Lädt …" : "Anwenden")
                        </button>

                        <button class="ghost-btn filter-reset" disabled="@busy" @onclick="ResetFiltersAsync">
                            Zurücksetzen
                        </button>
                    </div>
                </section>
            </details>

            <div class="active-filter-row">
                <span class="filter-chip">@start.ToString("dd.MM.yy") – @ende.ToString("dd.MM.yy")</span>
                @if (!string.IsNullOrWhiteSpace(kunde))
                {
                    <button class="filter-chip removable" @onclick="ClearCustomerAsync">Kunde: @kunde ×</button>
                }
                @if (!string.IsNullOrWhiteSpace(mitarbeiter))
                {
                    <button class="filter-chip removable" @onclick="ClearSalespersonAsync">Vertrieb: @SelectedSalespersonLabel ×</button>
                }
            </div>

            @if (error is not null)
            {
                <div role="alert" class="notice error">
                    <strong>Auswertung nicht verfügbar</strong><br />
                    @error
                </div>
            }

            @if (busy)
            {
                <div class="loading-strip">
                    <span></span>
                </div>
            }

            @if (selected == OverviewKey)
            {
                @if (PrimaryWidget is DashboardWidget primary)
                {
                    var primaryResult = ResultFor(primary.Dataset);

                    <section class="dashboard-section primary-analysis-section">
                        <div class="section-heading">
                            <div>
                                <p class="eyebrow">HAUPTÜBERSICHT</p>
                                <h2>@primary.Title</h2>
                                <p class="section-subtitle">@primary.Subtitle</p>
                            </div>
                            <span class="interactive-badge">Monat anklicken = filtern</span>
                        </div>

                        <section class="panel dashboard-widget primary-chart-card">
                            @if (primaryResult is null)
                            {
                                <div class="chart-placeholder">
                                    <div class="loading-ring small"></div>
                                    <span>Wird geladen …</span>
                                </div>
                            }
                            else if (primaryResult.Rows.Count == 0)
                            {
                                <div class="empty">Keine Daten im gewählten Zeitraum.</div>
                            }
                            else
                            {
                                <EChart @key="@($"{primary.Id}-{start:yyyyMMdd}-{ende:yyyyMMdd}-{kunde}-{mitarbeiter}")"
                                        ChartKey="@primary.Id"
                                        Options="@Charts.BuildDashboard(primary, primaryResult)"
                                        Height="@($"{Math.Max(320, primary.Height)}px")"
                                        OnPointClick="HandleChartClickAsync" />
                            }
                        </section>
                    </section>
                }

                <section class="dashboard-section compact-kpi-section">
                    <div class="section-heading compact-heading">
                        <div>
                            <p class="eyebrow">KENNZAHLEN</p>
                            <h2>Geschäftslage</h2>
                        </div>
                    </div>

                    <div class="kpi-grid">
                        @foreach (var widget in KpiWidgets)
                        {
                            var result = ResultFor(widget.Dataset);
                            var summary = result is null ? null : Charts.Summarize(widget, result);

                            <button class="kpi-card kpi-button"
                                    @onclick="() => ShowDatasetAsync(widget.Dataset)">
                                <div class="kpi-topline">
                                    <div>
                                        <div class="kpi-label">@widget.Title</div>
                                        <div class="kpi-subtitle">@widget.Subtitle</div>
                                    </div>

                                    @if (summary?.TrendPercent is decimal trend)
                                    {
                                        <span class="trend-chip @(trend >= 0 ? "positive" : "negative")">
                                            @(trend >= 0 ? "▲" : "▼") @Math.Abs(trend).ToString("N1", DeAt) %
                                        </span>
                                    }
                                </div>

                                <div class="kpi-value">@MetricValue(widget, summary)</div>

                                @if (result is not null && !string.IsNullOrWhiteSpace(widget.CategoryField))
                                {
                                    <div class="kpi-spark">
                                        <EChart ChartKey="@($"spark-{widget.Id}")"
                                                Options="@Charts.Sparkline(widget, result)"
                                                Height="34px" />
                                    </div>
                                }

                                <div class="kpi-foot">
                                    <span>Details</span>
                                    <span>→</span>
                                </div>
                            </button>
                        }
                    </div>
                </section>

                @if (overviewResults.Values.Any(x => x.Truncated))
                {
                    <div class="notice warn">
                        Mindestens ein Dashboard-Dataset wurde serverseitig begrenzt. Summen aus diesem Dataset können unvollständig sein.
                    </div>
                }

                <section class="dashboard-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">GESCHÄFTSBEREICHE &amp; STRUKTUR</p>
                            <h2>Interaktive Analysen</h2>
                        </div>
                        <span class="section-note">Tippen/Klicken = filtern oder Drilldown · Legenden schalten Serien ein/aus</span>
                    </div>

                    <div class="dynamic-dashboard-grid">
                        @foreach (var widget in SecondaryChartWidgets)
                        {
                            var result = ResultFor(widget.Dataset);

                            <section class="panel dashboard-widget"
                                     style="grid-column: span @Math.Max(1, widget.ColSpan)">
                                <div class="panel-head">
                                    <div>
                                        <h2>@widget.Title</h2>
                                        <p>@widget.Subtitle</p>
                                    </div>
                                    @if (widget.Interactive)
                                    {
                                        <span class="interactive-badge">interaktiv</span>
                                    }
                                </div>

                                @if (result is null)
                                {
                                    <div class="chart-placeholder">
                                        <div class="loading-ring small"></div>
                                        <span>Wird geladen …</span>
                                    </div>
                                }
                                else if (result.Rows.Count == 0)
                                {
                                    <div class="empty">Keine Daten im gewählten Zeitraum.</div>
                                }
                                else
                                {
                                    <EChart @key="@($"{widget.Id}-{start:yyyyMMdd}-{ende:yyyyMMdd}-{kunde}-{mitarbeiter}")"
                                            ChartKey="@widget.Id"
                                            Options="@Charts.BuildDashboard(widget, result)"
                                            Height="@($"{Math.Max(250, widget.Height)}px")"
                                            OnPointClick="HandleChartClickAsync" />
                                }
                            </section>
                        }
                    </div>
                </section>

                <section class="quick-links">
                    @foreach (var widget in DetailWidgets)
                    {
                        <button class="insight-tile" @onclick="() => ShowDatasetAsync(widget.Dataset)">
                            <span class="insight-icon">↗</span>
                            <strong>@widget.Title</strong>
                            <span>@DetailHint(widget.Dataset)</span>
                        </button>
                    }
                </section>
            }
            else
            {
                @if (relatedChart is not null || detailCharts.Count > 0)
                {
                    <section class="dashboard-section">
                        <div class="section-heading">
                            <div>
                                <p class="eyebrow">VISUELLE ANALYSE</p>
                                <h2>@LabelFor(selected)</h2>
                            </div>
                            @if (selected == "Umsatz")
                            {
                                <span class="section-note">GB-Farben aus RDL · Kartendaten @("@svg-maps/world")</span>
                            }
                        </div>

                        <div class="detail-visual-grid">
                            @if (relatedChart is not null)
                            {
                                <section class="panel dashboard-widget detail-wide-chart">
                                    <div class="panel-head">
                                        <div>
                                            <h2>@relatedChart.Title</h2>
                                            <p>@relatedChart.Subtitle</p>
                                        </div>
                                        <span class="interactive-badge">RDL-Logik</span>
                                    </div>
                                    <EChart @key="@($"{relatedChart.Key}-{start:yyyyMMdd}-{ende:yyyyMMdd}-{kunde}-{mitarbeiter}")"
                                            ChartKey="@relatedChart.Key"
                                            Options="@relatedChart.Options"
                                            Height="@relatedChart.Height"
                                            OnPointClick="HandleDetailChartClickAsync" />
                                </section>
                            }

                            @foreach (var chart in detailCharts)
                            {
                                <section class="panel dashboard-widget">
                                    <div class="panel-head">
                                        <div>
                                            <h2>@chart.Title</h2>
                                            <p>@chart.Subtitle</p>
                                        </div>
                                    </div>

                                    <EChart @key="@($"{chart.Key}-{start:yyyyMMdd}-{ende:yyyyMMdd}-{kunde}-{mitarbeiter}")"
                                            ChartKey="@chart.Key"
                                            Options="@chart.Options"
                                            Height="@chart.Height"
                                            OnPointClick="HandleDetailChartClickAsync" />
                                </section>
                            }
                        </div>
                    </section>
                }

                <section class="panel detail-panel">
                    <div class="panel-head detail-head">
                        <div>
                            <h2>Datensätze</h2>
                            <p>@LabelFor(selected) · jede Spalte filter- und sortierbar</p>
                        </div>

                        <div class="detail-actions">
                            <span class="muted">
                                @filteredDetailRows.Count.ToString("N0", DeAt)
                                @if (detail is not null && filteredDetailRows.Count != detail.Rows.Count)
                                {
                                    <text> von @detail.Rows.Count.ToString("N0", DeAt)</text>
                                }
                                Zeilen
                            </span>

                            <button class="ghost-btn" disabled="@(detail is null || detail.Rows.Count == 0)" @onclick="ExportCsvAsync">
                                CSV
                            </button>
                        </div>
                    </div>

                    @if (detail?.Truncated == true)
                    {
                        <div class="notice warn">
                            Das SQL-Ergebnis wurde serverseitig auf die konfigurierte Maximalzeilenzahl begrenzt.
                        </div>
                    }

                    @if (detail is null || detail.Rows.Count == 0)
                    {
                        <div class="empty">Keine Daten vorhanden.</div>
                    }
                    else
                    {
                        <div class="table-toolbar">
                            <label class="table-search">
                                <span>Globale Suche</span>
                                <input type="search"
                                       placeholder="Alle Spalten durchsuchen …"
                                       value="@tableSearch"
                                       @oninput="OnGlobalSearch" />
                            </label>

                            <div class="table-filter-summary">
                                @if (ColumnFilterCount > 0)
                                {
                                    <span>@ColumnFilterCount Spaltenfilter aktiv</span>
                                    <button class="text-btn" @onclick="ClearColumnFilters">Filter löschen</button>
                                }
                            </div>

                            <label class="page-size">
                                <span>Zeilen</span>
                                <select @bind="PageSize">
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="250">250</option>
                                    <option value="500">500</option>
                                </select>
                            </label>
                        </div>

                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr class="table-sort-row">
                                        @foreach (var column in detail.Columns)
                                        {
                                            <th>
                                                <button class="column-sort" @onclick="() => SortBy(column)">
                                                    <span>@column</span>
                                                    @if (sortColumn == column)
                                                    {
                                                        <span class="sort-indicator">@(sortAscending ? "▲" : "▼")</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="sort-indicator muted-sort">↕</span>
                                                    }
                                                </button>
                                            </th>
                                        }
                                    </tr>
                                    <tr class="table-filter-row">
                                        @foreach (var column in detail.Columns)
                                        {
                                            <th>
                                                <input class="column-filter"
                                                       value="@GetColumnFilter(column)"
                                                       @oninput="e => SetColumnFilter(column, e.Value?.ToString())"
                                                       placeholder="Filtern …"
                                                       title="Textsuche; optional =, !=, >, >=, < oder <= verwenden" />
                                            </th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var row in VisibleRows)
                                    {
                                        <tr>
                                            @foreach (var column in detail.Columns)
                                            {
                                                <td title="@Cell(row, column)">
                                                    @Cell(row, column)
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pagination">
                            <span>Seite @(page + 1) / @PageCount</span>
                            <div>
                                <button disabled="@(page == 0)" @onclick="PreviousPage">← Zurück</button>
                                <button disabled="@(page + 1 >= PageCount)" @onclick="NextPage">Weiter →</button>
                            </div>
                        </div>
                    }
                </section>
            }

            <footer>
                DynReport System 0.2.1 · Windows SSO · RDL-Datenlogik und RDL-Geschäftsbereichsfarben
            </footer>
        </main>
    </div>
</div>
}

@code {
    private const string OverviewKey = "__overview__";
    private static readonly CultureInfo DeAt = CultureInfo.GetCultureInfo("de-AT");

    private bool initialized;
    private bool allowed;
    private bool busy;
    private string? error;
    private string selected = OverviewKey;
    private string kunde = "";
    private string mitarbeiter = "";
    private DateTime start;
    private DateTime ende;
    private DateTime defaultStart;
    private DateTime defaultEnd;
    private int page;
    private int pageSize = 100;
    private string tableSearch = "";
    private string? sortColumn;
    private bool sortAscending = true;

    private DashboardDefinition dashboard = new();
    private List<KeyValuePair<string, string>> people = [new("", "Alle")];
    private readonly Dictionary<string, QueryResult> overviewResults = new(StringComparer.OrdinalIgnoreCase);
    private readonly Dictionary<string, string> columnFilters = new(StringComparer.OrdinalIgnoreCase);
    private readonly Stack<string> viewHistory = new();
    private List<Dictionary<string, object?>> filteredDetailRows = [];
    private QueryResult? detail;
    private IReadOnlyList<ChartDefinition> detailCharts = [];
    private ChartDefinition? relatedChart;

    private DashboardWidget? PrimaryWidget =>
        dashboard.Widgets.FirstOrDefault(w => w.Id.Equals("umsatzverlauf", StringComparison.OrdinalIgnoreCase));

    private IEnumerable<DashboardWidget> KpiWidgets =>
        dashboard.Widgets
            .Where(w => w.Type.Equals("kpi", StringComparison.OrdinalIgnoreCase))
            .OrderBy(w => w.Order);

    private IEnumerable<DashboardWidget> SecondaryChartWidgets =>
        dashboard.Widgets
            .Where(w => !w.Type.Equals("kpi", StringComparison.OrdinalIgnoreCase)
                     && !w.Type.Equals("detail-link", StringComparison.OrdinalIgnoreCase)
                     && !w.Id.Equals("umsatzverlauf", StringComparison.OrdinalIgnoreCase))
            .OrderBy(w => w.Order);

    private IEnumerable<DashboardWidget> DetailWidgets =>
        dashboard.Widgets
            .Where(w => w.Type.Equals("detail-link", StringComparison.OrdinalIgnoreCase))
            .OrderBy(w => w.Order);

    private IEnumerable<string> OtherDatasets =>
        Reports.Datasets.Keys
            .Where(x => !x.Equals("VertriebsmitarbeiterListe", StringComparison.OrdinalIgnoreCase))
            .Where(x => !dashboard.Widgets.Any(w => w.Dataset.Equals(x, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(LabelFor);

    private IEnumerable<Dictionary<string, object?>> VisibleRows =>
        filteredDetailRows.Skip(page * pageSize).Take(pageSize);

    private int PageCount =>
        Math.Max(1, (int)Math.Ceiling(filteredDetailRows.Count / (double)pageSize));

    private int PageSize
    {
        get => pageSize;
        set
        {
            pageSize = value;
            page = 0;
        }
    }

    private int ColumnFilterCount =>
        columnFilters.Values.Count(x => !string.IsNullOrWhiteSpace(x));

    private string SelectedSalespersonLabel =>
        people.FirstOrDefault(x => x.Key.Equals(mitarbeiter, StringComparison.OrdinalIgnoreCase)).Value
        ?? mitarbeiter;

    private string FilterSummary
    {
        get
        {
            var customer = string.IsNullOrWhiteSpace(kunde) ? "alle Kunden" : kunde;
            var sales = string.IsNullOrWhiteSpace(mitarbeiter) ? "alle Mitarbeiter" : SelectedSalespersonLabel;
            return $"{start:dd.MM.yy}–{ende:dd.MM.yy} · {customer} · {sales}";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        SetDefaultDates();

        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        allowed = Access.Can(user, "kundencockpit", "View") && Access.Can(user, "kundencockpit", "Run");

        if (allowed)
        {
            try
            {
                dashboard = Dashboards.Get("Kundencockpit");
                await LoadPeopleAsync();
                await LoadOverviewAsync();
            }
            catch (Exception ex)
            {
                error = Friendly(ex);
            }
        }

        initialized = true;
    }

    private void SetDefaultDates()
    {
        var now = DateTime.Today;
        defaultStart = new DateTime(now.Year - 1, now.Month, 1);
        defaultEnd = new DateTime(now.Year + 1, now.Month, 1).AddDays(-1);
        start = defaultStart;
        ende = defaultEnd;
    }

    private ReportFilters Filters => new(start, ende, kunde ?? "", mitarbeiter ?? "");

    private async Task LoadPeopleAsync()
    {
        if (!Reports.Datasets.ContainsKey("VertriebsmitarbeiterListe"))
            return;

        var result = await Reports.RunAsync("VertriebsmitarbeiterListe", Filters);
        var list = new List<KeyValuePair<string, string>>();

        foreach (var row in result.Rows)
        {
            var value = Cell(row, "Wert");
            var label = Cell(row, "Bezeichnung");
            list.Add(new(value, string.IsNullOrWhiteSpace(label) ? value : label));
        }

        if (list.All(x => x.Key.Length != 0))
            list.Insert(0, new("", "Alle"));

        people = list
            .DistinctBy(x => x.Key, StringComparer.OrdinalIgnoreCase)
            .ToList();
    }

    private async Task ShowOverviewAsync()
    {
        viewHistory.Clear();
        selected = OverviewKey;
        ResetTableState();
        await LoadOverviewAsync();
    }

    private async Task ShowDatasetAsync(string dataset)
    {
        if (!selected.Equals(dataset, StringComparison.OrdinalIgnoreCase))
            viewHistory.Push(selected);

        selected = dataset;
        ResetTableState();
        await LoadDetailAsync(dataset);
    }

    private async Task NavigateBackAsync()
    {
        if (viewHistory.TryPop(out var previous))
        {
            selected = previous;
            ResetTableState();

            if (previous == OverviewKey)
                await LoadOverviewAsync();
            else
                await LoadDetailAsync(previous);

            return;
        }

        if (selected != OverviewKey)
        {
            selected = OverviewKey;
            ResetTableState();
            await LoadOverviewAsync();
            return;
        }

        await JS.InvokeVoidAsync("DynReportCharts.goBack", "/");
    }

    private async Task RefreshAsync()
    {
        page = 0;

        if (selected == OverviewKey)
            await LoadOverviewAsync();
        else
            await LoadDetailAsync(selected);
    }

    private async Task ResetFiltersAsync()
    {
        start = defaultStart;
        ende = defaultEnd;
        kunde = "";
        mitarbeiter = "";
        page = 0;

        await RefreshAsync();
    }

    private async Task ClearCustomerAsync()
    {
        kunde = "";
        await RefreshAsync();
    }

    private async Task ClearSalespersonAsync()
    {
        mitarbeiter = "";
        await RefreshAsync();
    }

    private async Task LoadOverviewAsync()
    {
        busy = true;
        error = null;

        try
        {
            overviewResults.Clear();

            var datasets = dashboard.Widgets
                .Where(w => !w.Type.Equals("detail-link", StringComparison.OrdinalIgnoreCase))
                .Select(w => w.Dataset)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Where(Reports.Datasets.ContainsKey)
                .ToArray();

            foreach (var dataset in datasets)
                overviewResults[dataset] = await Reports.RunAsync(dataset, Filters);
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadDetailAsync(string dataset)
    {
        busy = true;
        error = null;
        relatedChart = null;

        try
        {
            detail = await Reports.RunAsync(dataset, Filters);
            detailCharts = Charts.BuildDetail(dataset, detail);

            if (dataset.Equals("offeneABs", StringComparison.OrdinalIgnoreCase)
                && Reports.Datasets.ContainsKey("offeneRAs"))
            {
                var framework = await Reports.RunAsync("offeneRAs", Filters);
                relatedChart = Charts.BuildOpenOrderBusinessArea(detail, framework);
            }
            else if (dataset.Equals("offeneRAs", StringComparison.OrdinalIgnoreCase)
                     && Reports.Datasets.ContainsKey("offeneABs"))
            {
                var openOrders = await Reports.RunAsync("offeneABs", Filters);
                relatedChart = Charts.BuildOpenOrderBusinessArea(openOrders, detail);
            }

            RebuildFilteredRows();
        }
        catch (Exception ex)
        {
            detail = null;
            detailCharts = [];
            relatedChart = null;
            filteredDetailRows = [];
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleChartClickAsync(ChartPointEvent e)
    {
        var widget = dashboard.Widgets.FirstOrDefault(w => w.Id.Equals(e.ChartKey, StringComparison.OrdinalIgnoreCase));
        if (widget is null || !widget.Interactive)
            return;

        string? categoryKey = null;
        string? categoryLabel = null;
        string? groupLabel = null;

        if (e.Data.ValueKind == JsonValueKind.Object)
        {
            if (e.Data.TryGetProperty("categoryKey", out var keyElement))
                categoryKey = keyElement.GetString();

            if (e.Data.TryGetProperty("categoryLabel", out var labelElement))
                categoryLabel = labelElement.GetString();

            if (e.Data.TryGetProperty("groupLabel", out var groupElement))
                groupLabel = groupElement.GetString();
        }

        if (widget.Id.Equals("top-kunden", StringComparison.OrdinalIgnoreCase)
            && !string.IsNullOrWhiteSpace(categoryLabel)
            && !categoryLabel.Equals("Übrige Kunden", StringComparison.OrdinalIgnoreCase))
        {
            kunde = categoryLabel;
            await LoadOverviewAsync();
            return;
        }

        if (DateTime.TryParse(categoryKey, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
            && string.Equals(widget.TimeBucket, "month", StringComparison.OrdinalIgnoreCase))
        {
            start = new DateTime(date.Year, date.Month, 1);
            ende = start.AddMonths(1).AddDays(-1);

            if (!string.IsNullOrWhiteSpace(groupLabel) && !string.IsNullOrWhiteSpace(widget.GroupField))
            {
                await OpenDetailFilteredAsync(widget.Dataset, widget.GroupField, groupLabel);
                return;
            }

            await LoadOverviewAsync();
            return;
        }

        if (!string.IsNullOrWhiteSpace(groupLabel) && !string.IsNullOrWhiteSpace(widget.GroupField))
        {
            await OpenDetailFilteredAsync(widget.Dataset, widget.GroupField, groupLabel);
            return;
        }

        if (!string.IsNullOrWhiteSpace(categoryLabel)
            && !string.IsNullOrWhiteSpace(widget.CategoryField)
            && !widget.CategoryField.Contains("datum", StringComparison.OrdinalIgnoreCase)
            && !widget.CategoryField.Equals("Monat", StringComparison.OrdinalIgnoreCase))
        {
            await OpenDetailFilteredAsync(widget.Dataset, widget.CategoryField, categoryLabel);
            return;
        }

        await ShowDatasetAsync(widget.Dataset);
    }

    private Task HandleDetailChartClickAsync(ChartPointEvent e)
    {
        if (detail is null)
            return Task.CompletedTask;

        string? categoryLabel = null;
        string? groupLabel = null;

        if (e.Data.ValueKind == JsonValueKind.Object)
        {
            if (e.Data.TryGetProperty("categoryLabel", out var categoryElement))
                categoryLabel = categoryElement.GetString();

            if (e.Data.TryGetProperty("groupLabel", out var groupElement))
                groupLabel = groupElement.GetString();
        }

        if (!string.IsNullOrWhiteSpace(groupLabel))
        {
            var businessColumn = detail.Columns.Contains("GeschäftsbereichBezeichnung", StringComparer.OrdinalIgnoreCase)
                ? "GeschäftsbereichBezeichnung"
                : detail.Columns.Contains("Geschäftsbereich", StringComparer.OrdinalIgnoreCase)
                    ? "Geschäftsbereich"
                    : null;

            if (businessColumn is not null)
                SetColumnFilter(businessColumn, groupLabel);

            return Task.CompletedTask;
        }

        var value = categoryLabel ?? e.Name;
        if (string.IsNullOrWhiteSpace(value))
            return Task.CompletedTask;

        var preferredColumn = e.ChartKey switch
        {
            "revenue-world" => "Land",
            "revenue-area" => "Geschäftsbereich",
            "stock-status" => "Status",
            "stock-customers" => "Kunde",
            "offers-status-raw" => "Status",
            "offers-business" => "GeschäftsbereichBezeichnung",
            _ => null
        };

        if (preferredColumn is not null
            && detail.Columns.Contains(preferredColumn, StringComparer.OrdinalIgnoreCase))
            SetColumnFilter(preferredColumn, value);

        return Task.CompletedTask;
    }

    private async Task OpenDetailFilteredAsync(string dataset, string column, string value)
    {
        await ShowDatasetAsync(dataset);

        if (detail is not null && detail.Columns.Contains(column, StringComparer.OrdinalIgnoreCase))
        {
            columnFilters[column] = value;
            RebuildFilteredRows();
        }
    }

    private QueryResult? ResultFor(string dataset) =>
        overviewResults.TryGetValue(dataset, out var result) ? result : null;

    private string MetricValue(DashboardWidget widget, MetricSummary? summary)
    {
        if (summary?.Value is not decimal value)
            return "–";

        return FormatValue(value, widget.Format);
    }

    private static string FormatValue(decimal value, string? format) =>
        format?.Equals("currency", StringComparison.OrdinalIgnoreCase) == true
            ? value.ToString("C0", DeAt)
            : format?.Equals("integer", StringComparison.OrdinalIgnoreCase) == true
                ? value.ToString("N0", DeAt)
                : value.ToString("N1", DeAt);

    private void OnGlobalSearch(ChangeEventArgs e)
    {
        tableSearch = e.Value?.ToString() ?? "";
        page = 0;
        RebuildFilteredRows();
    }

    private string GetColumnFilter(string column) =>
        columnFilters.TryGetValue(column, out var value) ? value : "";

    private void SetColumnFilter(string column, string? value)
    {
        var text = value?.Trim() ?? "";

        if (string.IsNullOrWhiteSpace(text))
            columnFilters.Remove(column);
        else
            columnFilters[column] = text;

        page = 0;
        RebuildFilteredRows();
    }

    private void ClearColumnFilters()
    {
        columnFilters.Clear();
        page = 0;
        RebuildFilteredRows();
    }

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        page = 0;
        RebuildFilteredRows();
    }

    private void RebuildFilteredRows()
    {
        if (detail is null)
        {
            filteredDetailRows = [];
            return;
        }

        IEnumerable<Dictionary<string, object?>> rows = detail.Rows;

        if (!string.IsNullOrWhiteSpace(tableSearch))
        {
            rows = rows.Where(row =>
                detail.Columns.Any(column =>
                    Cell(row, column).Contains(tableSearch, StringComparison.CurrentCultureIgnoreCase)));
        }

        foreach (var filter in columnFilters.Where(x => !string.IsNullOrWhiteSpace(x.Value)))
        {
            var column = filter.Key;
            var expression = filter.Value;
            rows = rows.Where(row => MatchesColumnFilter(row, column, expression));
        }

        if (!string.IsNullOrWhiteSpace(sortColumn))
        {
            rows = sortAscending
                ? rows.OrderBy(row => SortValue(row, sortColumn), ObjectComparer.Instance)
                : rows.OrderByDescending(row => SortValue(row, sortColumn), ObjectComparer.Instance);
        }

        filteredDetailRows = rows.ToList();

        if (page >= PageCount)
            page = Math.Max(0, PageCount - 1);
    }

    private static bool MatchesColumnFilter(
        IReadOnlyDictionary<string, object?> row,
        string column,
        string expression)
    {
        var raw = QueryResult.Get(row, column);
        var cell = Cell(row, column);
        var term = expression.Trim();

        if (term.StartsWith("!=", StringComparison.Ordinal))
            return !cell.Equals(term[2..].Trim(), StringComparison.CurrentCultureIgnoreCase);

        if (term.StartsWith("=", StringComparison.Ordinal))
            return cell.Equals(term[1..].Trim(), StringComparison.CurrentCultureIgnoreCase);

        foreach (var op in new[] { ">=", "<=", ">", "<" })
        {
            if (!term.StartsWith(op, StringComparison.Ordinal))
                continue;

            var rhs = term[op.Length..].Trim();
            var comparison = CompareFilterValues(raw, rhs);
            if (comparison is null)
                return false;

            return op switch
            {
                ">=" => comparison >= 0,
                "<=" => comparison <= 0,
                ">" => comparison > 0,
                "<" => comparison < 0,
                _ => false
            };
        }

        return cell.Contains(term, StringComparison.CurrentCultureIgnoreCase);
    }

    private static int? CompareFilterValues(object? raw, string rhs)
    {
        if (raw is null)
            return null;

        if (decimal.TryParse(Convert.ToString(raw, DeAt), NumberStyles.Any, DeAt, out var leftNumber)
            && decimal.TryParse(rhs, NumberStyles.Any, DeAt, out var rightNumber))
            return leftNumber.CompareTo(rightNumber);

        var leftDate = raw switch
        {
            DateTime dt => dt,
            DateTimeOffset dto => dto.DateTime,
            _ => DateTime.TryParse(Convert.ToString(raw, DeAt), DeAt, DateTimeStyles.AllowWhiteSpaces, out var parsed)
                ? parsed
                : (DateTime?)null
        };

        if (leftDate.HasValue
            && DateTime.TryParse(rhs, DeAt, DateTimeStyles.AllowWhiteSpaces, out var rightDate))
            return leftDate.Value.CompareTo(rightDate);

        return string.Compare(
            Convert.ToString(raw, DeAt),
            rhs,
            StringComparison.CurrentCultureIgnoreCase);
    }

    private static object? SortValue(IReadOnlyDictionary<string, object?> row, string column) =>
        QueryResult.Get(row, column);

    private async Task ExportCsvAsync()
    {
        if (detail is null)
            return;

        var rows = filteredDetailRows
            .Select(row => detail.Columns.ToDictionary(column => column, column => (object?)Cell(row, column)))
            .ToArray();

        var safeName = string.Concat(LabelFor(selected).Select(ch => Path.GetInvalidFileNameChars().Contains(ch) ? '_' : ch));
        var fileName = $"{safeName}_{DateTime.Now:yyyyMMdd_HHmm}.csv";

        await JS.InvokeVoidAsync("DynReportCharts.downloadCsv", fileName, detail.Columns, rows);
    }

    private void PreviousPage()
    {
        if (page > 0)
            page--;
    }

    private void NextPage()
    {
        if (page + 1 < PageCount)
            page++;
    }

    private void ResetTableState()
    {
        page = 0;
        tableSearch = "";
        sortColumn = null;
        sortAscending = true;
        columnFilters.Clear();
        filteredDetailRows = [];
        relatedChart = null;
    }

