@page "/reports/kundencockpit"
@attribute [Authorize]
@inject FolderAccess Access
@inject AuthenticationStateProvider Authentication
@inject ReportService Reports
@inject DashboardCatalog Dashboards
@inject ChartOptionFactory Charts
@inject IJSRuntime JS

<PageTitle>Kundencockpit · DynReport System</PageTitle>

@if (!initialized)
{
    <div class="page-loading">
        <div class="loading-ring"></div>
        <span>Bericht wird initialisiert …</span>
    </div>
}
else if (!allowed)
{
    <div class="notice error">Für das Kundencockpit wurde keine Ausführungsberechtigung vergeben.</div>
}
else
{
<div class="shell">
    <header class="topbar">
        <div class="brand-mark">D</div>
        <div class="brand-text">
            <strong>@dashboard.Title</strong>
            <span>DynReport System · Fuchshofer</span>
        </div>
        <div class="topbar-tag">
            <span class="live-dot"></span>
            APP-01 · Live
        </div>
    </header>

    <div class="app-layout">
        <aside class="sidebar">
            <a class="nav-btn" href="/">← Berichtsordner</a>

            <div class="section-label">ANSICHT</div>
            <button class="nav-btn @(selected == OverviewKey ? "active" : "")"
                    @onclick="ShowOverviewAsync">
                Dashboard
            </button>

            <div class="section-label nav-title">DETAILS</div>
            @foreach (var widget in DetailWidgets)
            {
                <button class="nav-btn @(selected == widget.Dataset ? "active" : "")"
                        @onclick="() => ShowDatasetAsync(widget.Dataset)">
                    @widget.Title
                </button>
            }

            @if (OtherDatasets.Any())
            {
                <div class="section-label nav-title">WEITERE DATEN</div>
                @foreach (var dataset in OtherDatasets)
                {
                    <button class="nav-btn @(selected == dataset ? "active" : "")"
                            @onclick="() => ShowDatasetAsync(dataset)">
                        @LabelFor(dataset)
                    </button>
                }
            }

            <div class="sidebar-foot">
                <strong>DynReport 0.2.0</strong><br />
                RDL = Datenlogik<br />
                DynReport = Darstellung & Interaktion
            </div>
        </aside>

        <main class="main-area">
            <div class="heading-line">
                <div>
                    <p class="eyebrow">VERTRIEB · LIVE ANALYTICS</p>
                    <h1>@(selected == OverviewKey ? dashboard.Title : LabelFor(selected))</h1>
                    <p class="subtitle">
                        @(selected == OverviewKey
                            ? dashboard.Subtitle
                            : "Interaktive Detailanalyse mit Live-Daten aus der aktuellen RDL-Logik")
                    </p>
                </div>

                <div class="heading-actions">
                    <span class="data-badge"><span class="live-dot"></span> SQL Live</span>
                    @if (selected != OverviewKey)
                    {
                        <button class="ghost-btn" @onclick="ShowOverviewAsync">Dashboard</button>
                    }
                </div>
            </div>

            <section class="filterbar" aria-label="Filter">
                <label>
                    Von
                    <input type="date" @bind="start" />
                </label>

                <label>
                    Bis
                    <input type="date" @bind="ende" />
                </label>

                <label>
                    Kunde
                    <input type="search"
                           maxlength="100"
                           placeholder="Kundenname (optional)"
                           @bind="kunde"
                           @bind:event="oninput" />
                </label>

                <label>
                    Vertriebsmitarbeiter
                    <select @bind="mitarbeiter">
                        @foreach (var person in people)
                        {
                            <option value="@person.Key">@person.Value</option>
                        }
                    </select>
                </label>

                <button class="primary-btn" disabled="@busy" @onclick="RefreshAsync">
                    @(busy ? "Lädt …" : "Anwenden")
                </button>

                <button class="ghost-btn filter-reset" disabled="@busy" @onclick="ResetFiltersAsync">
                    Zurücksetzen
                </button>
            </section>

            @if (error is not null)
            {
                <div role="alert" class="notice error">
                    <strong>Auswertung nicht verfügbar</strong><br />
                    @error
                </div>
            }

            @if (busy)
            {
                <div class="loading-strip">
                    <span></span>
                </div>
            }

            @if (selected == OverviewKey)
            {
                <section class="dashboard-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">KENNZAHLEN</p>
                            <h2>Aktuelle Geschäftslage</h2>
                        </div>
                        <span class="section-note">@start.ToString("dd.MM.yyyy") – @ende.ToString("dd.MM.yyyy")</span>
                    </div>

                    <div class="kpi-grid">
                        @foreach (var widget in KpiWidgets)
                        {
                            var result = ResultFor(widget.Dataset);
                            var summary = result is null ? null : Charts.Summarize(widget, result);

                            <button class="kpi-card kpi-button"
                                    @onclick="() => ShowDatasetAsync(widget.Dataset)">
                                <div class="kpi-topline">
                                    <div>
                                        <div class="kpi-label">@widget.Title</div>
                                        <div class="kpi-subtitle">@widget.Subtitle</div>
                                    </div>

                                    @if (summary?.TrendPercent is decimal trend)
                                    {
                                        <span class="trend-chip @(trend >= 0 ? "positive" : "negative")">
                                            @(trend >= 0 ? "▲" : "▼")
                                            @Math.Abs(trend).ToString("N1", DeAt) %
                                        </span>
                                    }
                                </div>

                                <div class="kpi-value">@MetricValue(widget, summary)</div>

                                @if (result is not null && !string.IsNullOrWhiteSpace(widget.CategoryField))
                                {
                                    <EChart ChartKey="@($"spark-{widget.Id}")"
                                            Options="@Charts.Sparkline(widget, result)"
                                            Height="52px" />
                                }

                                <div class="kpi-foot">
                                    <span>Details öffnen</span>
                                    <span>→</span>
                                </div>
                            </button>
                        }
                    </div>
                </section>

                @if (overviewResults.Values.Any(x => x.Truncated))
                {
                    <div class="notice warn">
                        Mindestens ein Dashboard-Dataset wurde auf die konfigurierte Maximalzeilenzahl begrenzt.
                        Summen aus diesem Dataset können unvollständig sein.
                    </div>
                }

                <section class="dashboard-section">
                    <div class="section-heading">
                        <div>
                            <p class="eyebrow">ENTWICKLUNG & STRUKTUR</p>
                            <h2>Interaktive Analysen</h2>
                        </div>
                        <span class="section-note">Grafiken sind zoombar und als Bild exportierbar</span>
                    </div>

                    <div class="dynamic-dashboard-grid">
                        @foreach (var widget in ChartWidgets)
                        {
                            var result = ResultFor(widget.Dataset);

                            <section class="panel dashboard-widget"
                                     style="grid-column: span @Math.Max(1, widget.ColSpan)">
                                <div class="panel-head">
                                    <div>
                                        <h2>@widget.Title</h2>
                                        <p>@widget.Subtitle</p>
                                    </div>
                                    @if (widget.Interactive)
                                    {
                                        <span class="interactive-badge">interaktiv</span>
                                    }
                                </div>

                                @if (result is null)
                                {
                                    <div class="chart-placeholder">
                                        <div class="loading-ring small"></div>
                                        <span>Wird geladen …</span>
                                    </div>
                                }
                                else if (result.Rows.Count == 0)
                                {
                                    <div class="empty">Keine Daten im gewählten Zeitraum.</div>
                                }
                                else
                                {
                                    <EChart @key="@($"{widget.Id}-{start:yyyyMMdd}-{ende:yyyyMMdd}-{kunde}-{mitarbeiter}")"
                                            ChartKey="@widget.Id"
                                            Options="@Charts.BuildDashboard(widget, result)"
                                            Height="@($"{Math.Max(260, widget.Height)}px")"
                                            OnPointClick="HandleChartClickAsync" />
                                }
                            </section>
                        }
                    </div>
                </section>

                <section class="quick-links">
                    @foreach (var widget in DetailWidgets)
                    {
                        <button class="insight-tile" @onclick="() => ShowDatasetAsync(widget.Dataset)">
                            <span class="insight-icon">↗</span>
                            <strong>@widget.Title</strong>
                            <span>@DetailHint(widget.Dataset)</span>
                        </button>
                    }
                </section>

                <div class="notice info">
                    Die RDL wird ausschließlich als Daten- und Geschäftslogikquelle verwendet.
                    Layout, Kennzahlen, Charts, Karten und Interaktionen stammen aus DynReport.
                </div>
            }
            else
            {
                @if (detailCharts.Count > 0)
                {
                    <section class="dashboard-section">
                        <div class="section-heading">
                            <div>
                                <p class="eyebrow">VISUELLE ANALYSE</p>
                                <h2>@LabelFor(selected)</h2>
                            </div>
                            @if (selected == "Umsatz")
                            {
                                <span class="section-note">Kartendaten: @("@svg-maps/world") · CC BY 4.0</span>
                            }
                        </div>

                        <div class="detail-visual-grid">
                            @foreach (var chart in detailCharts)
                            {
                                <section class="panel dashboard-widget">
                                    <div class="panel-head">
                                        <div>
                                            <h2>@chart.Title</h2>
                                            <p>@chart.Subtitle</p>
                                        </div>
                                    </div>

                                    <EChart @key="@($"{chart.Key}-{start:yyyyMMdd}-{ende:yyyyMMdd}-{kunde}-{mitarbeiter}")"
                                            ChartKey="@chart.Key"
                                            Options="@chart.Options"
                                            Height="@chart.Height" />
                                </section>
                            }
                        </div>
                    </section>
                }

                <section class="panel detail-panel">
                    <div class="panel-head detail-head">
                        <div>
                            <h2>Datensätze</h2>
                            <p>@LabelFor(selected) · aus der aktuell installierten RDL</p>
                        </div>

                        <div class="detail-actions">
                            <span class="muted">
                                @FilteredDetailRows.Count.ToString("N0", DeAt)
                                @if (detail is not null && FilteredDetailRows.Count != detail.Rows.Count)
                                {
                                    <text> von @detail.Rows.Count.ToString("N0", DeAt)</text>
                                }
                                Zeilen
                            </span>

                            <button class="ghost-btn" disabled="@(detail is null || detail.Rows.Count == 0)" @onclick="ExportCsvAsync">
                                CSV exportieren
                            </button>
                        </div>
                    </div>

                    @if (detail?.Truncated == true)
                    {
                        <div class="notice warn">
                            Das SQL-Ergebnis wurde serverseitig auf die konfigurierte Maximalzeilenzahl begrenzt.
                        </div>
                    }

                    @if (detail is null || detail.Rows.Count == 0)
                    {
                        <div class="empty">Keine Daten vorhanden.</div>
                    }
                    else
                    {
                        <div class="table-toolbar">
                            <label class="table-search">
                                <span>Suche</span>
                                <input type="search"
                                       placeholder="In allen sichtbaren Feldern suchen …"
                                       @bind="TableSearch"
                                       @bind:event="oninput" />
                            </label>

                            <label class="page-size">
                                <span>Zeilen</span>
                                <select @bind="pageSize">
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                    <option value="250">250</option>
                                    <option value="500">500</option>
                                </select>
                            </label>
                        </div>

                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in detail.Columns)
                                        {
                                            <th>
                                                <button class="column-sort" @onclick="() => SortBy(column)">
                                                    @column
                                                    @if (sortColumn == column)
                                                    {
                                                        <span>@(sortAscending ? "▲" : "▼")</span>
                                                    }
                                                </button>
                                            </th>
                                        }
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var row in VisibleRows)
                                    {
                                        <tr>
                                            @foreach (var column in detail.Columns)
                                            {
                                                <td title="@Cell(row, column)">
                                                    @Cell(row, column)
                                                </td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pagination">
                            <span>Seite @(page + 1) / @PageCount</span>
                            <div>
                                <button disabled="@(page == 0)" @onclick="PreviousPage">← Zurück</button>
                                <button disabled="@(page + 1 >= PageCount)" @onclick="NextPage">Weiter →</button>
                            </div>
                        </div>
                    }
                </section>
            }

            <footer>
                DynReport System 0.2.0 · Windows SSO · moderne Visualisierung auf bestehender RDL-Datenlogik
            </footer>
        </main>
    </div>
</div>
}

@code {
    private const string OverviewKey = "__overview__";
    private static readonly CultureInfo DeAt = CultureInfo.GetCultureInfo("de-AT");

    private bool initialized;
    private bool allowed;
    private bool busy;
    private string? error;
    private string selected = OverviewKey;
    private string kunde = "";
    private string mitarbeiter = "";
    private DateTime start;
    private DateTime ende;
    private int page;
    private int pageSize = 100;
    private string tableSearch = "";
    private string? sortColumn;
    private bool sortAscending = true;

    private DashboardDefinition dashboard = new();
    private List<KeyValuePair<string, string>> people = [new("", "Alle")];
    private readonly Dictionary<string, QueryResult> overviewResults = new(StringComparer.OrdinalIgnoreCase);
    private QueryResult? detail;
    private IReadOnlyList<ChartDefinition> detailCharts = [];

    private string TableSearch
    {
        get => tableSearch;
        set
        {
            tableSearch = value ?? "";
            page = 0;
        }
    }

    private IEnumerable<DashboardWidget> KpiWidgets =>
        dashboard.Widgets
            .Where(w => w.Type.Equals("kpi", StringComparison.OrdinalIgnoreCase))
            .OrderBy(w => w.Order);

    private IEnumerable<DashboardWidget> ChartWidgets =>
        dashboard.Widgets
            .Where(w => !w.Type.Equals("kpi", StringComparison.OrdinalIgnoreCase)
                     && !w.Type.Equals("detail-link", StringComparison.OrdinalIgnoreCase))
            .OrderBy(w => w.Order);

    private IEnumerable<DashboardWidget> DetailWidgets =>
        dashboard.Widgets
            .Where(w => w.Type.Equals("detail-link", StringComparison.OrdinalIgnoreCase))
            .OrderBy(w => w.Order);

    private IEnumerable<string> OtherDatasets =>
        Reports.Datasets.Keys
            .Where(x => !x.Equals("VertriebsmitarbeiterListe", StringComparison.OrdinalIgnoreCase))
            .Where(x => !dashboard.Widgets.Any(w => w.Dataset.Equals(x, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(LabelFor);

    private List<Dictionary<string, object?>> FilteredDetailRows
    {
        get
        {
            if (detail is null)
                return [];

            IEnumerable<Dictionary<string, object?>> rows = detail.Rows;

            if (!string.IsNullOrWhiteSpace(tableSearch))
            {
                rows = rows.Where(row =>
                    detail.Columns.Any(column =>
                        Cell(row, column).Contains(tableSearch, StringComparison.CurrentCultureIgnoreCase)));
            }

            if (!string.IsNullOrWhiteSpace(sortColumn))
            {
                rows = sortAscending
                    ? rows.OrderBy(row => SortValue(row, sortColumn), ObjectComparer.Instance)
                    : rows.OrderByDescending(row => SortValue(row, sortColumn), ObjectComparer.Instance);
            }

            return rows.ToList();
        }
    }

    private IEnumerable<Dictionary<string, object?>> VisibleRows =>
        FilteredDetailRows.Skip(page * pageSize).Take(pageSize);

    private int PageCount =>
        Math.Max(1, (int)Math.Ceiling(FilteredDetailRows.Count / (double)pageSize));

    protected override async Task OnInitializedAsync()
    {
        SetDefaultDates();

        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        allowed = Access.Can(user, "kundencockpit", "View") && Access.Can(user, "kundencockpit", "Run");

        if (allowed)
        {
            try
            {
                dashboard = Dashboards.Get("Kundencockpit");
                await LoadPeopleAsync();
                await LoadOverviewAsync();
            }
            catch (Exception ex)
            {
                error = Friendly(ex);
            }
        }

        initialized = true;
    }

    private void SetDefaultDates()
    {
        var now = DateTime.Today;
        start = new DateTime(now.Year - 1, now.Month, 1);
        ende = new DateTime(now.Year + 1, now.Month, 1).AddDays(-1);
    }

    private ReportFilters Filters => new(start, ende, kunde ?? "", mitarbeiter ?? "");

    private async Task LoadPeopleAsync()
    {
        if (!Reports.Datasets.ContainsKey("VertriebsmitarbeiterListe"))
            return;

        var result = await Reports.RunAsync("VertriebsmitarbeiterListe", Filters);
        var list = new List<KeyValuePair<string, string>>();

        foreach (var row in result.Rows)
        {
            var value = Cell(row, "Wert");
            var label = Cell(row, "Bezeichnung");
            list.Add(new(value, string.IsNullOrWhiteSpace(label) ? value : label));
        }

        if (list.All(x => x.Key.Length != 0))
            list.Insert(0, new("", "Alle"));

        people = list;
    }

    private async Task ShowOverviewAsync()
    {
        selected = OverviewKey;
        page = 0;
        tableSearch = "";
        await LoadOverviewAsync();
    }

    private async Task ShowDatasetAsync(string dataset)
    {
        selected = dataset;
        page = 0;
        tableSearch = "";
        sortColumn = null;
        sortAscending = true;
        await LoadDetailAsync(dataset);
    }

    private async Task RefreshAsync()
    {
        page = 0;

        if (selected == OverviewKey)
            await LoadOverviewAsync();
        else
            await LoadDetailAsync(selected);
    }

    private async Task ResetFiltersAsync()
    {
        SetDefaultDates();
        kunde = "";
        mitarbeiter = "";
        page = 0;

        if (selected == OverviewKey)
            await LoadOverviewAsync();
        else
            await LoadDetailAsync(selected);
    }

    private async Task LoadOverviewAsync()
    {
        busy = true;
        error = null;

        try
        {
            overviewResults.Clear();

            var datasets = dashboard.Widgets
                .Where(w => !w.Type.Equals("detail-link", StringComparison.OrdinalIgnoreCase))
                .Select(w => w.Dataset)
                .Distinct(StringComparer.OrdinalIgnoreCase)
                .Where(Reports.Datasets.ContainsKey)
                .ToArray();

            foreach (var dataset in datasets)
                overviewResults[dataset] = await Reports.RunAsync(dataset, Filters);
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadDetailAsync(string dataset)
    {
        busy = true;
        error = null;

        try
        {
            detail = await Reports.RunAsync(dataset, Filters);
            detailCharts = Charts.BuildDetail(dataset, detail);
            page = 0;
        }
        catch (Exception ex)
        {
            detail = null;
            detailCharts = [];
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task HandleChartClickAsync(ChartPointEvent e)
    {
        var widget = dashboard.Widgets.FirstOrDefault(w => w.Id.Equals(e.ChartKey, StringComparison.OrdinalIgnoreCase));
        if (widget is null || !widget.Interactive)
            return;

        if (e.Data.ValueKind == JsonValueKind.Object)
        {
            if (e.Data.TryGetProperty("categoryKey", out var keyElement))
            {
                var key = keyElement.GetString();

                if (DateTime.TryParse(key, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date)
                    && string.Equals(widget.TimeBucket, "month", StringComparison.OrdinalIgnoreCase))
                {
                    start = new DateTime(date.Year, date.Month, 1);
                    ende = start.AddMonths(1).AddDays(-1);
                    await LoadOverviewAsync();
                    return;
                }
            }

            if (e.Data.TryGetProperty("categoryLabel", out var labelElement)
                && widget.Id.Equals("top-kunden", StringComparison.OrdinalIgnoreCase))
            {
                var label = labelElement.GetString() ?? "";
                if (!string.IsNullOrWhiteSpace(label)
                    && !label.Equals("Übrige Kunden", StringComparison.OrdinalIgnoreCase))
                {
                    kunde = label;
                    await LoadOverviewAsync();
                    return;
                }
            }
        }

        if (!widget.Type.Equals("kpi", StringComparison.OrdinalIgnoreCase))
            await ShowDatasetAsync(widget.Dataset);
    }

    private QueryResult? ResultFor(string dataset) =>
        overviewResults.TryGetValue(dataset, out var result) ? result : null;

    private string MetricValue(DashboardWidget widget, MetricSummary? summary)
    {
        if (summary?.Value is not decimal value)
            return "–";

        return FormatValue(value, widget.Format);
    }

    private static string FormatValue(decimal value, string? format) =>
        format?.Equals("currency", StringComparison.OrdinalIgnoreCase) == true
            ? value.ToString("C0", DeAt)
            : format?.Equals("integer", StringComparison.OrdinalIgnoreCase) == true
                ? value.ToString("N0", DeAt)
                : value.ToString("N1", DeAt);

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }

        page = 0;
    }

    private static object? SortValue(IReadOnlyDictionary<string, object?> row, string column) =>
        QueryResult.Get(row, column);

    private async Task ExportCsvAsync()
    {
        if (detail is null)
            return;

        var rows = FilteredDetailRows
            .Select(row => detail.Columns.ToDictionary(column => column, column => (object?)Cell(row, column)))
            .ToArray();

        var safeName = string.Concat(LabelFor(selected).Select(ch => Path.GetInvalidFileNameChars().Contains(ch) ? '_' : ch));
        var fileName = $"{safeName}_{DateTime.Now:yyyyMMdd_HHmm}.csv";

        await JS.InvokeVoidAsync("DynReportCharts.downloadCsv", fileName, detail.Columns, rows);
    }

    private void PreviousPage()
    {
        if (page > 0)
            page--;
    }

    private void NextPage()
    {
        if (page + 1 < PageCount)
            page++;
    }

    private static string DetailHint(string dataset) => dataset switch
    {
        "Umsatz" => "Weltkarte, Geschäftsbereichsmix und Buchungsdetails",
        "Bestelleingang" => "Verlauf, Geschäftsbereiche und Auftragsdetails",
        "Angebote" => "Status, Geschäftsbereiche und Angebotspositionen",
        "offeneABs" => "Offene Aufträge nach Geschäftsbereich",
        "offeneRAs" => "Rahmenabrufe und offene Werte",
        "offenPosten" => "OP-Aging nach Fälligkeit",
        "KundenReklamationen" => "Reklamationstrend und Kosten",
        "LagerndeKundenartikel" => "Lagerstatus und gebundener Lagerwert",
        _ => "Interaktive Detailanalyse"
    };

    private static string LabelFor(string name) => name switch
    {
        "Umsatz" => "Umsatzbuchungen",
        "offeneABs" => "Offene Auftragsbestätigungen",
        "KundenReklamationen" => "Reklamationen",
        "offenPosten" => "Offene Posten",
        "offeneRAs" => "Offene Rahmenaufträge",
        "UmsatzTopKunden" => "Top-Kunden",
        "KundenUmsatzAuftragMonat" => "Umsatz & Aufträge je Monat",
        "Angebote" => "Angebote",
        "AngebotsStatusAnalyse" => "Angebotsstatus",
        "AngebotsAblehnungsgruende" => "Ablehnungsgründe",
        "AngebotsDurchlaufzeit" => "Angebotsdurchlaufzeit",
        "LagerndeKundenartikel" => "Lagernde Kundenartikel",
        "Bestelleingang" => "Bestelleingang",
        _ => name
    };

    private static string Friendly(Exception ex) => ex switch
    {
        UnauthorizedAccessException => ex.Message,
        FileNotFoundException => ex.Message,
        InvalidDataException => ex.Message,
        InvalidOperationException => ex.Message,
        ArgumentException => ex.Message,
        _ => "Fehler beim Laden der Berichtsdaten. Details stehen im Server-Log."
    };

    private static string Cell(IReadOnlyDictionary<string, object?> row, string key)
    {
        var value = QueryResult.Get(row, key);
        if (value is null)
            return "";

        string result = value switch
        {
            DateTime date => date.ToString("dd.MM.yyyy", DeAt),
            DateTimeOffset dto => dto.ToString("dd.MM.yyyy", DeAt),
            decimal dec => dec.ToString("N2", DeAt),
            double dbl => dbl.ToString("N2", DeAt),
            float flt => flt.ToString("N2", DeAt),
            _ => Convert.ToString(value, DeAt) ?? ""
        };

        return result
            .Replace("\r\n", " · ")
            .Replace("\n", " · ")
            .Replace("\r", " · ");
    }

    private sealed class ObjectComparer : IComparer<object?>
    {
        public static ObjectComparer Instance { get; } = new();

        public int Compare(object? x, object? y)
        {
            if (ReferenceEquals(x, y)) return 0;
            if (x is null) return -1;
            if (y is null) return 1;

            if (x is IComparable comparable && x.GetType() == y.GetType())
                return comparable.CompareTo(y);

            return string.Compare(
                Convert.ToString(x, DeAt),
                Convert.ToString(y, DeAt),
                StringComparison.CurrentCultureIgnoreCase);
        }
    }
}
