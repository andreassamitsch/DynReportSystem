@page "/reports/kundencockpit"
@attribute [Authorize]
@inject FolderAccess Access
@inject AuthenticationStateProvider Authentication
@inject ReportService Reports
@inject DashboardCatalog Dashboards

<PageTitle>Kundencockpit · DynReport System</PageTitle>

@if (!initialized)
{
    <div class="notice">Bericht wird initialisiert …</div>
}
else if (!allowed)
{
    <div class="notice error">Für das Kundencockpit wurde keine Ausführungsberechtigung vergeben.</div>
}
else
{
<div class="shell">
    <header class="topbar">
        <div class="brand-mark">D</div>
        <div class="brand-text">
            <strong>@dashboard.Title</strong>
            <span>DynReport System · Fuchshofer</span>
        </div>
        <div class="topbar-tag">APP-01 · Interaktiv</div>
    </header>

    <div class="app-layout">
        <aside class="sidebar">
            <a class="nav-btn" href="/">← Berichtsordner</a>
            <div class="section-label">ANSICHT</div>
            <button class="nav-btn @(selected == OverviewKey ? "active" : "")" @onclick="ShowOverviewAsync">Dashboard</button>

            <div class="section-label nav-title">DETAILS</div>
            @foreach (var widget in dashboard.Widgets.Where(w => w.Type == "detail-link").OrderBy(w => w.Order))
            {
                <button class="nav-btn @(selected == widget.Dataset ? "active" : "")"
                        @onclick="() => ShowDatasetAsync(widget.Dataset)">
                    @widget.Title
                </button>
            }

            <div class="section-label nav-title">WEITERE DATEN</div>
            @foreach (var dataset in OtherDatasets)
            {
                <button class="nav-btn @(selected == dataset ? "active" : "")"
                        @onclick="() => ShowDatasetAsync(dataset)">
                    @LabelFor(dataset)
                </button>
            }

            <div class="sidebar-foot">
                Datenlogik: @rdlFile<br />
                Layout: DynReport Dashboard-Definition
            </div>
        </aside>

        <main class="main-area">
            <div class="heading-line">
                <div>
                    <p class="eyebrow">VERTRIEB · LIVE ANALYTICS</p>
                    <h1>@(selected == OverviewKey ? dashboard.Title : LabelFor(selected))</h1>
                    <p class="subtitle">@dashboard.Subtitle</p>
                </div>
                <span class="data-badge">● SQL Live</span>
            </div>

            <section class="filterbar" aria-label="Filter">
                <label>Von<input type="date" @bind="start" /></label>
                <label>Bis<input type="date" @bind="ende" /></label>
                <label>Kunde<input type="search" maxlength="100" placeholder="Kundenname (optional)" @bind="kunde" @bind:event="oninput" /></label>
                <label>Vertriebsmitarbeiter
                    <select @bind="mitarbeiter">
                        @foreach (var person in people)
                        {
                            <option value="@person.Key">@person.Value</option>
                        }
                    </select>
                </label>
                <button class="primary-btn" disabled="@busy" @onclick="RefreshAsync">
                    @(busy ? "Lädt …" : "Anwenden")
                </button>
            </section>

            @if (error is not null)
            {
                <div role="alert" class="notice error">
                    <strong>Auswertung nicht verfügbar</strong><br />@error
                </div>
            }

            @if (busy)
            {
                <div role="status" class="notice">Daten werden aus SQL geladen …</div>
            }

            @if (selected == OverviewKey)
            {
                <div class="kpi-grid">
                    @foreach (var widget in KpiWidgets)
                    {
                        <button class="kpi-card kpi-button" @onclick="() => ShowDatasetAsync(widget.Dataset)">
                            <div class="kpi-label">@widget.Title</div>
                            <div class="kpi-value">@WidgetValue(widget)</div>
                            <div class="kpi-foot">Details öffnen →</div>
                        </button>
                    }
                </div>

                <div class="dynamic-dashboard-grid">
                    @foreach (var widget in MainWidgets)
                    {
                        if (widget.Type == "combo-chart")
                        {
                            var result = ResultFor(widget.Dataset);
                            <section class="panel dashboard-widget" style="grid-column: span @Math.Max(1, widget.ColSpan)">
                                <div class="panel-head">
                                    <div>
                                        <h2>@widget.Title</h2>
                                        <p>Monat anklicken, um den Zeitraum direkt zu filtern.</p>
                                    </div>
                                    <span class="muted">interaktiv</span>
                                </div>

                                @if (result is null || result.Rows.Count == 0)
                                {
                                    <div class="empty">Keine Daten vorhanden.</div>
                                }
                                else
                                {
                                    <div class="bar-chart">
                                        @foreach (var row in result.Rows)
                                        {
                                            <button class="bar-group chart-click"
                                                    title="@ChartTooltip(widget, row)"
                                                    @onclick="() => FilterByCategoryAsync(widget, row)">
                                                <div class="bar-container">
                                                    <div class="bar sales-bar" style="height:@BarHeight(widget, row, widget.ValueField)%"></div>
                                                    @if (!string.IsNullOrWhiteSpace(widget.SecondaryValueField))
                                                    {
                                                        <div class="bar orders-bar" style="height:@BarHeight(widget, row, widget.SecondaryValueField)%"></div>
                                                    }
                                                </div>
                                                <span>@CategoryLabel(widget, row)</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </section>
                        }
                        else if (widget.Type == "ranking")
                        {
                            var result = ResultFor(widget.Dataset);
                            <section class="panel dashboard-widget" style="grid-column: span @Math.Max(1, widget.ColSpan)">
                                <div class="panel-head">
                                    <div>
                                        <h2>@widget.Title</h2>
                                        <p>Kunde anklicken, um das gesamte Dashboard zu filtern.</p>
                                    </div>
                                </div>

                                @if (result is null || result.Rows.Count == 0)
                                {
                                    <div class="empty">Keine Daten vorhanden.</div>
                                }
                                else
                                {
                                    @foreach (var row in result.Rows.Take(12))
                                    {
                                        <button class="customer-row customer-button"
                                                @onclick="() => FilterByRankingAsync(widget, row)">
                                            <div class="customer-title">@CategoryLabel(widget, row)</div>
                                            <strong>@FormatValue(Number(row, widget.ValueField), widget.Format)</strong>
                                        </button>
                                    }
                                }
                            </section>
                        }
                        else if (widget.Type == "detail-link")
                        {
                            <button class="insight-tile" @onclick="() => ShowDatasetAsync(widget.Dataset)">
                                <span class="insight-icon">↗</span>
                                <strong>@widget.Title</strong>
                                <span>Detailansicht öffnen</span>
                            </button>
                        }
                    }
                </div>

                <div class="notice info">
                    Die RDL liefert ausschließlich Datenlogik und Parameter. Darstellung, Interaktion und Layout stammen
                    aus der DynReport-Dashboarddefinition und können später im visuellen Designer bearbeitet werden.
                </div>
            }
            else
            {
                <section class="panel detail-panel">
                    <div class="panel-head">
                        <div>
                            <h2>@LabelFor(selected)</h2>
                            <p>Interaktive Detailansicht · Daten aus der aktuellen RDL-Logik</p>
                        </div>
                        <span class="muted">@(detail?.Rows.Count ?? 0) Zeilen</span>
                    </div>

                    @if (detail?.Truncated == true)
                    {
                        <div class="notice warn">Die Ergebnisanzeige wurde serverseitig begrenzt.</div>
                    }

                    @if (detail is null || detail.Rows.Count == 0)
                    {
                        <div class="empty">Keine Daten vorhanden.</div>
                    }
                    else
                    {
                        <div class="table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        @foreach (var column in detail.Columns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in detail.Rows.Skip(page * PageSize).Take(PageSize))
                                    {
                                        <tr>
                                            @foreach (var column in detail.Columns)
                                            {
                                                <td title="@Cell(row, column)">@Cell(row, column)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="pagination">
                            <span>Seite @(page + 1) / @PageCount</span>
                            <div>
                                <button disabled="@(page == 0)" @onclick="PreviousPage">← Zurück</button>
                                <button disabled="@(page + 1 >= PageCount)" @onclick="NextPage">Weiter →</button>
                            </div>
                        </div>
                    }
                </section>
            }

            <footer>DynReport System 0.1.0 · Windows SSO · modernes Dashboard auf bestehender Datenlogik</footer>
        </main>
    </div>
</div>
}

@code {
    private const string OverviewKey = "__overview__";
    private const int PageSize = 100;

    private bool initialized;
    private bool allowed;
    private bool busy;
    private string? error;
    private string selected = OverviewKey;
    private string kunde = "";
    private string mitarbeiter = "";
    private string rdlFile = "Kundencockpit.rdl";
    private DateTime start;
    private DateTime ende;
    private int page;

    private DashboardDefinition dashboard = new();
    private List<KeyValuePair<string, string>> people = [new("", "Alle")];
    private readonly Dictionary<string, QueryResult> overviewResults = new(StringComparer.OrdinalIgnoreCase);
    private QueryResult? detail;

    private IEnumerable<DashboardWidget> KpiWidgets =>
        dashboard.Widgets.Where(w => w.Type == "kpi").OrderBy(w => w.Order);

    private IEnumerable<DashboardWidget> MainWidgets =>
        dashboard.Widgets.Where(w => w.Type != "kpi").OrderBy(w => w.Order);

    private IEnumerable<string> OtherDatasets =>
        Reports.Datasets.Keys
            .Where(x => !x.Equals("VertriebsmitarbeiterListe", StringComparison.OrdinalIgnoreCase))
            .Where(x => !dashboard.Widgets.Any(w => w.Dataset.Equals(x, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(LabelFor);

    private int PageCount => detail is null
        ? 1
        : Math.Max(1, (int)Math.Ceiling(detail.Rows.Count / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        var now = DateTime.Today;
        start = new DateTime(now.Year - 1, now.Month, 1);
        ende = new DateTime(now.Year + 1, now.Month, 1).AddDays(-1);

        var user = (await Authentication.GetAuthenticationStateAsync()).User;
        allowed = Access.Can(user, "kundencockpit", "View") && Access.Can(user, "kundencockpit", "Run");

        if (allowed)
        {
            try
            {
                dashboard = Dashboards.Get("Kundencockpit");
                await LoadPeopleAsync();
                await LoadOverviewAsync();
            }
            catch (Exception ex)
            {
                error = Friendly(ex);
            }
        }

        initialized = true;
    }

    private ReportFilters Filters => new(start, ende, kunde ?? "", mitarbeiter ?? "");

    private async Task LoadPeopleAsync()
    {
        if (!Reports.Datasets.ContainsKey("VertriebsmitarbeiterListe"))
            return;

        var result = await Reports.RunAsync("VertriebsmitarbeiterListe", Filters);
        var list = new List<KeyValuePair<string, string>>();

        foreach (var row in result.Rows)
        {
            var value = Cell(row, "Wert");
            var label = Cell(row, "Bezeichnung");
            list.Add(new(value, string.IsNullOrWhiteSpace(label) ? value : label));
        }

        if (list.All(x => x.Key.Length != 0))
            list.Insert(0, new("", "Alle"));

        people = list;
    }

    private async Task ShowOverviewAsync()
    {
        selected = OverviewKey;
        page = 0;
        await LoadOverviewAsync();
    }

    private async Task ShowDatasetAsync(string dataset)
    {
        selected = dataset;
        page = 0;
        await LoadDetailAsync(dataset);
    }

    private async Task RefreshAsync()
    {
        if (selected == OverviewKey)
            await LoadOverviewAsync();
        else
            await LoadDetailAsync(selected);
    }

    private async Task LoadOverviewAsync()
    {
        busy = true;
        error = null;

        try
        {
            overviewResults.Clear();
            foreach (var dataset in dashboard.Widgets.Select(w => w.Dataset).Distinct(StringComparer.OrdinalIgnoreCase))
            {
                if (Reports.Datasets.ContainsKey(dataset))
                    overviewResults[dataset] = await Reports.RunAsync(dataset, Filters);
            }
        }
        catch (Exception ex)
        {
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task LoadDetailAsync(string dataset)
    {
        busy = true;
        error = null;

        try
        {
            detail = await Reports.RunAsync(dataset, Filters);
            page = 0;
        }
        catch (Exception ex)
        {
            detail = null;
            error = Friendly(ex);
        }
        finally
        {
            busy = false;
        }
    }

    private async Task FilterByRankingAsync(DashboardWidget widget, IReadOnlyDictionary<string, object?> row)
    {
        var value = CategoryLabel(widget, row);
        if (string.IsNullOrWhiteSpace(value) || value.Equals("Übrige Kunden", StringComparison.OrdinalIgnoreCase))
            return;

        kunde = value;
        selected = OverviewKey;
        await LoadOverviewAsync();
    }

    private async Task FilterByCategoryAsync(DashboardWidget widget, IReadOnlyDictionary<string, object?> row)
    {
        var value = QueryResult.Get(row, widget.CategoryField ?? "");
        if (value is not DateTime date)
            return;

        start = new DateTime(date.Year, date.Month, 1);
        ende = start.AddMonths(1).AddDays(-1);
        selected = OverviewKey;
        await LoadOverviewAsync();
    }

    private QueryResult? ResultFor(string dataset) =>
        overviewResults.TryGetValue(dataset, out var result) ? result : null;

    private string WidgetValue(DashboardWidget widget)
    {
        var result = ResultFor(widget.Dataset);
        return FormatValue(result?.Sum(widget.ValueField ?? ""), widget.Format);
    }

    private static string FormatValue(decimal? value, string? format) =>
        format?.Equals("currency", StringComparison.OrdinalIgnoreCase) == true
            ? Currency(value)
            : value?.ToString("N2", CultureInfo.GetCultureInfo("de-AT")) ?? "–";

    private decimal ChartMax(DashboardWidget widget)
    {
        var result = ResultFor(widget.Dataset);
        if (result is null) return 1m;

        var values = result.Rows.SelectMany(r => new[]
        {
            Math.Abs(Number(r, widget.ValueField) ?? 0),
            Math.Abs(Number(r, widget.SecondaryValueField) ?? 0)
        });

        return Math.Max(1m, values.DefaultIfEmpty(1m).Max());
    }

    private decimal BarHeight(DashboardWidget widget, IReadOnlyDictionary<string, object?> row, string? field)
    {
        if (string.IsNullOrWhiteSpace(field)) return 0;
        return Math.Clamp(Math.Abs(Number(row, field) ?? 0) / ChartMax(widget) * 100m, 0m, 100m);
    }

    private string CategoryLabel(DashboardWidget widget, IReadOnlyDictionary<string, object?> row)
    {
        var key = widget.CategoryField ?? "";
        var value = QueryResult.Get(row, key);
        if (value is DateTime date) return date.ToString("MM/yy", CultureInfo.GetCultureInfo("de-AT"));
        return Convert.ToString(value, CultureInfo.GetCultureInfo("de-AT")) ?? "";
    }

    private string ChartTooltip(DashboardWidget widget, IReadOnlyDictionary<string, object?> row)
    {
        var first = FormatValue(Number(row, widget.ValueField), "currency");
        var second = FormatValue(Number(row, widget.SecondaryValueField), "currency");
        return $"{CategoryLabel(widget, row)} · {first} · {second}";
    }

    private void PreviousPage()
    {
        if (page > 0) page--;
    }

    private void NextPage()
    {
        if (page + 1 < PageCount) page++;
    }

    private static string LabelFor(string name) => name switch
    {
        "Umsatz" => "Umsatzbuchungen",
        "offeneABs" => "Offene Auftragsbestätigungen",
        "KundenReklamationen" => "Reklamationen",
        "offenPosten" => "Offene Posten",
        "offeneRAs" => "Offene Rahmenaufträge",
        "UmsatzTopKunden" => "Top-Kunden",
        "KundenUmsatzAuftragMonat" => "Umsatz & Aufträge je Monat",
        "Angebote" => "Angebote",
        "AngebotsStatusAnalyse" => "Angebotsstatus",
        "AngebotsAblehnungsgruende" => "Ablehnungsgründe",
        "AngebotsDurchlaufzeit" => "Angebotsdurchlaufzeit",
        "LagerndeKundenartikel" => "Lagernde Kundenartikel",
        "Bestelleingang" => "Bestelleingang",
        _ => name
    };

    private static string Friendly(Exception ex) => ex switch
    {
        UnauthorizedAccessException => ex.Message,
        FileNotFoundException => ex.Message,
        InvalidDataException => ex.Message,
        InvalidOperationException => ex.Message,
        ArgumentException => ex.Message,
        _ => "Fehler beim Laden der Berichtsdaten. Details stehen im Server-Log."
    };

    private static string Cell(IReadOnlyDictionary<string, object?> row, string key)
    {
        var value = QueryResult.Get(row, key);
        if (value is null) return "";
        if (value is DateTime date) return date.ToString("dd.MM.yyyy", CultureInfo.GetCultureInfo("de-AT"));
        if (value is decimal dec) return dec.ToString("N2", CultureInfo.GetCultureInfo("de-AT"));
        if (value is double dbl) return dbl.ToString("N2", CultureInfo.GetCultureInfo("de-AT"));
        return Convert.ToString(value, CultureInfo.GetCultureInfo("de-AT")) ?? "";
    }

    private static decimal? Number(IReadOnlyDictionary<string, object?> row, string? key)
    {
        if (string.IsNullOrWhiteSpace(key)) return null;
        var value = QueryResult.Get(row, key);
        if (value is null) return null;
        try { return Convert.ToDecimal(value, CultureInfo.InvariantCulture); }
        catch { return null; }
    }

    private static string Currency(decimal? value) =>
        value.HasValue ? value.Value.ToString("C0", CultureInfo.GetCultureInfo("de-AT")) : "–";
}
