    private void RemoveTableColumn(DynTableColumn column)
    {
        SelectedComponent?.Table?.Columns.Remove(column);
    }

    private void MoveTableColumn(DynTableColumn column, int offset)
    {
        if (SelectedComponent?.Table is null || offset == 0)
            return;

        var columns = SelectedComponent.Table.Columns;
        var current = columns.IndexOf(column);
        var target = current + offset;

        if (current < 0 || target < 0 || target >= columns.Count)
            return;

        columns.RemoveAt(current);
        columns.Insert(target, column);
    }

    private static string TableColumnsText(DynTableDefinition table) =>
        string.Join("; ", table.Columns.Where(x => !x.Hidden).Select(x => x.Field));

    private void SetTableColumns(DynVisual visual, string? value)
    {
        if (visual.Table is null)
            return;

        var fields = string.IsNullOrWhiteSpace(value)
            ? FieldsFor(visual.Dataset).ToArray()
            : value.Split(
                ';',
                StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);

        var existing = visual.Table.Columns
            .ToDictionary(x => x.Field, StringComparer.OrdinalIgnoreCase);

        visual.Table.Columns = fields
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .Select(field => existing.TryGetValue(field, out var column)
                ? column
                : new DynTableColumn { Field = field, Header = field })
            .ToList();
    }

    private static string ColorOverrideText(IReadOnlyDictionary<string, string> colors) =>
        string.Join("; ", colors.Select(item => $"{item.Key}={item.Value}"));

    private static void SetColorOverrides(
        IDictionary<string, string> target,
        string? value)
    {
        target.Clear();

        foreach (var item in (value ?? "").Split(
            ';',
            StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            var separator = item.IndexOf('=');
            if (separator <= 0 || separator >= item.Length - 1)
                continue;

            var key = item[..separator].Trim();
            var color = item[(separator + 1)..].Trim();

            if (key.Length == 0
                || color.Length != 7
                || color[0] != '#'
                || !color.Skip(1).All(Uri.IsHexDigit))
                continue;

            target[key] = color;
        }
    }

    private static string SortText(IEnumerable<DynSortDefinition> sorts) =>
        string.Join("; ", sorts.Select(x => $"{x.Field}:{x.Direction.ToLowerInvariant()}"));

    private static void SetSortList(List<DynSortDefinition> target, string? value)
    {
        target.Clear();

        if (string.IsNullOrWhiteSpace(value))
            return;

        foreach (var part in value.Split(
                     ';',
                     StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries))
        {
            var pieces = part.Split(':', 2, StringSplitOptions.TrimEntries);
            if (string.IsNullOrWhiteSpace(pieces[0]))
                continue;

            target.Add(new DynSortDefinition
            {
                Field = pieces[0],
                Direction = pieces.Length > 1
                    && pieces[1].Equals("desc", StringComparison.OrdinalIgnoreCase)
                        ? "Desc"
                        : "Asc"
            });
        }
    }

