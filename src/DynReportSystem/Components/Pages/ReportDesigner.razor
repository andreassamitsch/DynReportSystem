@page "/designer/{ReportId}"
@attribute [Authorize]
@inject DynReportPackageStore Packages
@inject DynReportMetadataStore Metadata
@inject FolderAccess Access
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>Designer · @(draft?.Manifest.Title ?? "DynReport")</PageTitle>

@if (!initialized)
{
    <div class="page-loading">
        <div class="loading-ring"></div>
        <span>Designer wird geladen …</span>
    </div>
}
else if (draft is null)
{
    <div class="notice error">@message</div>
}
else if (!canEditLayout)
{
    <div class="notice error">Für diesen Bericht fehlt die Designer-Berechtigung.</div>
}
else
{
<div class="shell">
    <header class="topbar">
        <div class="brand-mark">D</div>
        <div class="brand-text">
            <strong>DynReport Designer</strong>
            <span>@draft.Manifest.Title · Schema @draft.Manifest.SchemaVersion</span>
        </div>
        <div class="topbar-tag">v@draft.Manifest.Version</div>
    </header>

    <main class="main-area dyn-designer">
        <div class="heading-line">
            <div>
                <p class="eyebrow">DESIGNER-FIRST</p>
                <h1>@draft.Manifest.Title</h1>
                <p class="subtitle">
                    Dieser Designer bearbeitet dasselbe Dokumentmodell, das die Runtime ausführt.
                    Es gibt keinen separaten Report-Code.
                </p>
            </div>

            <div class="designer-actions">
                <a class="ghost-btn" href="@($"/reports/package/{ReportId}")">Vorschau</a>
                <a class="ghost-btn" href="@($"/api/packages/{ReportId}/download")">Exportieren</a>
                <button class="primary-btn" disabled="@saving" @onclick="SaveAsync">
                    @(saving ? "Speichert …" : "Speichern")
                </button>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <div class="notice @(success ? "info" : "error")">@message</div>
        }

        <nav class="designer-tabs">
            <button class="@(tab == "report" ? "active" : "")" @onclick='() => tab = "report"'>Bericht</button>
            <button class="@(tab == "data" ? "active" : "")" @onclick='() => tab = "data"'>Daten</button>
            <button class="@(tab == "parameters" ? "active" : "")" @onclick='() => tab = "parameters"'>Parameter</button>
            <button class="@(tab == "layout" ? "active" : "")" @onclick='() => tab = "layout"'>Layout</button>
            <button class="@(tab == "revisions" ? "active" : "")" @onclick='() => tab = "revisions"'>Versionen</button>
        </nav>

        @if (tab == "report")
        {
            <section class="panel designer-panel">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">METADATEN</p>
                        <h2>Bericht</h2>
                    </div>
                </div>

                <div class="designer-form-grid">
                    <label>
                        <span>Titel</span>
                        <input @bind="draft.Manifest.Title" />
                    </label>
                    <label>
                        <span>Pfad</span>
                        <input @bind="draft.Manifest.Path" />
                    </label>
                    <label class="wide">
                        <span>Beschreibung</span>
                        <textarea rows="4" @bind="draft.Manifest.Description"></textarea>
                    </label>
                    <label>
                        <span>Auto-Refresh Sekunden</span>
                        <input type="number" min="0" step="30"
                               @bind="draft.Document.Settings.AutoRefreshSeconds" />
                    </label>
                    <label class="designer-check">
                        <input type="checkbox" @bind="draft.Document.Settings.AutoRun" />
                        <span>Automatisch ausführen</span>
                    </label>
                    <label class="designer-check">
                        <input type="checkbox"
                               @bind="draft.Document.Settings.ParametersCollapsedByDefault" />
                        <span>Parameter standardmäßig einklappen</span>
                    </label>
                </div>
            </section>
        }

        @if (tab == "data")
        {
            <section class="panel designer-panel">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">DATENMODELL</p>
                        <h2>Datasets</h2>
                    </div>
                    <span class="section-note">
                        SQL-Bearbeitung: @(canEditData ? "freigegeben" : "nur lesen")
                    </span>
                </div>

                <div class="designer-dataset-tabs">
                    @foreach (var dataset in draft.Document.Datasets)
                    {
                        <button class="@(activeDataset == dataset.Id ? "active" : "")"
                                @onclick="() => activeDataset = dataset.Id">
                            @dataset.Id
                        </button>
                    }
                </div>

                @if (CurrentDataset is DynReportDataset dataSet)
                {
                    <div class="designer-form-grid">
                        <label>
                            <span>Datenquelle</span>
                            <select @bind="dataSet.DataSourceId" disabled="@(!canEditData)">
                                @foreach (var source in draft.Document.DataSources)
                                {
                                    <option value="@source.Id">@source.Id (@source.ConfigKey)</option>
                                }
                            </select>
                        </label>
                        <label>
                            <span>Command Type</span>
                            <select @bind="dataSet.CommandType" disabled="@(!canEditData)">
                                <option value="Text">SQL Text</option>
                                <option value="StoredProcedure">Stored Procedure</option>
                            </select>
                        </label>
                        <label class="wide">
                            <span>SQL / Command</span>
                            <textarea class="designer-sql"
                                      rows="24"
                                      value="@CurrentSql"
                                      @onchange="SqlChanged"
                                      readonly="@(!canEditData)"></textarea>
                        </label>
                    </div>
                }
            </section>
        }

        @if (tab == "parameters")
        {
            <section class="panel designer-panel">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">EINGABEN</p>
                        <h2>Parameter</h2>
                    </div>
                </div>

                <div class="designer-parameter-list">
                    @foreach (var parameter in draft.Document.Parameters.OrderBy(x => x.Order))
                    {
                        <article class="designer-parameter-card">
                            <div class="designer-form-grid">
                                <label>
                                    <span>Name</span>
                                    <input value="@parameter.Name" readonly />
                                </label>
                                <label>
                                    <span>Bezeichnung</span>
                                    <input @bind="parameter.Label" />
                                </label>
                                <label>
                                    <span>Reihenfolge</span>
                                    <input type="number" @bind="parameter.Order" />
                                </label>
                                <label>
                                    <span>Eingabetyp</span>
                                    <select @bind="parameter.InputMode">
                                        <option value="">automatisch</option>
                                        <option value="date">Datum</option>
                                        <option value="datetime-local">Datum + Uhrzeit</option>
                                    </select>
                                </label>
                                <label class="wide">
                                    <span>Standardwerte (; getrennt)</span>
                                    <input value="@string.Join("; ", parameter.DefaultValues)"
                                           @onchange="e => SetDefaults(parameter, e.Value?.ToString())" />
                                </label>
                                <label class="designer-check">
                                    <input type="checkbox" @bind="parameter.Hidden" />
                                    <span>ausblenden</span>
                                </label>
                            </div>
                        </article>
                    }
                </div>
            </section>
        }

        @if (tab == "layout")
        {
            <section class="panel designer-panel designer-layout-panel">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">LAYOUT DESIGNER</p>
                        <h2>Seiten & Komponenten</h2>
                    </div>
                    <div class="designer-actions">
                        <button class="ghost-btn" @onclick="AddPage">+ Seite</button>
                    </div>
                </div>

                @if (draft.Document.Pages.Count == 0)
                {
                    <div class="empty">
                        Noch keine Seite vorhanden.
                        <button class="primary-btn" @onclick="AddPage">Erste Seite anlegen</button>
                    </div>
                }
                else
                {
                    <div class="designer-page-tabs">
                        @foreach (var pageTab in draft.Document.Pages)
                        {
                            <button class="@(pageTab.Id == activePageId ? "active" : "")"
                                    @onclick="() => SelectPage(pageTab.Id)">
                                @(string.IsNullOrWhiteSpace(pageTab.Title) ? pageTab.Id : pageTab.Title)
                                <span>@(pageTab.Components.Count)</span>
                            </button>
                        }
                    </div>

                    @if (CurrentPage is DynReportPage currentPage)
                    {
                        <div class="designer-workbench">
                            <aside class="designer-palette">
                                <div class="designer-workbench-title">
                                    <strong>Komponenten</strong>
                                    <small>zur aktuellen Seite hinzufügen</small>
                                </div>

                                <button @onclick='() => AddComponent("heading")'>
                                    <span>T</span>
                                    <div><strong>Überschrift</strong><small>Titel / Abschnitt</small></div>
                                </button>
                                <button @onclick='() => AddComponent("text")'>
                                    <span>¶</span>
                                    <div><strong>Text</strong><small>Text oder Einzelwert</small></div>
                                </button>
                                <button @onclick='() => AddComponent("metric-strip")'>
                                    <span>123</span>
                                    <div><strong>Kennzahlen</strong><small>KPI-Leiste</small></div>
                                </button>
                                <button @onclick='() => AddComponent("table")'>
                                    <span>☷</span>
                                    <div><strong>Tabelle</strong><small>Dataset-Tabelle</small></div>
                                </button>
                                <button @onclick='() => AddComponent("chart")'>
                                    <span>⌁</span>
                                    <div><strong>Diagramm</strong><small>automatische Visualisierung</small></div>
                                </button>
                                <button @onclick='() => AddComponent("grouped-board")'>
                                    <span>▦</span>
                                    <div><strong>Board</strong><small>gruppierte Statusansicht</small></div>
                                </button>
                            </aside>

                            <div class="designer-canvas-shell">
                                <div class="designer-page-settings">
                                    <label>
                                        <span>Seitentitel</span>
                                        <input @bind="currentPage.Title" />
                                    </label>
                                    <label>
                                        <span>Spalten</span>
                                        <input type="number" min="1" max="24" @bind="currentPage.Columns" />
                                    </label>
                                    <div class="designer-actions">
                                        @if (draft.Document.Pages.Count > 1)
                                        {
                                            <button class="ghost-btn danger" @onclick="RemoveCurrentPage">
                                                Seite löschen
                                            </button>
                                        }
                                    </div>
                                </div>

                                <div class="designer-canvas"
                                     style="@($"--designer-columns:{Math.Clamp(currentPage.Columns, 1, 24)}")">
                                    @if (currentPage.Components.Count == 0)
                                    {
                                        <div class="designer-canvas-empty">
                                            Links eine Komponente auswählen.
                                        </div>
                                    }

                                    @foreach (var canvasComponent in currentPage.Components)
                                    {
                                        <article class="designer-canvas-component @(canvasComponent.Id == selectedComponentId ? "selected" : "")"
                                                 style="@($"--designer-span:{Math.Clamp(canvasComponent.Span, 1, Math.Max(1, currentPage.Columns))}")"
                                                 @onclick="() => SelectComponent(canvasComponent.Id)">
                                            <div class="designer-canvas-component-head">
                                                <span class="designer-component-icon">@ComponentIcon(canvasComponent.Type)</span>
                                                <div>
                                                    <strong>@ComponentDisplayName(canvasComponent.Type)</strong>
                                                    <small>@canvasComponent.Id</small>
                                                </div>
                                            </div>

                                            <div class="designer-canvas-component-body">
                                                <strong>@(string.IsNullOrWhiteSpace(canvasComponent.Title) ? "Ohne Titel" : canvasComponent.Title)</strong>
                                                @if (!string.IsNullOrWhiteSpace(canvasComponent.Dataset))
                                                {
                                                    <small>Dataset: @canvasComponent.Dataset</small>
                                                }
                                                @if (canvasComponent.Type.Equals("metric-strip", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <small>@canvasComponent.Metrics.Count Kennzahl(en)</small>
                                                }
                                                @if (canvasComponent.Type.Equals("grouped-board", StringComparison.OrdinalIgnoreCase)
                                                     && canvasComponent.Board is not null)
                                                {
                                                    <small>@canvasComponent.Board.Columns.Count Board-Spalte(n)</small>
                                                }
                                            </div>

                                            <div class="designer-canvas-span">
                                                @(canvasComponent.Span) / @(currentPage.Columns)
                                            </div>
                                        </article>
                                    }
                                </div>
                            </div>

                            <aside class="designer-inspector">
                                <div class="designer-workbench-title">
                                    <strong>Eigenschaften</strong>
                                    <small>ausgewählte Komponente</small>
                                </div>

                                @if (SelectedComponent is not DynVisual selected)
                                {
                                    <div class="designer-inspector-empty">
                                        Eine Komponente auf der Arbeitsfläche auswählen.
                                    </div>
                                }
                                else
                                {
                                    <div class="designer-inspector-actions">
                                        <button title="nach vorne" @onclick='() => MoveSelected(-1)'>←</button>
                                        <button title="nach hinten" @onclick='() => MoveSelected(1)'>→</button>
                                        <button title="duplizieren" @onclick="DuplicateSelected">⧉</button>
                                        <button class="danger" title="löschen" @onclick="RemoveSelected">×</button>
                                    </div>

                                    <div class="designer-inspector-form">
                                        <label>
                                            <span>Typ</span>
                                            <input value="@ComponentDisplayName(selected.Type)" readonly />
                                        </label>
                                        <label>
                                            <span>ID</span>
                                            <input value="@selected.Id" readonly />
                                        </label>
                                        <label>
                                            <span>Titel</span>
                                            <input @bind="selected.Title" />
                                        </label>
                                        <label>
                                            <span>Untertitel</span>
                                            <input @bind="selected.Subtitle" />
                                        </label>

                                        @if (ComponentUsesDataset(selected.Type))
                                        {
                                            <label>
                                                <span>Dataset</span>
                                                <select @bind="selected.Dataset">
                                                    <option value="">– auswählen –</option>
                                                    @foreach (var dataset in draft.Document.Datasets)
                                                    {
                                                        <option value="@dataset.Id">@dataset.Id</option>
                                                    }
                                                </select>
                                            </label>
                                        }

                                        <div class="designer-inspector-grid">
                                            <label>
                                                <span>Desktop</span>
                                                <input type="number"
                                                       min="1"
                                                       max="@Math.Max(1, currentPage.Columns)"
                                                       @bind="selected.Span" />
                                            </label>
                                            <label>
                                                <span>Mobil</span>
                                                <input type="number" min="1" max="24" @bind="selected.MobileSpan" />
                                            </label>
                                        </div>

                                        <label>
                                            <span>CSS-Klasse</span>
                                            <input @bind="selected.CssClass" />
                                        </label>

                                        @if (selected.Type.Equals("heading", StringComparison.OrdinalIgnoreCase)
                                             || selected.Type.Equals("text", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="designer-inspector-section">
                                                <strong>Wert</strong>

                                                @if (selected.Value is null)
                                                {
                                                    <button class="ghost-btn" @onclick="AddComponentValue">
                                                        + dynamischen Wert hinzufügen
                                                    </button>
                                                }
                                                else
                                                {
                                                    <label>
                                                        <span>Operation</span>
                                                        <select @bind="selected.Value.Op">
                                                            <option value="field">Erster Feldwert</option>
                                                            <option value="count">Anzahl Zeilen</option>
                                                            <option value="sum">Summe</option>
                                                            <option value="avg">Durchschnitt</option>
                                                            <option value="min">Minimum</option>
                                                            <option value="max">Maximum</option>
                                                        </select>
                                                    </label>

                                                    @if (ExpressionUsesField(selected.Value.Op))
                                                    {
                                                        <label>
                                                            <span>Feld</span>
                                                            <select @bind="selected.Value.Field">
                                                                <option value="">– Feld –</option>
                                                                @foreach (var field in FieldsFor(selected.Dataset))
                                                                {
                                                                    <option value="@field">@field</option>
                                                                }
                                                            </select>
                                                        </label>
                                                    }

                                                    <div class="designer-inspector-grid">
                                                        <label>
                                                            <span>Format</span>
                                                            <input @bind="selected.Format" />
                                                        </label>
                                                        <label>
                                                            <span>Einheit</span>
                                                            <input @bind="selected.Unit" />
                                                        </label>
                                                    </div>

                                                    <button class="designer-link-danger"
                                                            @onclick="RemoveComponentValue">
                                                        dynamischen Wert entfernen
                                                    </button>
                                                }
                                            </div>
                                        }

                                        @if (selected.Type.Equals("metric-strip", StringComparison.OrdinalIgnoreCase))
                                        {
                                            <div class="designer-inspector-section">
                                                <div class="designer-inspector-section-head">
                                                    <strong>Kennzahlen</strong>
                                                    <button @onclick="AddMetric">+ KPI</button>
                                                </div>

                                                @foreach (var metric in selected.Metrics.ToArray())
                                                {
                                                    <div class="designer-metric-editor">
                                                        <div class="designer-metric-editor-head">
                                                            <strong>@metric.Id</strong>
                                                            <button class="danger" @onclick="() => RemoveMetric(metric)">×</button>
                                                        </div>
                                                        <label>
                                                            <span>Bezeichnung</span>
                                                            <input @bind="metric.Label" />
                                                        </label>
                                                        <label>
                                                            <span>Operation</span>
                                                            <select @bind="metric.Value.Op">
                                                                <option value="count">Anzahl Zeilen</option>
                                                                <option value="field">Erster Feldwert</option>
                                                                <option value="sum">Summe</option>
                                                                <option value="avg">Durchschnitt</option>
                                                                <option value="min">Minimum</option>
                                                                <option value="max">Maximum</option>
                                                                <option value="distinctcount">Eindeutige Anzahl</option>
                                                            </select>
                                                        </label>
                                                        @if (ExpressionUsesField(metric.Value.Op))
                                                        {
                                                            <label>
                                                                <span>Feld</span>
                                                                <select @bind="metric.Value.Field">
                                                                    <option value="">– Feld –</option>
                                                                    @foreach (var field in FieldsFor(selected.Dataset))
                                                                    {
                                                                        <option value="@field">@field</option>
                                                                    }
                                                                </select>
                                                            </label>
                                                        }
                                                        <div class="designer-inspector-grid">
                                                            <label>
                                                                <span>Format</span>
                                                                <input @bind="metric.Format" />
                                                            </label>
                                                            <label>
                                                                <span>Einheit</span>
                                                                <input @bind="metric.Unit" />
                                                            </label>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }

                                        @if (selected.Type.Equals("grouped-board", StringComparison.OrdinalIgnoreCase)
                                             && selected.Board is not null)
                                        {
                                            <div class="designer-inspector-section">
                                                <strong>Board-Struktur</strong>
                                                <label>
                                                    <span>Bereichsgruppierung (; getrennt)</span>
                                                    <input value="@string.Join("; ", selected.Board.SectionGroupBy)"
                                                           @onchange="e => SetStringList(selected.Board.SectionGroupBy, e.Value?.ToString())" />
                                                </label>
                                                <label>
                                                    <span>Zeilengruppierung (; getrennt)</span>
                                                    <input value="@string.Join("; ", selected.Board.RowGroupBy)"
                                                           @onchange="e => SetStringList(selected.Board.RowGroupBy, e.Value?.ToString())" />
                                                </label>
                                                <small>
                                                    Spalten, Status-Mappings und Regeln bleiben vollständig im selben
                                                    Komponentenmodell und werden im nächsten Designer-Schritt grafisch erweitert.
                                                </small>
                                            </div>
                                        }
                                    </div>
                                }
                            </aside>
                        </div>
                    }
                }
            </section>
        }

        @if (tab == "revisions")
        {
            <section class="panel designer-panel">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">VERSIONIERUNG</p>
                        <h2>Gesicherte Revisionen</h2>
                    </div>
                    <span class="section-note">
                        @(Metadata.IsConfigured ? "SQL-Revisionskatalog" : "lokale Übergangsrevisionen")
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(revisionWarning))
                {
                    <div class="notice warn">@revisionWarning</div>
                }

                @if (Metadata.IsConfigured && metadataRevisions.Count > 0)
                {
                    <div class="designer-revision-list">
                        @foreach (var revision in metadataRevisions)
                        {
                            <div>
                                <div>
                                    <strong>v@revision.PackageVersion</strong>
                                    @if (revision.IsActive)
                                    {
                                        <span class="custom-report-meta">aktiv</span>
                                    }
                                    <span>@revision.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                                    @if (!string.IsNullOrWhiteSpace(revision.CreatedBy))
                                    {
                                        <span>· @revision.CreatedBy</span>
                                    }
                                    <span>· @FormatBytes(revision.PackageLength)</span>
                                </div>

                                @if (!revision.IsActive && canPublish)
                                {
                                    @if (pendingRestoreRevision == revision.RevisionId)
                                    {
                                        <div class="designer-actions">
                                            <button class="ghost-btn"
                                                    disabled="@(restoringRevision is not null)"
                                                    @onclick="() => pendingRestoreRevision = null">
                                                Abbrechen
                                            </button>
                                            <button class="primary-btn"
                                                    disabled="@(restoringRevision is not null)"
                                                    @onclick="() => RestoreRevisionAsync(revision)">
                                                @(restoringRevision == revision.RevisionId
                                                    ? "Wird wiederhergestellt …"
                                                    : "Wirklich wiederherstellen")
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="ghost-btn"
                                                disabled="@(restoringRevision is not null)"
                                                @onclick="() => pendingRestoreRevision = revision.RevisionId">
                                            Wiederherstellen
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else if (revisions.Count > 0)
                {
                    <div class="designer-revision-list">
                        @foreach (var revision in revisions)
                        {
                            <div>
                                <strong>v@revision.Version</strong>
                                <span>@revision.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                            </div>
                        }
                    </div>

                    @if (!Metadata.IsConfigured)
                    {
                        <div class="notice info">
                            Diese lokalen Revisionen bleiben während der 0.7-Übergangsphase erhalten.
                            Ein transaktional nachvollziehbarer Rollback wird verfügbar, sobald die
                            DynReport-Metadatenbank konfiguriert ist.
                        </div>
                    }
                }
                else
                {
                    <div class="empty">Noch keine ältere Revision vorhanden.</div>
                }
            </section>
        }

        <footer>DynReport Designer 0.9.0 · Runtime und Designer verwenden dasselbe Paketmodell</footer>
    </main>
</div>
}

@code {
    [Parameter] public string ReportId { get; set; } = "";

    private LoadedDynReportPackage? draft;
    private ClaimsPrincipal? user;
    private bool initialized;
    private bool saving;
    private bool success;
    private bool canEditLayout;
    private bool canEditData;
    private bool canPublish;
    private Guid? pendingRestoreRevision;
    private Guid? restoringRevision;
    private string message = "";
    private string revisionWarning = "";
    private string tab = "report";
    private string activeDataset = "";
    private string activePageId = "";
    private string? selectedComponentId;
    private IReadOnlyList<DynReportRevision> revisions = [];
    private IReadOnlyList<DynReportStoredRevision> metadataRevisions = [];

    private DynReportDataset? CurrentDataset =>
        draft?.Document.Datasets.FirstOrDefault(x =>
            x.Id.Equals(activeDataset, StringComparison.OrdinalIgnoreCase));

    private string CurrentSql =>
        CurrentDataset is not null
        && draft is not null
        && draft.TextFiles.TryGetValue(CurrentDataset.QueryFile, out var sql)
            ? sql
            : "";

    private DynReportPage? CurrentPage =>
        draft?.Document.Pages.FirstOrDefault(x =>
            x.Id.Equals(activePageId, StringComparison.OrdinalIgnoreCase))
        ?? draft?.Document.Pages.FirstOrDefault();

    private DynVisual? SelectedComponent =>
        CurrentPage?.Components.FirstOrDefault(x =>
            x.Id.Equals(selectedComponentId, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        initialized = false;
        message = "";

        try
        {
            user = (await Authentication.GetAuthenticationStateAsync()).User;

            var source = Packages.Get(ReportId)
                ?? throw new FileNotFoundException("DynReport-Paket wurde nicht gefunden.");

            canEditLayout =
                Access.Can(user, ReportId, "EditLayout")
                || Access.Can(user, ReportId, "Edit")
                || Access.Can(user, ReportId, "Publish")
                || Access.Can(user, ReportId, "Manage");

            canEditData =
                Access.Can(user, ReportId, "EditData")
                || Access.Can(user, ReportId, "Publish")
                || Access.Can(user, ReportId, "Manage");

            canPublish =
                Access.Can(user, ReportId, "Publish")
                || Access.Can(user, ReportId, "Manage");

            if (!canEditLayout)
                return;

            draft = Clone(source);
            activeDataset = draft.Document.Datasets.FirstOrDefault()?.Id ?? "";
            activePageId = draft.Document.Pages.FirstOrDefault()?.Id ?? "";
            selectedComponentId = null;
            await ReloadRevisionsAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            initialized = true;
        }
    }

    private void SqlChanged(ChangeEventArgs args)
    {
        if (!canEditData || draft is null || CurrentDataset is null)
            return;

        var files = (Dictionary<string, string>)draft.TextFiles;
        files[CurrentDataset.QueryFile] = args.Value?.ToString() ?? "";
    }

    private static void SetDefaults(DynReportParameter parameter, string? value)
    {
        parameter.DefaultValues = string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(
                ';',
                StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .ToList();
    }

    private async Task SaveAsync()
    {
        if (draft is null || user is null)
            return;

        saving = true;
        success = false;
        message = "";

        try
        {
            draft.Manifest.Version = BumpPatch(draft.Manifest.Version);
            draft.Manifest.ModifiedUtc = DateTime.UtcNow;
            draft.Manifest.FolderPath = ParentPath(draft.Manifest.Path);

            draft = await Packages.SaveDesignerPackageAsync(
                draft,
                user.Identity?.Name ?? "unknown");

            await ReloadRevisionsAsync();
            success = true;
            message = $"Gespeichert als v{draft.Manifest.Version}. Vorherige Version wurde als Revision gesichert.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ReloadRevisionsAsync()
    {
        revisions = Packages.Revisions(ReportId);
        metadataRevisions = [];
        revisionWarning = "";

        if (!Metadata.IsConfigured)
            return;

        try
        {
            metadataRevisions = await Metadata.ListRevisionsAsync(ReportId);
        }
        catch (Exception ex)
        {
            revisionWarning =
                "SQL-Revisionskatalog ist derzeit nicht erreichbar: " + ex.Message;
        }
    }

    private async Task RestoreRevisionAsync(DynReportStoredRevision revision)
    {
        if (user is null || !canPublish || revision.IsActive)
            return;

        restoringRevision = revision.RevisionId;
        pendingRestoreRevision = null;
        success = false;
        message = "";

        try
        {
            var restored = await Packages.RestoreRevisionAsync(
                ReportId,
                revision.RevisionId,
                user.Identity?.Name ?? "unknown");

            draft = Clone(restored);
            activeDataset = draft.Document.Datasets.FirstOrDefault()?.Id ?? "";
            activePageId = draft.Document.Pages.FirstOrDefault()?.Id ?? "";
            selectedComponentId = null;
            await ReloadRevisionsAsync();

            success = true;
            message =
                $"Revision v{restored.Manifest.Version} wurde wiederhergestellt und als aktive Revision gesetzt.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            restoringRevision = null;
        }
    }

    private void SelectPage(string pageId)
    {
        activePageId = pageId;
        selectedComponentId = null;
    }

    private void SelectComponent(string componentId)
    {
        selectedComponentId = componentId;
    }

    private void AddPage()
    {
        if (draft is null)
            return;

        var number = draft.Document.Pages.Count + 1;
        var id = UniquePageId($"page-{number}");

        draft.Document.Pages.Add(new DynReportPage
        {
            Id = id,
            Title = $"Seite {number}",
            Columns = 12
        });

        activePageId = id;
        selectedComponentId = null;
    }

    private void RemoveCurrentPage()
    {
        if (draft is null || CurrentPage is null || draft.Document.Pages.Count <= 1)
            return;

        var index = draft.Document.Pages.IndexOf(CurrentPage);
        draft.Document.Pages.Remove(CurrentPage);

        var next = draft.Document.Pages[Math.Clamp(index - 1, 0, draft.Document.Pages.Count - 1)];
        activePageId = next.Id;
        selectedComponentId = null;
    }

    private void AddComponent(string type)
    {
        if (draft is null || CurrentPage is null)
            return;

        var dataset = draft.Document.Datasets.FirstOrDefault();
        var firstField = dataset?.Fields.FirstOrDefault() ?? "";
        var id = UniqueComponentId(type.Replace("-strip", "").Replace("grouped-", ""));

        var component = new DynVisual
        {
            Id = id,
            Type = type,
            Title = ComponentDisplayName(type),
            Dataset = ComponentUsesDataset(type) ? dataset?.Id ?? "" : "",
            Span = type.Equals("heading", StringComparison.OrdinalIgnoreCase)
                || type.Equals("text", StringComparison.OrdinalIgnoreCase)
                    ? CurrentPage.Columns
                    : Math.Min(CurrentPage.Columns, 12),
            MobileSpan = 12
        };

        if (type.Equals("metric-strip", StringComparison.OrdinalIgnoreCase))
        {
            component.Metrics.Add(new DynMetricItem
            {
                Id = "kpi-1",
                Label = "Zeilen",
                Value = new DynExpr { Op = "count" }
            });
        }

        if (type.Equals("grouped-board", StringComparison.OrdinalIgnoreCase))
        {
            component.Board = new DynGroupedBoard();

            if (!string.IsNullOrWhiteSpace(firstField))
            {
                component.Board.RowGroupBy.Add(firstField);
                component.Board.Columns.Add(new DynBoardColumn
                {
                    Id = SafeId(firstField),
                    Header = firstField,
                    Kind = "text",
                    Value = new DynExpr
                    {
                        Op = "field",
                        Field = firstField
                    }
                });
            }
            else
            {
                component.Board.Columns.Add(new DynBoardColumn
                {
                    Id = "value",
                    Header = "Wert",
                    Kind = "text",
                    Value = new DynExpr()
                });
            }
        }

        CurrentPage.Components.Add(component);
        selectedComponentId = component.Id;
    }

    private void DuplicateSelected()
    {
        if (CurrentPage is null || SelectedComponent is null)
            return;

        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            WriteIndented = true
        };

        var copy = JsonSerializer.Deserialize<DynVisual>(
            JsonSerializer.Serialize(SelectedComponent, options),
            options)!;

        copy.Id = UniqueComponentId(SelectedComponent.Type.Replace("-strip", "").Replace("grouped-", ""));

        var index = CurrentPage.Components.IndexOf(SelectedComponent);
        CurrentPage.Components.Insert(index + 1, copy);
        selectedComponentId = copy.Id;
    }

    private void RemoveSelected()
    {
        if (CurrentPage is null || SelectedComponent is null)
            return;

        var index = CurrentPage.Components.IndexOf(SelectedComponent);
        CurrentPage.Components.Remove(SelectedComponent);

        if (CurrentPage.Components.Count == 0)
        {
            selectedComponentId = null;
            return;
        }

        var nextIndex = Math.Clamp(index, 0, CurrentPage.Components.Count - 1);
        selectedComponentId = CurrentPage.Components[nextIndex].Id;
    }

    private void MoveSelected(int offset)
    {
        if (CurrentPage is null || SelectedComponent is null || offset == 0)
            return;

        var currentIndex = CurrentPage.Components.IndexOf(SelectedComponent);
        var targetIndex = currentIndex + offset;

        if (targetIndex < 0 || targetIndex >= CurrentPage.Components.Count)
            return;

        CurrentPage.Components.RemoveAt(currentIndex);
        CurrentPage.Components.Insert(targetIndex, SelectedComponent);
    }

    private void AddComponentValue()
    {
        if (SelectedComponent is null)
            return;

        SelectedComponent.Value = new DynExpr
        {
            Op = "count"
        };

        if (string.IsNullOrWhiteSpace(SelectedComponent.Dataset))
            SelectedComponent.Dataset = draft?.Document.Datasets.FirstOrDefault()?.Id ?? "";
    }

    private void RemoveComponentValue()
    {
        if (SelectedComponent is null)
            return;

        SelectedComponent.Value = null;
    }

    private void AddMetric()
    {
        if (SelectedComponent is null
            || !SelectedComponent.Type.Equals("metric-strip", StringComparison.OrdinalIgnoreCase))
            return;

        var number = SelectedComponent.Metrics.Count + 1;
        var id = UniqueMetricId(SelectedComponent, $"kpi-{number}");

        SelectedComponent.Metrics.Add(new DynMetricItem
        {
            Id = id,
            Label = $"Kennzahl {number}",
            Value = new DynExpr { Op = "count" }
        });
    }

    private void RemoveMetric(DynMetricItem metric)
    {
        SelectedComponent?.Metrics.Remove(metric);
    }

    private IEnumerable<string> FieldsFor(string datasetId)
    {
        if (draft is null || string.IsNullOrWhiteSpace(datasetId))
            return [];

        return draft.Document.Datasets
            .FirstOrDefault(x => x.Id.Equals(datasetId, StringComparison.OrdinalIgnoreCase))
            ?.Fields
            ?? [];
    }

    private static bool ComponentUsesDataset(string type) => true;

    private static bool ExpressionUsesField(string op) =>
        !op.Equals("count", StringComparison.OrdinalIgnoreCase);

    private static void SetStringList(List<string> target, string? value)
    {
        target.Clear();

        if (string.IsNullOrWhiteSpace(value))
            return;

        target.AddRange(value.Split(
            ';',
            StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries));
    }

    private string UniquePageId(string seed)
    {
        if (draft is null)
            return seed;

        var existing = draft.Document.Pages
            .Select(x => x.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return UniqueId(seed, existing);
    }

    private string UniqueComponentId(string seed)
    {
        if (draft is null)
            return seed;

        var existing = draft.Document.Pages
            .SelectMany(x => x.Components)
            .Select(x => x.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return UniqueId(SafeId(seed), existing);
    }

    private static string UniqueMetricId(DynVisual component, string seed)
    {
        var existing = component.Metrics
            .Select(x => x.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return UniqueId(SafeId(seed), existing);
    }

    private static string UniqueId(string seed, HashSet<string> existing)
    {
        var normalized = string.IsNullOrWhiteSpace(seed) ? "item" : seed;

        if (!existing.Contains(normalized))
            return normalized;

        for (var i = 2; i < 10000; i++)
        {
            var candidate = $"{normalized}-{i}";
            if (!existing.Contains(candidate))
                return candidate;
        }

        return $"{normalized}-{Guid.NewGuid():N}";
    }

    private static string SafeId(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "item";

        var chars = value.Trim().ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-')
            .ToArray();

        var id = new string(chars)
            .Replace("--", "-", StringComparison.Ordinal)
            .Trim('-');

        return string.IsNullOrWhiteSpace(id) ? "item" : id;
    }

    private static string ComponentDisplayName(string type) => type.ToLowerInvariant() switch
    {
        "metric-strip" => "Kennzahlen",
        "grouped-board" => "Board",
        "table" => "Tabelle",
        "chart" => "Diagramm",
        "heading" => "Überschrift",
        "text" => "Text",
        _ => type
    };

    private static string FormatBytes(long bytes)
    {
        if (bytes >= 1024L * 1024L)
            return $"{bytes / (1024d * 1024d):N1} MB";

        if (bytes >= 1024L)
            return $"{bytes / 1024d:N0} KB";

        return $"{bytes:N0} B";
    }

    private static LoadedDynReportPackage Clone(LoadedDynReportPackage source)
    {
        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            WriteIndented = true
        };

        var manifest = JsonSerializer.Deserialize<DynReportManifest>(
            JsonSerializer.Serialize(source.Manifest, options),
            options)!;

        var document = JsonSerializer.Deserialize<DynReportDocument>(
            JsonSerializer.Serialize(source.Document, options),
            options)!;

        return new LoadedDynReportPackage
        {
            Manifest = manifest,
            Document = document,
            FilePath = source.FilePath,
            ModifiedUtc = source.ModifiedUtc,
            TextFiles = new Dictionary<string, string>(
                source.TextFiles,
                StringComparer.OrdinalIgnoreCase)
        };
    }

    private static string ParentPath(string path)
    {
        var normalized = (path ?? "").Replace('\\', '/').TrimEnd('/');
        var index = normalized.LastIndexOf('/');
        return index <= 0 ? "/" : normalized[..index];
    }

    private static string BumpPatch(string version)
    {
        if (!Version.TryParse(version, out var parsed))
            return version + ".1";

        return new Version(
            Math.Max(parsed.Major, 0),
            Math.Max(parsed.Minor, 0),
            Math.Max(parsed.Build, 0) + 1)
            .ToString(3);
    }

    private static string ComponentIcon(string type) => type.ToLowerInvariant() switch
    {
        "metric-strip" => "123",
        "grouped-board" => "▦",
        "table" => "☷",
        "chart" => "⌁",
        "heading" => "T",
        _ => "◇"
    };
}
