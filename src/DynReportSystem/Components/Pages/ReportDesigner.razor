                                                            </label>
                                                            <label class="designer-check">
                                                                <input type="checkbox" @bind="column.Sortable" />
                                                                <span>sortierbar</span>
                                                            </label>
                                                            <label class="designer-check">
                                                                <input type="checkbox" @bind="column.Hidden" />
                                                                <span>ausgeblendet</span>
                                                            </label>
                                                        </div>
                                                    </div>
                                                }

                                                <label>
                                                    <span>Gruppierung (; getrennt)</span>
                                                    <input value="@string.Join("; ", selected.Table.GroupBy)"
                                                           @onchange="e => SetStringList(selected.Table.GroupBy, e.Value?.ToString())"
                                                           placeholder="Geschäftsbereich; Kunde" />
                                                </label>

                                                @if (selected.Table.PresentationMode.Equals("Grouped", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    <div class="designer-inspector-section-head">
                                                        <strong>Kennzahlen</strong>
                                                        <button @onclick="() => AddTableAggregate(false)">+ Kennzahl</button>
                                                    </div>

                                                    @foreach (var aggregate in selected.Table.Aggregates.ToArray())
                                                    {
                                                        @AggregateEditor(aggregate, false)
                                                    }
                                                }

                                                @if (selected.Table.PresentationMode.Equals("Pivot", StringComparison.OrdinalIgnoreCase))
                                                {
                                                    var pivot = selected.Table.Pivot ??= new DynTablePivotDefinition();

                                                    <div class="designer-metric-editor">
                                                        <strong>Pivot-Struktur</strong>
                                                        <label>
                                                            <span>Zeilenfelder (; getrennt)</span>
                                                            <input value="@string.Join("; ", pivot.RowFields)"
                                                                   @onchange="e => SetStringList(pivot.RowFields, e.Value?.ToString())"
                                                                   placeholder="Kunde; Geschäftsbereich" />
                                                        </label>
                                                        <label>
                                                            <span>Spaltenfeld</span>
                                                            <select @bind="pivot.ColumnField">
                                                                <option value="">– Feld –</option>
                                                                @foreach (var fieldName in FieldsFor(selected.Dataset))
                                                                {
                                                                    <option value="@fieldName">@fieldName</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <div class="designer-inspector-grid">
                                                            <label>
                                                                <span>Max. Pivot-Spalten</span>
                                                                <input type="number" min="1" max="60" @bind="pivot.MaxColumns" />
                                                            </label>
                                                            <label>
                                                                <span>Spaltenreihenfolge</span>
                                                                <select @bind="pivot.ColumnSort">
                                                                    <option value="Asc">Aufsteigend</option>
                                                                    <option value="Desc">Absteigend</option>
                                                                </select>
                                                            </label>
                                                        </div>
                                                    </div>

                                                    <div class="designer-inspector-section-head">
                                                        <strong>Pivot-Kennzahlen</strong>
                                                        <button @onclick="() => AddTableAggregate(true)">+ Kennzahl</button>
                                                    </div>

                                                    @foreach (var aggregate in pivot.Measures.ToArray())
                                                    {
                                                        @AggregateEditor(aggregate, true)
                                                    }
                                                }

                                                <label>
                                                    <span>Standard-Sortierung</span>
                                                    <input value="@SortText(selected.Table.DefaultSort)"
                                                           @onchange="e => SetSortList(selected.Table.DefaultSort, e.Value?.ToString())"
                                                           placeholder="Feld:asc; Umsatz:desc" />
                                                </label>

                                                <small>
                                                    Die Definition bleibt renderer-neutral. Die Runtime kann später je nach
                                                    Datenmenge einen leichten oder einen Heavy-Data-Renderer verwenden.
                                                </small>
                                            </div>
                                        }

                                        @if (selected.Type.Equals("chart", StringComparison.OrdinalIgnoreCase)
                                             && selected.Chart is not null)
                                        {
                                            <div class="designer-inspector-section">
                                                <div class="designer-inspector-section-head">
                                                    <strong>Diagramm</strong>
                                                    <button @onclick="AddChartSeries">+ Datenreihe</button>
                                                </div>

                                                <label>
                                                    <span>Diagrammtyp</span>
                                                    <select @bind="selected.Chart.ChartType">
                                                        <option value="Auto">Automatisch</option>
                                                        <option value="Bar">Säulen / Balken</option>
                                                        <option value="Line">Linie</option>
                                                        <option value="Area">Fläche</option>
                                                        <option value="Donut">Donut</option>
                                                        <option value="Treemap">Treemap</option>
                                                        <option value="WorldMap">Weltkarte</option>
                                                    </select>
                                                </label>

                                                <label>
                                                    <span>Kategorie / X-Achse</span>
                                                    <select @bind="selected.Chart.CategoryField">
                                                        <option value="">– automatisch –</option>
                                                        @foreach (var field in FieldsFor(selected.Dataset))
                                                        {
                                                            <option value="@field">@field</option>
                                                        }
                                                    </select>
                                                </label>

                                                <label>
                                                    <span>Serien gruppieren nach</span>
                                                    <select @bind="selected.Chart.SeriesByField">
                                                        <option value="">– keine –</option>
                                                        @foreach (var field in FieldsFor(selected.Dataset))
                                                        {
                                                            <option value="@field">@field</option>
                                                        }
                                                    </select>
                                                </label>

                                                <label>
                                                    <span>Globales Farbset</span>
                                                    <select @bind="selected.Chart.ColorSet">
                                                        <option value="">– Standard –</option>
                                                        <option value="BusinessArea">Geschäftsbereiche</option>
                                                    </select>
                                                </label>

                                                <label>
                                                    <span>Farbschlüssel-Feld</span>
                                                    <select @bind="selected.Chart.ColorKeyField">
                                                        <option value="">– Kategorie / Serie verwenden –</option>
                                                        @foreach (var field in FieldsFor(selected.Dataset))
                                                        {
                                                            <option value="@field">@field</option>
                                                        }
                                                    </select>
                                                </label>

                                                <label>
                                                    <span>Farb-Overrides (; getrennt)</span>
                                                    <input value="@ColorOverrideText(selected.Chart.ColorOverrides)"
                                                           @onchange="e => SetColorOverrides(selected.Chart.ColorOverrides, e.Value?.ToString())"
                                                           placeholder="10=#90ceff; 21=#7ae5da" />
                                                </label>

                                                <label>
                                                    <span>Tooltip-Zusatzfelder (; getrennt)</span>
                                                    <input value="@string.Join("; ", selected.Chart.TooltipFields)"
                                                           @onchange="e => SetStringList(selected.Chart.TooltipFields, e.Value?.ToString())"
                                                           placeholder="Kunde; Kundenanzahl" />
                                                </label>

                                                <label>
                                                    <span>Ausrichtung</span>
                                                    <select @bind="selected.Chart.Orientation">
                                                        <option value="Vertical">Vertikal</option>
                                                        <option value="Horizontal">Horizontal</option>
                                                    </select>
                                                </label>

                                                <small>
                                                    Globale Farbsets gelten systemweit. Ein Report überschreibt nur die hier
                                                    angegebenen Schlüssel. Für Geschäftsbereiche sind die bisherigen RDL-Farben
                                                    global hinterlegt.
                                                </small>

                                                <div class="designer-inspector-grid">
                                                    <label>
                                                        <span>Max. Punkte</span>
                                                        <input type="number" min="1" max="5000" @bind="selected.Chart.MaxPoints" />
                                                    </label>
                                                    <label>
                                                        <span>Höhe px</span>
                                                        <input type="number" min="180" max="1200" @bind="selected.Chart.Height" />
                                                    </label>
                                                    <label class="designer-check">
                                                        <input type="checkbox" @bind="selected.Chart.Stacked" />
                                                        <span>gestapelt</span>
                                                    </label>
                                                    <label class="designer-check">
                                                        <input type="checkbox" @bind="selected.Chart.ShowLegend" />
                                                        <span>Legende</span>
                                                    </label>
                                                    <label class="designer-check">
                                                        <input type="checkbox" @bind="selected.Chart.ShowLabels" />
                                                        <span>Werte anzeigen</span>
                                                    </label>
                                                    <label class="designer-check">
                                                        <input type="checkbox" @bind="selected.Chart.ShowStackTotal" />
                                                        <span>Gesamtsumme über Stapel</span>
                                                    </label>
                                                    <label>
                                                        <span>Summenformat</span>
                                                        <input @bind="selected.Chart.StackTotalFormat" placeholder="currency" />
                                                    </label>
                                                </div>

                                                @foreach (var series in selected.Chart.Series.ToArray())
                                                {
                                                    <div class="designer-metric-editor">
                                                        <div class="designer-metric-editor-head">
                                                            <strong>@(string.IsNullOrWhiteSpace(series.Label) ? series.Field : series.Label)</strong>
                                                            <button class="danger" @onclick="() => RemoveChartSeries(series)">×</button>
                                                        </div>
                                                        <label>
                                                            <span>Feld</span>
                                                            <select @bind="series.Field">
                                                                <option value="">– Feld –</option>
                                                                @foreach (var field in FieldsFor(selected.Dataset))
                                                                {
                                                                    <option value="@field">@field</option>
                                                                }
                                                            </select>
                                                        </label>
                                                        <label>
                                                            <span>Bezeichnung</span>
                                                            <input @bind="series.Label" />
                                                        </label>
                                                        <label>
                                                            <span>Aggregation</span>
                                                            <select @bind="series.Aggregation">
                                                                <option value="Sum">Summe</option>
                                                                <option value="Avg">Durchschnitt</option>
                                                                <option value="Min">Minimum</option>
                                                                <option value="Max">Maximum</option>
                                                                <option value="Count">Anzahl</option>
                                                                <option value="First">Erster Wert</option>
                                                            </select>
                                                        </label>
                                                        <label>
                                                            <span>Serientyp</span>
                                                            <select @bind="series.ChartType">
                                                                <option value="">– Diagrammtyp übernehmen –</option>
                                                                <option value="Bar">Säule / Balken</option>
                                                                <option value="Line">Linie</option>
                                                                <option value="Area">Fläche</option>
                                                            </select>
                                                        </label>
                                                        <div class="designer-inspector-grid">
                                                            <label>
                                                                <span>Farbe</span>
                                                                <input @bind="series.Color" placeholder="#3398FF" />
                                                            </label>
                                                            <label>
                                                                <span>Y-Achse</span>
                                                                <select @bind="series.Axis">
                                                                    <option value="0">Primär</option>
                                                                    <option value="1">Sekundär</option>
                                                                </select>
                                                            </label>
                                                            <label class="designer-check">
                                                                <input type="checkbox" @bind="series.Area" />
                                                                <span>Fläche füllen</span>
                                                            </label>
                                                        </div>
                                                        <div class="designer-inspector-grid">
                                                            <label>
                                                                <span>Format</span>
                                                                <input @bind="series.Format" />
                                                            </label>
                                                            <label>
                                                                <span>Einheit</span>
                                                                <input @bind="series.Unit" />
                                                            </label>
                                                        </div>
                                                    </div>
                                                }

                                                <small>
                                                    Der Designer speichert nur DynReport-Semantik. ECharts bleibt ein austauschbarer
                                                    Runtime-Adapter.
                                                </small>
                                            </div>
                                        }

                                        @if (selected.Type.Equals("grouped-board", StringComparison.OrdinalIgnoreCase)
                                             && selected.Board is not null)
                                        {
                                            <div class="designer-inspector-section">
                                                <strong>Board-Struktur</strong>
                                                <label>
                                                    <span>Bereichsgruppierung (; getrennt)</span>
                                                    <input value="@string.Join("; ", selected.Board.SectionGroupBy)"
                                                           @onchange="e => SetStringList(selected.Board.SectionGroupBy, e.Value?.ToString())" />
                                                </label>
                                                <label>
                                                    <span>Zeilengruppierung (; getrennt)</span>
                                                    <input value="@string.Join("; ", selected.Board.RowGroupBy)"
                                                           @onchange="e => SetStringList(selected.Board.RowGroupBy, e.Value?.ToString())" />
                                                </label>
                                                <small>
                                                    Spalten, Status-Mappings und Regeln bleiben vollständig im selben
                                                    Komponentenmodell und werden im nächsten Designer-Schritt grafisch erweitert.
                                                </small>
                                            </div>
                                        }
                                    </div>
                                }
                            </aside>
                        </div>
                    }
                }
            </section>
        }

        @if (tab == "revisions")
        {
            <section class="panel designer-panel">
                <div class="section-heading">
                    <div>
                        <p class="eyebrow">VERSIONIERUNG</p>
                        <h2>Gesicherte Revisionen</h2>
                    </div>
                    <span class="section-note">
                        @(Metadata.IsConfigured ? "SQL-Revisionskatalog" : "lokale Übergangsrevisionen")
                    </span>
                </div>

                @if (!string.IsNullOrWhiteSpace(revisionWarning))
                {
                    <div class="notice warn">@revisionWarning</div>
                }

                @if (Metadata.IsConfigured && metadataRevisions.Count > 0)
                {
                    <div class="designer-revision-list">
                        @foreach (var revision in metadataRevisions)
                        {
                            <div>
                                <div>
                                    <strong>v@revision.PackageVersion</strong>
                                    @if (revision.IsActive)
                                    {
                                        <span class="custom-report-meta">aktiv</span>
                                    }
                                    <span>@revision.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                                    @if (!string.IsNullOrWhiteSpace(revision.CreatedBy))
                                    {
                                        <span>· @revision.CreatedBy</span>
                                    }
                                    <span>· @FormatBytes(revision.PackageLength)</span>
                                </div>

                                @if (!revision.IsActive && canPublish)
                                {
                                    @if (pendingRestoreRevision == revision.RevisionId)
                                    {
                                        <div class="designer-actions">
                                            <button class="ghost-btn"
                                                    disabled="@(restoringRevision is not null)"
                                                    @onclick="() => pendingRestoreRevision = null">
                                                Abbrechen
                                            </button>
                                            <button class="primary-btn"
                                                    disabled="@(restoringRevision is not null)"
                                                    @onclick="() => RestoreRevisionAsync(revision)">
                                                @(restoringRevision == revision.RevisionId
                                                    ? "Wird wiederhergestellt …"
                                                    : "Wirklich wiederherstellen")
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <button class="ghost-btn"
                                                disabled="@(restoringRevision is not null)"
                                                @onclick="() => pendingRestoreRevision = revision.RevisionId">
                                            Wiederherstellen
                                        </button>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
                else if (revisions.Count > 0)
                {
                    <div class="designer-revision-list">
                        @foreach (var revision in revisions)
                        {
                            <div>
                                <strong>v@revision.Version</strong>
                                <span>@revision.CreatedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm:ss")</span>
                            </div>
                        }
                    </div>

                    @if (!Metadata.IsConfigured)
                    {
                        <div class="notice info">
                            Diese lokalen Revisionen bleiben während der 0.7-Übergangsphase erhalten.
                            Ein transaktional nachvollziehbarer Rollback wird verfügbar, sobald die
                            DynReport-Metadatenbank konfiguriert ist.
                        </div>
                    }
                }
                else
                {
                    <div class="empty">Noch keine ältere Revision vorhanden.</div>
                }
            </section>
        }

        <footer>DynReport Designer 0.14.0 · Runtime und Designer verwenden dasselbe Paketmodell</footer>
    </main>
</div>
}

@code {
    [Parameter] public string ReportId { get; set; } = "";

    private LoadedDynReportPackage? draft;
    private ClaimsPrincipal? user;
    private bool initialized;
    private bool saving;
    private bool success;
    private bool canEditLayout;
    private bool canEditData;
    private bool canPublish;
    private Guid? pendingRestoreRevision;
    private Guid? restoringRevision;
    private string message = "";
    private string revisionWarning = "";
    private string tab = "report";
    private string activeDataset = "";
    private string activePageId = "";
    private string? selectedComponentId;
    private IReadOnlyList<DynReportRevision> revisions = [];
    private IReadOnlyList<DynReportStoredRevision> metadataRevisions = [];

    private DynReportDataset? CurrentDataset =>
        draft?.Document.Datasets.FirstOrDefault(x =>
            x.Id.Equals(activeDataset, StringComparison.OrdinalIgnoreCase));

    private string CurrentSql =>
        CurrentDataset is not null
        && draft is not null
        && draft.TextFiles.TryGetValue(CurrentDataset.QueryFile, out var sql)
            ? sql
            : "";

    private DynReportPage? CurrentPage =>
        draft?.Document.Pages.FirstOrDefault(x =>
            x.Id.Equals(activePageId, StringComparison.OrdinalIgnoreCase))
        ?? draft?.Document.Pages.FirstOrDefault();

    private DynVisual? SelectedComponent =>
        CurrentPage?.Components.FirstOrDefault(x =>
            x.Id.Equals(selectedComponentId, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnParametersSetAsync()
    {
        initialized = false;
        message = "";

        try
        {
            user = (await Authentication.GetAuthenticationStateAsync()).User;

            var source = Packages.Get(ReportId)
                ?? throw new FileNotFoundException("DynReport-Paket wurde nicht gefunden.");

            canEditLayout =
                Access.Can(user, ReportId, "EditLayout")
                || Access.Can(user, ReportId, "Edit")
                || Access.Can(user, ReportId, "Publish")
                || Access.Can(user, ReportId, "Manage");

            canEditData =
                Access.Can(user, ReportId, "EditData")
                || Access.Can(user, ReportId, "Publish")
                || Access.Can(user, ReportId, "Manage");

            canPublish =
                Access.Can(user, ReportId, "Publish")
                || Access.Can(user, ReportId, "Manage");

            if (!canEditLayout)
                return;

            draft = Clone(source);
            activeDataset = draft.Document.Datasets.FirstOrDefault()?.Id ?? "";
            activePageId = draft.Document.Pages.FirstOrDefault()?.Id ?? "";
            selectedComponentId = null;
            await ReloadRevisionsAsync();
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            initialized = true;
        }
    }

    private void SqlChanged(ChangeEventArgs args)
    {
        if (!canEditData || draft is null || CurrentDataset is null)
            return;

        var files = (Dictionary<string, string>)draft.TextFiles;
        files[CurrentDataset.QueryFile] = args.Value?.ToString() ?? "";
    }

    private static void SetDefaults(DynReportParameter parameter, string? value)
    {
        parameter.DefaultValues = string.IsNullOrWhiteSpace(value)
            ? []
            : value.Split(
                ';',
                StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .ToList();
    }

    private async Task SaveAsync()
    {
        if (draft is null || user is null)
            return;

        saving = true;
        success = false;
        message = "";

        try
        {
            draft.Manifest.Version = BumpPatch(draft.Manifest.Version);
            draft.Manifest.ModifiedUtc = DateTime.UtcNow;
            draft.Manifest.FolderPath = ParentPath(draft.Manifest.Path);

            draft = await Packages.SaveDesignerPackageAsync(
                draft,
                user.Identity?.Name ?? "unknown");

            await ReloadRevisionsAsync();
            success = true;
            message = $"Gespeichert als v{draft.Manifest.Version}. Vorherige Version wurde als Revision gesichert.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            saving = false;
        }
    }

    private async Task ReloadRevisionsAsync()
    {
        revisions = Packages.Revisions(ReportId);
        metadataRevisions = [];
        revisionWarning = "";

        if (!Metadata.IsConfigured)
            return;

        try
        {
            metadataRevisions = await Metadata.ListRevisionsAsync(ReportId);
        }
        catch (Exception ex)
        {
            revisionWarning =
                "SQL-Revisionskatalog ist derzeit nicht erreichbar: " + ex.Message;
        }
    }

    private async Task RestoreRevisionAsync(DynReportStoredRevision revision)
    {
        if (user is null || !canPublish || revision.IsActive)
            return;

        restoringRevision = revision.RevisionId;
        pendingRestoreRevision = null;
        success = false;
        message = "";

        try
        {
            var restored = await Packages.RestoreRevisionAsync(
                ReportId,
                revision.RevisionId,
                user.Identity?.Name ?? "unknown");

            draft = Clone(restored);
            activeDataset = draft.Document.Datasets.FirstOrDefault()?.Id ?? "";
            activePageId = draft.Document.Pages.FirstOrDefault()?.Id ?? "";
            selectedComponentId = null;
            await ReloadRevisionsAsync();

            success = true;
            message =
                $"Revision v{restored.Manifest.Version} wurde wiederhergestellt und als aktive Revision gesetzt.";
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            restoringRevision = null;
        }
    }

    private void SelectPage(string pageId)
    {
        activePageId = pageId;
        selectedComponentId = null;
    }

    private void SelectComponent(string componentId)
    {
        selectedComponentId = componentId;
    }

    private void AddPage()
    {
        if (draft is null)
            return;

        var number = draft.Document.Pages.Count + 1;
        var id = UniquePageId($"page-{number}");

        draft.Document.Pages.Add(new DynReportPage
        {
            Id = id,
            Title = $"Seite {number}",
            Columns = 12
        });

        activePageId = id;
        selectedComponentId = null;
    }

    private void RemoveCurrentPage()
    {
        if (draft is null || CurrentPage is null || draft.Document.Pages.Count <= 1)
            return;

        var index = draft.Document.Pages.IndexOf(CurrentPage);
        draft.Document.Pages.Remove(CurrentPage);

        var next = draft.Document.Pages[Math.Clamp(index - 1, 0, draft.Document.Pages.Count - 1)];
        activePageId = next.Id;
        selectedComponentId = null;
    }

    private void AddComponent(string type)
    {
        if (draft is null || CurrentPage is null)
            return;

        var dataset = draft.Document.Datasets.FirstOrDefault();
        var firstField = dataset?.Fields.FirstOrDefault() ?? "";
        var id = UniqueComponentId(type.Replace("-strip", "").Replace("grouped-", ""));

        var component = new DynVisual
        {
            Id = id,
            Type = type,
            Title = ComponentDisplayName(type),
            Dataset = ComponentUsesDataset(type) ? dataset?.Id ?? "" : "",
            Span = type.Equals("heading", StringComparison.OrdinalIgnoreCase)
                || type.Equals("text", StringComparison.OrdinalIgnoreCase)
                    ? CurrentPage.Columns
                    : Math.Min(CurrentPage.Columns, 12),
            MobileSpan = 12
        };

        if (type.Equals("metric-strip", StringComparison.OrdinalIgnoreCase))
        {
            component.Metrics.Add(new DynMetricItem
            {
                Id = "kpi-1",
                Label = "Zeilen",
                Value = new DynExpr { Op = "count" }
            });
        }

        if (type.Equals("table", StringComparison.OrdinalIgnoreCase))
        {
            component.Table = new DynTableDefinition
            {
                Columns = dataset?.Fields
                    .Select(field => new DynTableColumn { Field = field, Header = field })
                    .ToList()
                    ?? []
            };
        }

        if (type.Equals("chart", StringComparison.OrdinalIgnoreCase))
        {
            component.Chart = new DynChartDefinition
            {
                ChartType = "Auto",
                CategoryField = firstField
            };
        }

        if (type.Equals("grouped-board", StringComparison.OrdinalIgnoreCase))
        {
            component.Board = new DynGroupedBoard();

            if (!string.IsNullOrWhiteSpace(firstField))
            {
                component.Board.RowGroupBy.Add(firstField);
                component.Board.Columns.Add(new DynBoardColumn
                {
                    Id = SafeId(firstField),
                    Header = firstField,
                    Kind = "text",
                    Value = new DynExpr
                    {
                        Op = "field",
                        Field = firstField
                    }
                });
            }
            else
            {
                component.Board.Columns.Add(new DynBoardColumn
                {
                    Id = "value",
                    Header = "Wert",
                    Kind = "text",
                    Value = new DynExpr()
                });
            }
        }

        CurrentPage.Components.Add(component);
        selectedComponentId = component.Id;
    }

    private void DuplicateSelected()
    {
        if (CurrentPage is null || SelectedComponent is null)
            return;

        var options = new JsonSerializerOptions
        {
            PropertyNameCaseInsensitive = true,
            WriteIndented = true
        };

        var copy = JsonSerializer.Deserialize<DynVisual>(
            JsonSerializer.Serialize(SelectedComponent, options),
            options)!;

        copy.Id = UniqueComponentId(SelectedComponent.Type.Replace("-strip", "").Replace("grouped-", ""));

        var index = CurrentPage.Components.IndexOf(SelectedComponent);
        CurrentPage.Components.Insert(index + 1, copy);
        selectedComponentId = copy.Id;
    }

    private void RemoveSelected()
    {
        if (CurrentPage is null || SelectedComponent is null)
            return;

        var index = CurrentPage.Components.IndexOf(SelectedComponent);
        CurrentPage.Components.Remove(SelectedComponent);

        if (CurrentPage.Components.Count == 0)
        {
            selectedComponentId = null;
            return;
        }

        var nextIndex = Math.Clamp(index, 0, CurrentPage.Components.Count - 1);
        selectedComponentId = CurrentPage.Components[nextIndex].Id;
    }

    private void MoveSelected(int offset)
    {
        if (CurrentPage is null || SelectedComponent is null || offset == 0)
            return;

        var currentIndex = CurrentPage.Components.IndexOf(SelectedComponent);
        var targetIndex = currentIndex + offset;

        if (targetIndex < 0 || targetIndex >= CurrentPage.Components.Count)
            return;

        CurrentPage.Components.RemoveAt(currentIndex);
        CurrentPage.Components.Insert(targetIndex, SelectedComponent);
    }

