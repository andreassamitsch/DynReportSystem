    private (bool Compatible, string Message) ServerQueryStatus(DynVisual visual)
    {
        if (draft is null)
            return (false, "Bericht ist noch nicht geladen.");

        var dataSet = draft.Document.Datasets.FirstOrDefault(x =>
            x.Id.Equals(visual.Dataset, StringComparison.OrdinalIgnoreCase));

        if (dataSet is null)
            return (false, "Bitte zuerst ein Dataset auswählen.");

        if (!draft.TextFiles.TryGetValue(dataSet.QueryFile, out var sql)
            || string.IsNullOrWhiteSpace(sql))
        {
            return (false, $"SQL-Datei '{dataSet.QueryFile}' fehlt oder ist leer.");
        }

        if (!DynReportInteractiveQueryRules.TryNormalizeComposableSelect(
                dataSet,
                sql,
                out _,
                out var compatibilityError))
        {
            return (false, compatibilityError);
        }

        var automaticServer = DynReportInteractiveQueryRules.ShouldUseServerMode(
            draft,
            visual);

        if (string.Equals(visual.Table?.DataMode, "Auto", StringComparison.OrdinalIgnoreCase))
        {
            return automaticServer
                ? (true, "Auto wählt für diese Tabelle den serverseitigen Query-Pfad.")
                : (true, "SQL ist serverfähig; Auto hält Detailzeilen lokal, solange dasselbe Dataset auch von Nicht-Tabellen-Komponenten verwendet wird.");
        }

        return (true, "Die Dataset-Abfrage ist für serverseitiges Filtern, Sortieren, Gruppieren und Pivot geeignet.");
    }

    private IEnumerable<string> FieldsFor(string datasetId)
    {
        if (draft is null || string.IsNullOrWhiteSpace(datasetId))
            return [];

        return draft.Document.Datasets
            .FirstOrDefault(x => x.Id.Equals(datasetId, StringComparison.OrdinalIgnoreCase))
            ?.Fields
            ?? [];
    }

