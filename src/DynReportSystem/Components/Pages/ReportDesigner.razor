    private string UniquePageId(string seed)
    {
        if (draft is null)
            return seed;

        var existing = draft.Document.Pages
            .Select(x => x.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return UniqueId(seed, existing);
    }

    private string UniqueComponentId(string seed)
    {
        if (draft is null)
            return seed;

        var existing = draft.Document.Pages
            .SelectMany(x => x.Components)
            .Select(x => x.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return UniqueId(SafeId(seed), existing);
    }

    private static string UniqueMetricId(DynVisual component, string seed)
    {
        var existing = component.Metrics
            .Select(x => x.Id)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);

        return UniqueId(SafeId(seed), existing);
    }

    private static string UniqueId(string seed, HashSet<string> existing)
    {
        var normalized = string.IsNullOrWhiteSpace(seed) ? "item" : seed;

        if (!existing.Contains(normalized))
            return normalized;

        for (var i = 2; i < 10000; i++)
        {
            var candidate = $"{normalized}-{i}";
            if (!existing.Contains(candidate))
                return candidate;
        }

        return $"{normalized}-{Guid.NewGuid():N}";
    }

    private static string SafeId(string value)
    {
        if (string.IsNullOrWhiteSpace(value))
            return "item";

        var chars = value.Trim().ToLowerInvariant()
            .Select(ch => char.IsLetterOrDigit(ch) ? ch : '-')
            .ToArray();

        var id = new string(chars)
            .Replace("--", "-", StringComparison.Ordinal)
            .Trim('-');

        return string.IsNullOrWhiteSpace(id) ? "item" : id;
    }

