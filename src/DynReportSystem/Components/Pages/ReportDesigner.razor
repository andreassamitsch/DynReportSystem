    private void SetTablePresentationMode(DynTableDefinition table, string? value)
    {
        table.PresentationMode = value is "Grouped" or "Pivot"
            ? value
            : "Rows";

        if (!table.PresentationMode.Equals("Rows", StringComparison.OrdinalIgnoreCase)
            && string.Equals(table.DataMode, "Client", StringComparison.OrdinalIgnoreCase))
        {
            table.DataMode = "Auto";
        }

        if (table.PresentationMode.Equals("Pivot", StringComparison.OrdinalIgnoreCase))
            table.Pivot ??= new DynTablePivotDefinition();
    }

    private void AddTableAggregate(bool pivotMeasure)
    {
        if (SelectedComponent?.Table is null)
            return;

        var fields = FieldsFor(SelectedComponent.Dataset).ToArray();
        var target = pivotMeasure
            ? (SelectedComponent.Table.Pivot ??= new DynTablePivotDefinition()).Measures
            : SelectedComponent.Table.Aggregates;
        var fieldName = fields.FirstOrDefault() ?? "";

        target.Add(new DynTableAggregate
        {
            Field = fieldName,
            Function = "Sum",
            Label = fieldName,
            Alias = fieldName
        });
    }

    private void RemoveTableAggregate(
        DynTableAggregate aggregate,
        bool pivotMeasure)
    {
        if (SelectedComponent?.Table is null)
            return;

        if (pivotMeasure)
            SelectedComponent.Table.Pivot?.Measures.Remove(aggregate);
        else
            SelectedComponent.Table.Aggregates.Remove(aggregate);
    }

    private void AddTableColumn()
    {
        if (SelectedComponent?.Table is null)
            return;

        var fields = FieldsFor(SelectedComponent.Dataset).ToArray();
        var used = SelectedComponent.Table.Columns
            .Select(x => x.Field)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        var fieldName = fields.FirstOrDefault(x => !used.Contains(x))
            ?? fields.FirstOrDefault()
            ?? "";

        SelectedComponent.Table.Columns.Add(new DynTableColumn
        {
            Field = fieldName,
            Header = fieldName,
            DataType = "Auto",
            Filterable = true,
            Sortable = true
        });
