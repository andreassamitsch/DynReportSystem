@page "/reports/import"
@attribute [Authorize]
@inject DynReportPackageStore Packages
@inject FolderAccess Access
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>DynReport-Paket importieren</PageTitle>

<div class="shell">
    <header class="topbar">
        <div class="brand-mark">D</div>
        <div class="brand-text">
            <strong>DynReport-Paket importieren</strong>
            <span>selbstständige Berichtsdateien · Schema 2.0</span>
        </div>
        <div class="topbar-tag"><span class="live-dot"></span> APP-01</div>
    </header>

    <main class="main-area report-import-page">
        <div class="heading-line">
            <div>
                <p class="eyebrow">DYNREPORT 2.0</p>
                <h1>Berichtsdatei installieren</h1>
                <p class="subtitle">
                    Eine <code>.dynreport</code>-Datei enthält Datenlogik, Parameter,
                    Berechnungen und Layout vollständig. RDL/RSD/RDS werden für einen
                    konvertierten Bericht nicht mehr benötigt.
                </p>
            </div>
            <a class="ghost-btn" href="/">← Reporting</a>
        </div>

        <section class="panel import-card">
            <div class="import-drop">
                <div class="import-icon">⇧</div>
                <div>
                    <strong>.dynreport auswählen</strong>
                    <p>
                        ZIP-basiertes DynReport-Paket · maximal 25 MB ·
                        manifest.json + report.json + Dataset-SQL werden geprüft.
                    </p>
                </div>

                <div class="import-file-picker">
                    <InputFile OnChange="SelectFile"
                               accept=".dynreport,application/zip"
                               disabled="@busy"
                               class="import-native-file" />

                    @if (selectedFile is not null)
                    {
                        <div class="selected-import-file">
                            <span class="selected-file-icon">✓</span>
                            <div>
                                <strong>@selectedFile.Name</strong>
                                <small>@FormatFileSize(selectedFile.Size)</small>
                            </div>
                        </div>
                    }
                </div>
            </div>

            <div class="import-actions">
                <div class="import-action-hint">
                    @if (selectedFile is null)
                    {
                        <span>Zuerst eine <code>.dynreport</code>-Datei auswählen.</span>
                    }
                    else
                    {
                        <span>Datei ausgewählt. Neue Berichte dürfen in vorhandenen Ordnern mit Publish/Manage-Recht angelegt werden.</span>
                    }
                </div>

                <button class="primary-btn import-submit"
                        disabled="@(busy || selectedFile is null)"
                        @onclick="ImportSelectedAsync">
                    @(busy ? "Wird importiert …" : "Paket importieren")
                </button>
            </div>

            @if (busy)
            {
                <div class="loading-strip"><span></span></div>
            }

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="notice @(success ? "info" : "error")">@message</div>
            }

            @if (imported is not null)
            {
                <div class="import-result">
                    <div>
                        <span class="eyebrow">INSTALLIERT · RDL-UNABHÄNGIG</span>
                        <strong>@imported.Manifest.Title</strong>
                        <small>@imported.Manifest.Path · v@imported.Manifest.Version</small>
                    </div>
                    <button class="primary-btn" @onclick="OpenImported">Bericht öffnen →</button>
                </div>
            }
        </section>

        <section class="dashboard-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">PAKETE</p>
                    <h2>Selbstständige DynReport-Berichte</h2>
                </div>
                <span class="section-note">@Installed.Count aktiv</span>
            </div>

            @if (Installed.Count == 0)
            {
                <div class="panel empty">
                    Noch kein DynReport-2.0-Paket installiert.
                </div>
            }
            else
            {
                <div class="custom-report-list">
                    @foreach (var item in Installed)
                    {
                        <article class="panel custom-report-item">
                            <div>
                                <span class="custom-report-renderer">DYNREPORT 2.0 · v@item.Manifest.Version</span>
                                <strong>@item.Manifest.Title</strong>
                                <small>@item.Manifest.Path</small>
                                <small>
                                    @item.Document.Datasets.Count Dataset(s) ·
                                    @item.Document.Parameters.Count Parameter ·
                                    geändert @item.Manifest.ModifiedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </small>
                            </div>

                            <div class="custom-report-actions">
                                <a class="ghost-btn"
                                   href="@($"/reports/package/{item.Manifest.ReportId}")">
                                    Öffnen
                                </a>

                                @if (CanDesign(item.Manifest.ReportId))
                                {
                                    <a class="ghost-btn"
                                       href="@($"/designer/{item.Manifest.ReportId}")">
                                        Designer
                                    </a>
                                }

                                @if (CanPublish(item.Manifest.ReportId))
                                {
                                    <button class="ghost-btn danger"
                                            @onclick="() => Remove(item.Manifest.ReportId)">
                                        Paket entfernen
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <footer>
            DynReport System 0.19.0 · Paketimporte werden versioniert ·
            Zugangsdaten bleiben zentral auf dem Server
        </footer>
    </main>
</div>

@code {
    private ClaimsPrincipal? user;
    private bool busy;
    private bool success;
    private string message = "";
    private IBrowserFile? selectedFile;
    private LoadedDynReportPackage? imported;

    private IReadOnlyList<LoadedDynReportPackage> Installed => Packages.List();

    protected override async Task OnInitializedAsync()
    {
        user = (await Authentication.GetAuthenticationStateAsync()).User;
    }

    private bool CanPublish(string reportId) =>
        user is not null
        && (Access.Can(user, reportId, "Publish")
            || Access.Can(user, reportId, "Manage"));

    private bool CanDesign(string reportId) =>
        user is not null
        && (Access.Can(user, reportId, "EditLayout")
            || Access.Can(user, reportId, "Edit")
            || CanPublish(reportId));

    private void SelectFile(InputFileChangeEventArgs e)
    {
        success = false;
        imported = null;
        message = "";

        var file = e.File;

        if (!file.Name.EndsWith(".dynreport", StringComparison.OrdinalIgnoreCase))
        {
            selectedFile = null;
            message = "Bitte eine .dynreport-Datei auswählen.";
            return;
        }

        if (file.Size > 25 * 1024 * 1024)
        {
            selectedFile = null;
            message = "Die ausgewählte Datei ist größer als 25 MB.";
            return;
        }

        selectedFile = file;
        success = true;
        message = $"'{file.Name}' wurde ausgewählt. Mit „Paket importieren“ wird die Datei geprüft und installiert.";
    }

    private async Task ImportSelectedAsync()
    {
        if (selectedFile is null || busy)
            return;

        busy = true;
        success = false;
        message = "";
        imported = null;

        try
        {
            await using var source = selectedFile.OpenReadStream(25 * 1024 * 1024);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);

            memory.Position = 0;
            var preview = Packages.Validate(memory);

            var existing = Access.Catalog.Reports.Any(x =>
                x.Id.Equals(preview.Manifest.ReportId, StringComparison.OrdinalIgnoreCase));

            var targetFolderPath = string.IsNullOrWhiteSpace(preview.Manifest.FolderPath)
                ? ParentPath(preview.Manifest.Path)
                : preview.Manifest.FolderPath;

            if (existing)
            {
                if (!CanPublish(preview.Manifest.ReportId))
                {
                    throw new UnauthorizedAccessException(
                        "Für den Zielbericht ist Publish oder Manage erforderlich.");
                }

                if (preview.Manifest.Grants.Count > 0
                    && (user is null || !Access.Can(user, preview.Manifest.ReportId, "Manage")))
                {
                    throw new UnauthorizedAccessException(
                        "Das Paket enthält eigene Berechtigungen. Dafür ist Manage auf dem Zielbericht erforderlich.");
                }
            }
            else
            {
                if (user is null || !Access.CanPublishToFolderPath(user, targetFolderPath))
                {
                    var resolved = Access.ResolveFolderPath(targetFolderPath);
                    throw new UnauthorizedAccessException(
                        resolved is null
                            ? $"Der Zielordner '{targetFolderPath}' existiert nicht im Reporting-Portal."
                            : $"Für den Zielordner '{targetFolderPath}' ist Publish oder Manage erforderlich.");
                }

                if (preview.Manifest.Grants.Count > 0)
                {
                    var folderId = Access.ResolveFolderPath(targetFolderPath);
                    if (folderId is null || !Access.CanFolder(user, folderId, "Manage"))
                    {
                        throw new UnauthorizedAccessException(
                            "Neue Pakete mit eigenen Berechtigungen dürfen nur von einem Ordner-Manager importiert werden.");
                    }
                }
            }

            memory.Position = 0;
            imported = await Packages.ImportAsync(
                memory,
                user?.Identity?.Name);

            success = true;
            message = existing
                ? $"'{imported.Manifest.Title}' v{imported.Manifest.Version} wurde aktualisiert. " +
                  "Die vorherige Version wurde als Revision gesichert."
                : $"'{imported.Manifest.Title}' v{imported.Manifest.Version} wurde als neuer Bericht installiert.";

            selectedFile = null;
        }
        catch (Exception ex)
        {
            success = false;
            message = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private static string ParentPath(string path)
    {
        var normalized = (path ?? "")
            .Replace('\\', '/')
            .TrimEnd('/');

        var index = normalized.LastIndexOf('/');
        return index <= 0 ? "/" : normalized[..index];
    }

    private static string FormatFileSize(long bytes)
    {
        if (bytes >= 1024 * 1024)
            return $"{bytes / 1024d / 1024d:N1} MB";

        if (bytes >= 1024)
            return $"{bytes / 1024d:N0} KB";

        return $"{bytes:N0} Byte";
    }

    private void OpenImported()
    {
        if (imported is null)
            return;

        Navigation.NavigateTo($"/reports/package/{imported.Manifest.ReportId}");
    }

    private void Remove(string reportId)
    {
        if (!CanPublish(reportId))
        {
            success = false;
            message = "Publish/Manage-Berechtigung zum Entfernen fehlt.";
            return;
        }

        Packages.Remove(reportId);
        imported = null;
        success = true;
        message =
            "Das selbstständige DynReport-Paket wurde entfernt. " +
            "Falls noch ein migrierter SSRS-Bericht existiert, wird dieser wieder verwendet.";
    }
}
