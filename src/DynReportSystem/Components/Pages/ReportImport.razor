@page "/reports/import"
@attribute [Authorize]
@inject CustomReportStore CustomReports
@inject FolderAccess Access
@inject AuthenticationStateProvider Authentication
@inject NavigationManager Navigation

<PageTitle>Berichtsdatei importieren · DynReport</PageTitle>

<div class="shell">
    <header class="topbar">
        <div class="brand-mark">D</div>
        <div class="brand-text">
            <strong>Berichtsdatei importieren</strong>
            <span>DynReport · manuell optimierte Berichte</span>
        </div>
        <div class="topbar-tag"><span class="live-dot"></span> APP-01</div>
    </header>

    <main class="main-area report-import-page">
        <div class="heading-line">
            <div>
                <p class="eyebrow">DYNREPORT IMPORT</p>
                <h1>Optimierten Bericht installieren</h1>
                <p class="subtitle">
                    Eine <code>.dynreport</code>-Datei ersetzt nur die Darstellung des Zielberichts.
                    SQL, Parameter, Datenquellen und Berechtigungen bleiben aus dem migrierten SSRS-Bericht erhalten.
                </p>
            </div>
            <a class="ghost-btn" href="/">← Reporting</a>
        </div>

        <section class="panel import-card">
            <div class="import-drop">
                <div class="import-icon">⇧</div>
                <div>
                    <strong>.dynreport auswählen</strong>
                    <p>Maximal 2 MB · JSON-basiert · Zielbericht und Renderer werden vor dem Speichern geprüft.</p>
                </div>

                <InputFile OnChange="ImportAsync"
                           accept=".dynreport,application/json"
                           disabled="@busy" />
            </div>

            @if (busy)
            {
                <div class="loading-strip"><span></span></div>
            }

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="notice @(success ? "info" : "error")">@message</div>
            }

            @if (imported is not null)
            {
                <div class="import-result">
                    <div>
                        <span class="eyebrow">INSTALLIERT</span>
                        <strong>@imported.Title</strong>
                        <small>@imported.TargetPath</small>
                    </div>
                    <button class="primary-btn" @onclick="OpenImported">Bericht öffnen →</button>
                </div>
            }
        </section>

        <section class="dashboard-section">
            <div class="section-heading">
                <div>
                    <p class="eyebrow">INSTALLIERTE DATEIEN</p>
                    <h2>Manuell optimierte Berichte</h2>
                </div>
                <span class="section-note">@Installed.Count aktiv</span>
            </div>

            @if (Installed.Count == 0)
            {
                <div class="panel empty">
                    Noch keine manuell optimierte Berichtsdatei installiert.
                </div>
            }
            else
            {
                <div class="custom-report-list">
                    @foreach (var item in Installed)
                    {
                        <article class="panel custom-report-item">
                            <div>
                                <span class="custom-report-renderer">@item.Renderer</span>
                                <strong>@item.Title</strong>
                                <small>@item.TargetPath</small>
                                <small>Geändert @item.ModifiedUtc.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                            </div>
                            <div class="custom-report-actions">
                                <a class="ghost-btn" href="@($"/reports/dynamic/{item.TargetReportId}")">Öffnen</a>
                                @if (CanManage(item.TargetReportId))
                                {
                                    <button class="ghost-btn danger" @onclick="() => Remove(item.TargetReportId)">
                                        Optimierung entfernen
                                    </button>
                                }
                            </div>
                        </article>
                    }
                </div>
            }
        </section>

        <footer>DynReport System · Importierte Optimierungen bleiben bei Systemupdates erhalten</footer>
    </main>
</div>

@code {
    private ClaimsPrincipal? user;
    private bool busy;
    private bool success;
    private string message = "";
    private CustomReportDefinition? imported;

    private IReadOnlyList<InstalledCustomReport> Installed => CustomReports.List();

    protected override async Task OnInitializedAsync()
    {
        user = (await Authentication.GetAuthenticationStateAsync()).User;
    }

    private bool CanManage(string reportId) =>
        user is not null
        && (Access.Can(user, reportId, "Manage")
            || Access.Can(user, reportId, "Publish")
            || Access.Can(user, reportId, "Edit"));

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        busy = true;
        success = false;
        message = "";
        imported = null;

        try
        {
            var file = e.File;
            if (!file.Name.EndsWith(".dynreport", StringComparison.OrdinalIgnoreCase)
                && !file.Name.EndsWith(".json", StringComparison.OrdinalIgnoreCase))
            {
                throw new InvalidDataException("Bitte eine .dynreport-Datei auswählen.");
            }

            await using var source = file.OpenReadStream(2 * 1024 * 1024);
            using var memory = new MemoryStream();
            await source.CopyToAsync(memory);

            var preview = CustomReports.ParseAndValidate(memory.ToArray());

            if (!CanManage(preview.TargetReportId))
            {
                throw new UnauthorizedAccessException(
                    "Für den Zielbericht fehlt die Berechtigung Edit/Publish/Manage.");
            }

            memory.Position = 0;
            imported = await CustomReports.ImportAsync(memory);
            success = true;
            message = $"'{imported.Title}' wurde für {imported.TargetPath} installiert.";
        }
        catch (Exception ex)
        {
            success = false;
            message = ex.Message;
        }
        finally
        {
            busy = false;
        }
    }

    private void OpenImported()
    {
        if (imported is null)
            return;

        Navigation.NavigateTo($"/reports/dynamic/{imported.TargetReportId}");
    }

    private void Remove(string reportId)
    {
        if (!CanManage(reportId))
        {
            message = "Berechtigung zum Entfernen fehlt.";
            success = false;
            return;
        }

        CustomReports.Remove(reportId);
        imported = null;
        success = true;
        message = "Optimierte Darstellung entfernt. Der Bericht verwendet wieder die generische RDL-Ansicht.";
    }
}
