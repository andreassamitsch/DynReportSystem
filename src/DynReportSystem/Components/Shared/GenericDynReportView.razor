@implements IAsyncDisposable
@inject IJSRuntime JS
@inject DynExpressionEngine Expressions
@inject DynamicVisualizationService Visuals

@if (Package.Document.Pages.Count == 0)
{
    <div class="panel empty">Der Bericht enthält keine Seite.</div>
}
else
{
    @if (Package.Document.Pages.Count > 1)
    {
        <nav class="dyn2-page-tabs" aria-label="Berichtsseiten">
            @foreach (var reportPage in Package.Document.Pages)
            {
                <button class="@(reportPage.Id.Equals(activePageId, StringComparison.OrdinalIgnoreCase) ? "active" : "")"
                        @onclick="() => NavigatePage(reportPage.Id)">
                    @reportPage.Title
                </button>
            }
        </nav>
    }

    var activePage = Package.Document.Pages.FirstOrDefault(page =>
        page.Id.Equals(activePageId, StringComparison.OrdinalIgnoreCase))
        ?? Package.Document.Pages[0];

    <section class="dyn2-page" style="@($"--dyn-columns:{Math.Clamp(activePage.Columns, 1, 24)}")">
        @if (!string.IsNullOrWhiteSpace(activePage.Title))
        {
            <div class="dyn2-page-title">
                <h2>@activePage.Title</h2>
            </div>
        }

        <div class="dyn2-layout-grid">
            @foreach (var visual in activePage.Components)
            {
                @RenderVisual(visual)
            }
        </div>
    </section>
}

@code {
    [Parameter, EditorRequired] public LoadedDynReportPackage Package { get; set; } = null!;
    [Parameter, EditorRequired] public DynReportRun Run { get; set; } = null!;
    [Parameter] public IReadOnlyDictionary<string, DynReportParameterValue>? ParameterValues { get; set; }
    [Parameter] public string InitialPageId { get; set; } = "";
    [Parameter] public EventCallback<string> OnPageChanged { get; set; }
    [Parameter] public EventCallback<DynReportInteractionEvent> OnInteraction { get; set; }

    private string activePageId = "";
    private DotNetObjectReference<GenericDynReportView>? historyRef;
    private bool historyRegistered;
    private readonly HashSet<string> expandedBoardRows = new(StringComparer.Ordinal);
    private string HistoryKey => $"dynreport:{Package.Manifest.ReportId}";

    protected override void OnParametersSet()
    {
        if (Package.Document.Pages.Count == 0)
        {
            activePageId = "";
            return;
        }

        var requested = string.IsNullOrWhiteSpace(InitialPageId)
            ? activePageId
            : InitialPageId;

        if (string.IsNullOrWhiteSpace(requested)
            || !Package.Document.Pages.Any(page =>
                page.Id.Equals(requested, StringComparison.OrdinalIgnoreCase)))
        {
            activePageId = Package.Document.Pages[0].Id;
        }
        else
        {
            activePageId = requested;
        }
    }

    private RenderFragment RenderVisual(DynVisual visual) => builder =>
    {
        var sequence = 0;
        var style = $"--dyn-span:{Math.Clamp(visual.Span, 1, 24)};--dyn-mobile-span:{Math.Clamp(visual.MobileSpan, 1, 24)}";

        builder.OpenElement(sequence++, "section");
        var typeClass = $"dyn2-{visual.Type.ToLowerInvariant()}-visual";
        var linkClass = !string.IsNullOrWhiteSpace(visual.TargetPageId) ? " dyn2-link-visual" : "";
        builder.AddAttribute(
            sequence++,
            "class",
            $"dyn2-visual {typeClass} {visual.CssClass}{linkClass}".Trim());
        builder.AddAttribute(sequence++, "style", style);

        if (!string.IsNullOrWhiteSpace(visual.TargetPageId)
            && !visual.Type.Equals("table", StringComparison.OrdinalIgnoreCase)
            && !visual.Type.Equals("chart", StringComparison.OrdinalIgnoreCase))
        {
            builder.AddAttribute(
                sequence++,
                "onclick",
                EventCallback.Factory.Create(
                    this,
                    () => NavigatePage(visual.TargetPageId)));
        }

        if (visual.Type.Equals("heading", StringComparison.OrdinalIgnoreCase)
            || visual.Type.Equals("text", StringComparison.OrdinalIgnoreCase))
        {
            builder.OpenElement(sequence++, "div");
            builder.AddAttribute(sequence++, "class", "dyn2-heading-block");

            if (!string.IsNullOrWhiteSpace(visual.Title))
            {
                builder.OpenElement(sequence++, visual.Type.Equals("heading", StringComparison.OrdinalIgnoreCase) ? "h2" : "strong");
                builder.AddContent(sequence++, visual.Title);
                builder.CloseElement();
            }

            if (visual.Value is not null)
            {
                var rows = Rows(visual.Dataset);
                var value = Expressions.Evaluate(visual.Value, Package.Document, rows, ParameterValues);
                builder.OpenElement(sequence++, "span");
                builder.AddContent(sequence++, Expressions.FormatValue(value, visual.Format, visual.Unit));
                builder.CloseElement();
            }

            if (!string.IsNullOrWhiteSpace(visual.Subtitle))
            {
                builder.OpenElement(sequence++, "p");
                builder.AddContent(sequence++, visual.Subtitle);
                builder.CloseElement();
            }

            builder.CloseElement();
            builder.CloseElement();
            return;
        }

        if (visual.Type.Equals("metric-strip", StringComparison.OrdinalIgnoreCase))
        {
            builder.AddContent(sequence++, MetricStrip(visual));
            builder.CloseElement();
            return;
        }

        if (visual.Type.Equals("grouped-board", StringComparison.OrdinalIgnoreCase)
            && visual.Board is not null)
        {
            builder.AddContent(sequence++, VisualHead(visual));
            builder.AddContent(sequence++, GroupedBoard(visual));
            builder.CloseElement();
            return;
        }

        if (visual.Type.Equals("table", StringComparison.OrdinalIgnoreCase))
        {
            builder.AddContent(sequence++, VisualHead(visual));

            if (DynReportInteractiveQueryRules.ShouldUseServerMode(Package, visual))
            {
                builder.OpenComponent<ServerDynamicResultTable>(sequence++);
                builder.AddAttribute(sequence++, "Package", Package);
                builder.AddAttribute(sequence++, "Visual", visual);
                builder.AddAttribute(sequence++, "ParameterValues", ParameterValues);
                builder.AddAttribute(sequence++, "ExportName", Package.Manifest.Title);
                builder.AddAttribute(sequence++, "OnInteraction", OnInteraction);
                builder.CloseComponent();
            }
            else if (Run.Results.TryGetValue(visual.Dataset, out var table))
            {
                builder.OpenComponent<DynamicResultTable>(sequence++);
                builder.AddAttribute(sequence++, "Result", table);
                builder.AddAttribute(sequence++, "ExportName", Package.Manifest.Title);
                builder.AddAttribute(sequence++, "Definition", visual.Table);
                builder.AddAttribute(sequence++, "OnInteraction", OnInteraction);
                builder.CloseComponent();
            }

            builder.CloseElement();
            return;
        }

        if (visual.Type.Equals("chart", StringComparison.OrdinalIgnoreCase))
        {
            builder.AddContent(sequence++, VisualHead(visual));

            if (!Run.Results.TryGetValue(visual.Dataset, out var chartResult))
            {
                builder.AddContent(sequence++, DatasetUnavailable(visual.Dataset));
                builder.CloseElement();
                return;
            }

            var chart = Visuals.Build(chartResult, visual.Chart);
            if (chart is not null)
            {
                builder.OpenComponent<EChart>(sequence++);
                builder.AddAttribute(sequence++, "ChartKey", $"pkg-{Package.Manifest.ReportId}-{visual.Id}");
                builder.AddAttribute(sequence++, "Options", chart.Options);
                builder.AddAttribute(
                    sequence++,
                    "Height",
                    $"{Math.Clamp(visual.Chart?.Height ?? 360, 180, 1200)}px");
                builder.AddAttribute(
                    sequence++,
                    "OnPointClick",
                    EventCallback.Factory.Create<ChartPointEvent>(
                        this,
                        point => HandleChartPointAsync(visual, point)));
                builder.CloseComponent();
            }
            else
            {
                builder.OpenElement(sequence++, "div");
                builder.AddAttribute(sequence++, "class", "notice warn");
                builder.AddContent(sequence++, $"Dataset '{visual.Dataset}' enthält keine darstellbaren Diagrammdaten.");
                builder.CloseElement();
            }

            builder.CloseElement();
            return;
        }

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "notice warn");
        builder.AddContent(sequence++, $"Visual '{visual.Type}' wird nicht dargestellt.");
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment DatasetUnavailable(string dataset) => builder =>
    {
        var sequence = 0;
        var error = Run.Errors.FirstOrDefault(item =>
            item.StartsWith(dataset + ":", StringComparison.OrdinalIgnoreCase));
        var detail = string.IsNullOrWhiteSpace(error)
            ? $"Dataset '{dataset}' wurde nicht geladen."
            : error[(error.IndexOf(':') + 1)..].Trim();

        builder.OpenElement(sequence++, "div");
        builder.AddAttribute(sequence++, "class", "notice error");
        builder.OpenElement(sequence++, "strong");
        builder.AddContent(sequence++, $"Dataset '{dataset}' konnte nicht geladen werden.");
        builder.CloseElement();
        builder.OpenElement(sequence++, "div");
        builder.AddContent(sequence++, detail);
        builder.CloseElement();
        builder.CloseElement();
    };

    private RenderFragment MetricStrip(DynVisual visual) => builder =>
    {
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "dyn2-metric-strip");

        foreach (var metric in visual.Metrics)
        {
            var dataset = string.IsNullOrWhiteSpace(metric.Dataset)
                ? visual.Dataset
                : metric.Dataset;
            var rows = Rows(dataset);
            var available = string.IsNullOrWhiteSpace(dataset)
                || Run.Results.ContainsKey(dataset);
            var value = available
                ? Expressions.Evaluate(metric.Value, Package.Document, rows, ParameterValues)
                : null;
            var tone = available ? Tone(metric.Rules, rows) : "unavailable";
            var target = string.IsNullOrWhiteSpace(metric.TargetPageId)
                ? ""
                : metric.TargetPageId;

            builder.OpenElement(seq++, "article");
            builder.AddAttribute(
                seq++,
                "class",
                $"dyn2-metric {tone}{(!string.IsNullOrWhiteSpace(target) ? " dyn2-metric-link" : "")}");

            if (!string.IsNullOrWhiteSpace(target))
            {
                builder.AddAttribute(
                    seq++,
                    "onclick",
                    EventCallback.Factory.Create(this, () => NavigatePage(target)));
                builder.AddAttribute(seq++, "role", "button");
                builder.AddAttribute(seq++, "tabindex", "0");
            }

            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, metric.Label);
            builder.CloseElement();

            builder.OpenElement(seq++, "strong");
            builder.AddContent(
                seq++,
                available
                    ? Expressions.FormatValue(value, metric.Format, metric.Unit)
                    : "–");
            builder.CloseElement();

            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private RenderFragment VisualHead(DynVisual visual) => builder =>
    {
        if (string.IsNullOrWhiteSpace(visual.Title)
            && string.IsNullOrWhiteSpace(visual.Subtitle))
            return;

        var seq = 0;
        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "dyn2-visual-head");

        builder.OpenElement(seq++, "div");
        if (!string.IsNullOrWhiteSpace(visual.Title))
        {
            builder.OpenElement(seq++, "h3");
            builder.AddContent(seq++, visual.Title);
            builder.CloseElement();
        }

        if (!string.IsNullOrWhiteSpace(visual.Subtitle))
        {
            builder.OpenElement(seq++, "p");
            builder.AddContent(seq++, visual.Subtitle);
            builder.CloseElement();
        }
        builder.CloseElement();

        if (!string.IsNullOrWhiteSpace(visual.TargetPageId))
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "dyn2-visual-jump");
            builder.AddAttribute(
                seq++,
                "onclick",
                EventCallback.Factory.Create(
                    this,
                    () => NavigatePage(visual.TargetPageId)));
            builder.AddContent(seq++, "Details →");
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private async Task NavigatePage(
        string? pageId,
        bool pushHistory = true,
        bool notify = true)
    {
        if (string.IsNullOrWhiteSpace(pageId))
            return;

        var target = Package.Document.Pages.FirstOrDefault(page =>
            page.Id.Equals(pageId, StringComparison.OrdinalIgnoreCase));

        if (target is null
            || target.Id.Equals(activePageId, StringComparison.OrdinalIgnoreCase))
            return;

        if (notify && OnPageChanged.HasDelegate)
            await OnPageChanged.InvokeAsync(target.Id);

        activePageId = target.Id;

        if (pushHistory && historyRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "DynReportCharts.pushReportPage",
                    HistoryKey,
                    activePageId);
            }
            catch (JSDisconnectedException) { }
        }

        StateHasChanged();
    }

    private async Task HandleChartPointAsync(
        DynVisual visual,
        ChartPointEvent point)
    {
        var interaction = visual.Chart?.Interaction;
        var targetPage = visual.TargetPageId;

        if (interaction is not null
            && !string.IsNullOrWhiteSpace(point.SeriesName)
            && interaction.SeriesTargetPages.TryGetValue(
                point.SeriesName,
                out var seriesTarget)
            && !string.IsNullOrWhiteSpace(seriesTarget))
        {
            targetPage = seriesTarget;
        }

        var parameterValues = new Dictionary<string, string>(
            StringComparer.OrdinalIgnoreCase);

        if (interaction is not null)
        {
            if (!string.IsNullOrWhiteSpace(interaction.CategoryParameter)
                && !string.IsNullOrWhiteSpace(point.Name))
            {
                parameterValues[interaction.CategoryParameter] = point.Name;
            }

            if (!string.IsNullOrWhiteSpace(interaction.SeriesParameter)
                && !string.IsNullOrWhiteSpace(point.SeriesName))
            {
                parameterValues[interaction.SeriesParameter] = point.SeriesName;
            }
        }

        if (parameterValues.Count > 0 && OnInteraction.HasDelegate)
        {
            await OnInteraction.InvokeAsync(
                new DynReportInteractionEvent(
                    targetPage ?? "",
                    parameterValues,
                    interaction?.RunReportAfterFilter ?? true));

            if (!string.IsNullOrWhiteSpace(targetPage))
                await NavigatePage(targetPage, notify: false);

            return;
        }

        if (!string.IsNullOrWhiteSpace(targetPage))
            await NavigatePage(targetPage);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender
            || historyRegistered
            || Package.Document.Pages.Count == 0)
            return;

        historyRef = DotNetObjectReference.Create(this);

        try
        {
            var requestedPage = await JS.InvokeAsync<string?>(
                "DynReportCharts.registerReportHistory",
                HistoryKey,
                activePageId,
                historyRef);

            historyRegistered = true;

            if (!string.IsNullOrWhiteSpace(requestedPage)
                && Package.Document.Pages.Any(page =>
                    page.Id.Equals(
                        requestedPage,
                        StringComparison.OrdinalIgnoreCase))
                && !activePageId.Equals(
                    requestedPage,
                    StringComparison.OrdinalIgnoreCase))
            {
                await NavigatePage(
                    requestedPage,
                    pushHistory: false);
                StateHasChanged();
            }
        }
        catch (JSDisconnectedException) { }
    }

    [JSInvokable]
    public async Task HandleReportHistory(string? pageId)
    {
        await NavigatePage(pageId, pushHistory: false);
    }

    public async ValueTask DisposeAsync()
    {
        if (historyRegistered)
        {
            try
            {
                await JS.InvokeVoidAsync(
                    "DynReportCharts.unregisterReportHistory",
                    HistoryKey);
            }
            catch (JSDisconnectedException) { }
        }

        historyRef?.Dispose();
    }

    private RenderFragment GroupedBoard(DynVisual visual) => builder =>
    {
        var board = visual.Board!;
        var compactBoard = HasCssClass(visual.CssClass, "dyn2-machine-board");
        var sourceRows = Rows(visual.Dataset);
        var sections = BuildGroups(sourceRows, board.SectionGroupBy);
        var seq = 0;

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", "dyn2-board-root");

        if (board.Legend.Count > 0)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "dyn2-legend");

            foreach (var item in board.Legend)
            {
                builder.OpenElement(seq++, "span");
                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "style", $"background:{item.Color}");
                builder.CloseElement();
                builder.AddContent(seq++, item.Label);
                builder.CloseElement();
            }

            builder.CloseElement();
        }

        foreach (var section in sections)
        {
            builder.OpenElement(seq++, "section");
            builder.AddAttribute(seq++, "class", "dyn2-board-section");

            if (board.SectionGroupBy.Count > 0)
            {
                builder.OpenElement(seq++, "div");
                builder.AddAttribute(seq++, "class", "dyn2-board-section-head");
                builder.OpenElement(seq++, "div");
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "eyebrow");
                builder.AddContent(seq++, "BEREICH");
                builder.CloseElement();
                builder.OpenElement(seq++, "h3");
                builder.AddContent(seq++, SectionTitle(section.Rows, board.SectionGroupBy));
                builder.CloseElement();
                builder.CloseElement();

                var rowCount = BuildGroups(section.Rows, board.RowGroupBy).Count;
                builder.OpenElement(seq++, "small");
                builder.AddContent(seq++, $"{rowCount} Einträge");
                builder.CloseElement();
                builder.CloseElement();
            }

            var template = string.Join(" ", board.Columns.Select(x =>
                string.IsNullOrWhiteSpace(x.Width) ? "1fr" : x.Width));

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "dyn2-board");
            builder.AddAttribute(seq++, "style", $"--dyn-board-template:{template}");

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "dyn2-board-header");
            foreach (var column in board.Columns)
            {
                builder.OpenElement(seq++, "span");
                builder.AddContent(seq++, column.Header);
                builder.CloseElement();
            }
            builder.CloseElement();

            var rows = BuildGroups(section.Rows, board.RowGroupBy);
            rows = SortGroups(rows, board.RowSort);

            foreach (var rowGroup in rows)
            {
                var warnings = board.Warnings
                    .Where(w => Expressions.EvaluateBool(
                        w.When,
                        Package.Document,
                        rowGroup.Rows,
                        ParameterValues))
                    .Select(w => w.Text)
                    .ToArray();

                var rowKey = $"{visual.Id}\u001f{section.Key}\u001f{rowGroup.Key}";
                var expanded = compactBoard && expandedBoardRows.Contains(rowKey);
                var accent = RowAccent(board, rowGroup.Rows);

                builder.OpenElement(seq++, "article");
                builder.AddAttribute(
                    seq++,
                    "class",
                    $"dyn2-board-row {(warnings.Length > 0 ? "has-warning " : "")}{(expanded ? "is-expanded" : "")}".Trim());

                if (!string.IsNullOrWhiteSpace(accent))
                    builder.AddAttribute(seq++, "style", $"--dyn-row-accent:{accent}");

                if (warnings.Length > 0)
                    builder.AddAttribute(seq++, "title", string.Join(" · ", warnings));

                if (compactBoard)
                {
                    builder.AddAttribute(
                        seq++,
                        "onclick",
                        EventCallback.Factory.Create(this, () => ToggleBoardRow(rowKey)));
                    builder.AddAttribute(seq++, "role", "button");
                    builder.AddAttribute(seq++, "tabindex", "0");
                    builder.AddAttribute(seq++, "aria-expanded", expanded ? "true" : "false");
                }

                foreach (var column in board.Columns)
                    builder.AddContent(seq++, BoardCell(column, rowGroup.Rows, warnings));

                if (compactBoard)
                {
                    builder.OpenElement(seq++, "span");
                    builder.AddAttribute(seq++, "class", "dyn2-board-expand");
                    builder.AddContent(seq++, expanded ? "Weniger ▲" : "Details ▼");
                    builder.CloseElement();
                }

                builder.CloseElement();
            }

            builder.CloseElement();
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private RenderFragment BoardCell(
        DynBoardColumn column,
        IReadOnlyList<Dictionary<string, object?>> rows,
        IReadOnlyList<string> warnings) => builder =>
    {
        var seq = 0;
        var value = Expressions.Evaluate(column.Value, Package.Document, rows, ParameterValues);
        var secondary = Expressions.Evaluate(column.Secondary, Package.Document, rows, ParameterValues);
        var tertiary = Expressions.Evaluate(column.Tertiary, Package.Document, rows, ParameterValues);
        var target = Expressions.Evaluate(column.Target, Package.Document, rows, ParameterValues);
        var kind = column.Kind.ToLowerInvariant();

        if (kind == "status")
        {
            var text = Convert.ToString(value, CultureInfo.GetCultureInfo("de-AT"))?.Trim() ?? "";
            var color = column.ColorMap.FirstOrDefault(x =>
                x.Key.Equals(text, StringComparison.OrdinalIgnoreCase)).Value;
            if (string.IsNullOrWhiteSpace(color))
                color = "#eef3f4";

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", $"dyn2-cell dyn2-status-cell {ColumnClass(column)}");
            builder.AddAttribute(seq++, "data-label", column.Header);
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "dyn2-status-pill");
            builder.AddAttribute(seq++, "style", $"background:{color};color:{Contrast(color)}");
            builder.AddContent(seq++, string.IsNullOrWhiteSpace(text) ? "–" : text);
            builder.CloseElement();
            if (!IsEmpty(secondary))
            {
                builder.OpenElement(seq++, "small");
                builder.AddContent(seq++, Expressions.FormatValue(secondary, column.TargetFormat));
                builder.CloseElement();
            }
            builder.CloseElement();
            return;
        }

        if (kind == "state")
        {
            var key = Convert.ToString(value, CultureInfo.InvariantCulture) ?? "";
            column.StateMap.TryGetValue(key, out var state);
            state ??= new DynStatePresentation { Label = key, Tone = "neutral", Icon = "●" };

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", $"dyn2-cell dyn2-state {state.Tone} {ColumnClass(column)}");
            builder.AddAttribute(seq++, "data-label", column.Header);
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, string.Join(" ", new[] { state.Icon, state.Label }.Where(x => !string.IsNullOrWhiteSpace(x))));
            builder.CloseElement();
            if (!IsEmpty(secondary))
            {
                builder.OpenElement(seq++, "small");
                builder.AddContent(seq++, Expressions.FormatValue(secondary, column.TargetFormat));
                builder.CloseElement();
            }
            builder.CloseElement();
            return;
        }

        if (kind == "metric")
        {
            var tone = MetricTone(column, value, target, rows);

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", $"dyn2-cell dyn2-board-metric {tone} {ColumnClass(column)}");
            builder.AddAttribute(seq++, "data-label", column.Header);
            builder.OpenElement(seq++, "strong");
            builder.AddContent(seq++, Expressions.FormatValue(value, column.Format));
            builder.CloseElement();
            if (!IsEmpty(target))
            {
                builder.OpenElement(seq++, "span");
                builder.AddContent(seq++, "/ " + Expressions.FormatValue(target, column.TargetFormat));
                builder.CloseElement();
            }
            if (!string.IsNullOrWhiteSpace(column.Unit))
            {
                builder.OpenElement(seq++, "small");
                builder.AddContent(seq++, column.Unit);
                builder.CloseElement();
            }
            builder.CloseElement();
            return;
        }

        builder.OpenElement(seq++, "div");
        builder.AddAttribute(seq++, "class", $"dyn2-cell dyn2-text-cell {ColumnClass(column)}");
        builder.AddAttribute(seq++, "data-label", column.Header);
        builder.OpenElement(seq++, "strong");
        builder.AddContent(seq++, Expressions.FormatValue(value, column.Format, column.Unit));
        builder.CloseElement();

        if (!IsEmpty(secondary))
        {
            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, Expressions.FormatValue(secondary, column.TargetFormat));
            builder.CloseElement();
        }

        if (!IsEmpty(tertiary))
        {
            builder.OpenElement(seq++, "small");
            builder.AddContent(seq++, Expressions.FormatValue(tertiary, ""));
            builder.CloseElement();
        }

        if (column.Id.Equals("warnings", StringComparison.OrdinalIgnoreCase)
            && warnings.Count > 0)
        {
            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "dyn2-warning-count");
            builder.AddContent(seq++, $"⚠ {warnings.Count}");
            builder.CloseElement();

            builder.OpenElement(seq++, "small");
            builder.AddAttribute(seq++, "class", "dyn2-warning-text");
            builder.AddContent(seq++, string.Join(" · ", warnings));
            builder.CloseElement();
        }

        builder.CloseElement();
    };

    private void ToggleBoardRow(string key)
    {
        if (!expandedBoardRows.Add(key))
            expandedBoardRows.Remove(key);
    }

    private string RowAccent(
        DynGroupedBoard board,
        IReadOnlyList<Dictionary<string, object?>> rows)
    {
        var statusColumn = board.Columns.FirstOrDefault(column =>
            column.Kind.Equals("status", StringComparison.OrdinalIgnoreCase));

        if (statusColumn is null)
            return "";

        var value = Expressions.Evaluate(
            statusColumn.Value,
            Package.Document,
            rows,
            ParameterValues);
        var text = Convert.ToString(
            value,
            CultureInfo.GetCultureInfo("de-AT"))?.Trim() ?? "";

        return statusColumn.ColorMap.FirstOrDefault(item =>
            item.Key.Equals(text, StringComparison.OrdinalIgnoreCase)).Value ?? "";
    }

    private static string ColumnClass(DynBoardColumn column)
    {
        var token = new string((column.Id ?? "")
            .Trim()
            .ToLowerInvariant()
            .Select(character =>
                char.IsLetterOrDigit(character) || character is '-' or '_'
                    ? character
                    : '-')
            .ToArray());

        return string.IsNullOrWhiteSpace(token)
            ? "dyn2-col"
            : $"dyn2-col-{token}";
    }

    private static bool HasCssClass(string? classes, string target) =>
        !string.IsNullOrWhiteSpace(classes)
        && classes.Split(
                ' ',
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
            .Any(item => item.Equals(target, StringComparison.OrdinalIgnoreCase));

    private string Tone(
        IReadOnlyList<DynConditionalRule> rules,
        IReadOnlyList<Dictionary<string, object?>> rows)
    {
        foreach (var rule in rules)
        {
            if (Expressions.EvaluateBool(rule.When, Package.Document, rows, ParameterValues))
                return string.IsNullOrWhiteSpace(rule.Tone) ? "neutral" : rule.Tone;
        }

        return "neutral";
    }

    private string MetricTone(
        DynBoardColumn column,
        object? actual,
        object? target,
        IReadOnlyList<Dictionary<string, object?>> rows)
    {
        var ruleTone = Tone(column.Rules, rows);
        if (!ruleTone.Equals("neutral", StringComparison.OrdinalIgnoreCase))
            return ruleTone;

        if (!TryDecimal(actual, out var a) || !TryDecimal(target, out var t) || t == 0m)
            return "neutral";

        var higherIsBetter = column.Direction.Equals("HigherIsBetter", StringComparison.OrdinalIgnoreCase);
        var ratio = a / t;

        if (higherIsBetter)
            return ratio >= 1m ? "good" : ratio >= 0.9m ? "warn" : "bad";

        return ratio <= 1m ? "good" : ratio <= 1.1m ? "warn" : "bad";
    }

    private IReadOnlyList<Dictionary<string, object?>> Rows(string dataset) =>
        !string.IsNullOrWhiteSpace(dataset)
        && Run.Results.TryGetValue(dataset, out var result)
            ? result.Rows
            : [];

    private static List<RowGroup> BuildGroups(
        IReadOnlyList<Dictionary<string, object?>> rows,
        IReadOnlyList<string> fields)
    {
        if (fields.Count == 0)
            return [new RowGroup("", rows.ToList())];

        return rows
            .GroupBy(row => GroupKey(row, fields), StringComparer.Ordinal)
            .Select(group => new RowGroup(group.Key, group.ToList()))
            .ToList();
    }

    private static List<RowGroup> SortGroups(
        List<RowGroup> groups,
        IReadOnlyList<DynSortDefinition> sort)
    {
        if (sort.Count == 0)
            return groups;

        IOrderedEnumerable<RowGroup>? ordered = null;

        foreach (var item in sort)
        {
            Func<RowGroup, string> key = group =>
                Convert.ToString(
                    QueryResult.Get(group.Rows.FirstOrDefault()
                        ?? new Dictionary<string, object?>(), item.Field),
                    CultureInfo.GetCultureInfo("de-AT")) ?? "";

            var desc = item.Direction.Equals("Desc", StringComparison.OrdinalIgnoreCase);
            ordered = ordered is null
                ? desc
                    ? groups.OrderByDescending(key, StringComparer.CurrentCultureIgnoreCase)
                    : groups.OrderBy(key, StringComparer.CurrentCultureIgnoreCase)
                : desc
                    ? ordered.ThenByDescending(key, StringComparer.CurrentCultureIgnoreCase)
                    : ordered.ThenBy(key, StringComparer.CurrentCultureIgnoreCase);
        }

        return ordered?.ToList() ?? groups;
    }

    private static string GroupKey(
        IReadOnlyDictionary<string, object?> row,
        IReadOnlyList<string> fields) =>
        string.Join("", fields.Select(field =>
            Convert.ToString(QueryResult.Get(row, field), CultureInfo.InvariantCulture) ?? ""));

    private static string SectionTitle(
        IReadOnlyList<Dictionary<string, object?>> rows,
        IReadOnlyList<string> fields)
    {
        if (rows.Count == 0)
            return "–";

        return string.Join(" · ", fields.Select(field =>
            Convert.ToString(QueryResult.Get(rows[0], field), CultureInfo.GetCultureInfo("de-AT")) ?? "–"));
    }

    private static bool IsEmpty(object? value) =>
        value is null || string.IsNullOrWhiteSpace(Convert.ToString(value, CultureInfo.GetCultureInfo("de-AT")));

    private static bool TryDecimal(object? value, out decimal result)
    {
        try
        {
            result = Convert.ToDecimal(value, CultureInfo.InvariantCulture);
            return true;
        }
        catch
        {
            return decimal.TryParse(
                Convert.ToString(value, CultureInfo.GetCultureInfo("de-AT")),
                NumberStyles.Any,
                CultureInfo.GetCultureInfo("de-AT"),
                out result);
        }
    }

    private static string Contrast(string color)
    {
        if (string.IsNullOrWhiteSpace(color)
            || color.Length != 7
            || color[0] != '#')
            return "#263d45";

        try
        {
            var r = Convert.ToInt32(color.Substring(1, 2), 16);
            var g = Convert.ToInt32(color.Substring(3, 2), 16);
            var b = Convert.ToInt32(color.Substring(5, 2), 16);
            var luminance = (0.299 * r + 0.587 * g + 0.114 * b) / 255d;
            return luminance < .55 ? "#fff" : "#263d45";
        }
        catch
        {
            return "#263d45";
        }
    }

    private sealed record RowGroup(
        string Key,
        List<Dictionary<string, object?>> Rows);
}
