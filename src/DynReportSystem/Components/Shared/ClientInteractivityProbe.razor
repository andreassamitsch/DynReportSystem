@inject IJSRuntime JS

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        try
        {
            await JS.InvokeVoidAsync("DynReportDiagnostics.markInteractive");
        }
        catch
        {
            // The standalone browser diagnostics surface handles startup failures.
        }
    }
}
