<!DOCTYPE html>
<html lang="de-AT">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#006479" />
    <meta name="robots" content="noindex,nofollow" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="stylesheet" href="/site.css" />
    <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
</head>
<body>
    <div id="dynreport-startup-indicator" class="startup-indicator">
        <div class="loading-ring"></div>
        <span>DynReport wird verbunden …</span>
    </div>
    <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <div id="dynreport-client-error" class="client-error-panel" hidden>
        <div class="client-error-card">
            <div>
                <strong id="dynreport-client-error-title">DynReport ist nicht interaktiv verbunden.</strong>
                <p id="dynreport-client-error-message">
                    Buttons und Register können ohne Blazor-Verbindung nicht verwendet werden.
                </p>
            </div>
            <pre id="dynreport-client-error-details"></pre>
            <div class="client-error-actions">
                <button id="dynreport-client-retry" type="button">Seite neu laden</button>
                <button id="dynreport-client-copy" type="button">Diagnose kopieren</button>
            </div>
        </div>
    </div>

    <div id="components-reconnect-modal" class="reconnect-modal">
        <div class="reconnect-card">
            <strong>Verbindung zu DynReport wird wiederhergestellt …</strong>
            <span>Falls die Verbindung nicht automatisch zurückkommt, Seite neu laden.</span>
            <button id="components-reconnect-button" type="button">Erneut verbinden</button>
        </div>
    </div>

    <script src="/js/dynreport-client-diagnostics.js"></script>
    <script src="/vendor/echarts.min.js"></script>
    <script src="/js/dynreport-charts.js"></script>
    <script src="/_framework/blazor.web.js" autostart="false"></script>
    <script src="/js/dynreport-bootstrap.js"></script>
</body>
</html>
