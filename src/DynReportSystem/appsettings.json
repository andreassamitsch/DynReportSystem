{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cockpit": {
    "RdlPath": "Reports/Kundencockpit.rdl",
    "ConnectionString": "",
    "CommandTimeoutSeconds": 120,
    "MaxRowsPerDataset": 20000,
    "MaxConcurrentDashboardQueries": 4
  },
  "Portal": {
    "CommandTimeoutSeconds": 120,
    "MaxRowsPerDataset": 20000
  },
  "DataSources": {
    "OxaionPRD": {
      "ConnectionString": "",
      "Database": "production"
    },
    "SyncosPRD": {
      "ConnectionString": ""
    },
    "SyncosPRDHephax": {
      "ConnectionString": ""
    },
    "ReportServerDB": {
      "ConnectionString": ""
    },
    "DynReportMetadata": {
      "ConnectionString": ""
    }
  },
  "Metadata": {
    "ConnectionString": "",
    "FailPublishWhenUnavailable": false
  },
  "Runtime": {
    "MaxConcurrentQueries": 8,
    "AbsoluteMaxRows": 100000,
    "AbsoluteMaxQuerySeconds": 300,
    "SlowQueryThresholdMs": 2000,
    "AbsoluteMaxResultBytes": 67108864,
    "MaxInteractivePageSize": 1000,
    "MaxInteractivePivotRows": 250,
    "MaxInteractivePivotCells": 5000
  },
  "Security": {
    "AllowLegacyPackageConnectionStringFallback": true,
    "RequireValidatedSqlTls": false
  },
  "VisualTheme": {
    "ColorSets": {
      "BusinessArea": {
        "10": "#90ceff",
        "11": "#cebbe9",
        "12": "#efe68c",
        "13": "#6aaa60",
        "21": "#7ae5da",
        "22": "#83fcb9",
        "31": "#ffc65c",
        "102": "#3398FF",
        "103": "#00FFFF",
        "104": "#FF9833",
        "999": "#222222",
        "_default": "#b5b5b5",
        "00": "#b5b5b5",
        "03": "#b5b5b5",
        "Allgemein": "#b5b5b5",
        "Allgm.": "#b5b5b5",
        "CNC": "#90ceff",
        "US": "#cebbe9",
        "Zerodur": "#efe68c",
        "Keramik": "#6aaa60",
        "FAM": "#7ae5da",
        "FAM+": "#83fcb9",
        "HEPHAX": "#ffc65c"
      }
    }
  }
}
