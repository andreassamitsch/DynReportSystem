{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cockpit": {
    "RdlPath": "Reports/Kundencockpit.rdl",
    "ConnectionString": "",
    "CommandTimeoutSeconds": 120,
    "MaxRowsPerDataset": 20000
  },
  "Portal": {
    "CommandTimeoutSeconds": 120,
    "MaxRowsPerDataset": 20000
  },
  "DataSources": {
    "OxaionPRD": {
      "ConnectionString": ""
    },
    "SyncosPRD": {
      "ConnectionString": ""
    },
    "SyncosPRDHephax": {
      "ConnectionString": ""
    },
    "ReportServerDB": {
      "ConnectionString": ""
    },
    "DynReportMetadata": {
      "ConnectionString": ""
    }
  },
  "Metadata": {
    "ConnectionString": "",
    "FailPublishWhenUnavailable": false
  },
  "Runtime": {
    "MaxConcurrentQueries": 8,
    "AbsoluteMaxRows": 100000,
    "AbsoluteMaxQuerySeconds": 300,
    "SlowQueryThresholdMs": 2000,
    "AbsoluteMaxResultBytes": 67108864,
    "MaxInteractivePageSize": 1000,
    "MaxInteractivePivotRows": 250,
    "MaxInteractivePivotCells": 5000
  },
  "Security": {
    "AllowLegacyPackageConnectionStringFallback": true,
    "RequireValidatedSqlTls": false
  }
}
