<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!--
        Authentication is intentionally configured in ApplicationHost.config
        by the server installer. IIS commonly locks authentication sections,
        so keeping them in this application web.config causes HTTP 500.19
        (0x80070021) on secured servers.
      -->
      <aspNetCore processPath=".\DynReportSystem.exe"
                  arguments=""
                  stdoutLogEnabled="false"
                  hostingModel="inprocess"
                  stdoutLogFile=".\logs\stdout" />
    </system.webServer>
  </location>
</configuration>
