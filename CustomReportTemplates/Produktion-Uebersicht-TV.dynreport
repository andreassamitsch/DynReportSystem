  "TargetPath": "/Reports/TV/Produktion Übersicht TV",
  "Title": "Produktion Übersicht TV",
  "Description": "Manuell optimierte Live-Produktionsübersicht. Die Darstellung übernimmt die fachliche Logik des ursprünglichen SSRS-Berichts: Bereich/Maschine/Auftrag/Arbeitsgang, Maschinenstatus, angemeldetes Personal, Erstmusterprüfung, Rüst- und Taktabweichungen, Behältertakt, letzte Behältermeldung und ungeplante Stillstandszeit.",
  "Renderer": "production-tv-overview",
  "PrimaryDataset": "HoldupReasonHistory",
  "AutoRun": true,
  "AutoRefreshSeconds": 60,
  "ParametersCollapsedByDefault": false,
  "Parameters": [
